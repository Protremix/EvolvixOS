# EvolvixOS Environment Configuration
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/evolvixos

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers
OPENAI_API_KEY_2=your-openai-api-key
ANTHROPIC_API_KEY=
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=

# Security
SECRET_KEY=change-this-to-a-random-string

# Optional: Monitoring
PROMETHEUS_ENABLED=true
