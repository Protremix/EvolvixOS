{
  "annotations": {"list": []},
  "title": "EvolvixOS Overview",
  "uid": "evolvixos-overview",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "title": "API Request Rate (req/s)",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(evolvixos_requests_total[1m]))", "legendFormat": "req/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "red"}, {"color": "green", "value": 0.1}]}}}
    },
    {
      "title": "API Error Rate (%)",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(rate(evolvixos_requests_total{status=~\"5..\"}[5m])) / sum(rate(evolvixos_requests_total[5m])) * 100", "legendFormat": "errors", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green"}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "title": "API Memory Usage (MB)",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "process_resident_memory_bytes{job=\"evolvixos-api\"} / 1048576", "legendFormat": "RSS", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "MB", "thresholds": {"steps": [{"color": "green"}, {"color": "yellow", "value": 500}, {"color": "red", "value": 1024}]}}}
    },
    {
      "title": "Container Status",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "count(up == 1)", "legendFormat": "up", "refId": "A"}, {"expr": "count(up == 0)", "legendFormat": "down", "refId": "B"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "red"}, {"color": "green", "value": 4}]}}}
    },
    {
      "title": "Request Rate Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [{"expr": "rate(evolvixos_requests_total[1m])", "legendFormat": "{{endpoint}} ({{status}})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "title": "Response Time (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(evolvixos_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum(rate(evolvixos_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum(rate(evolvixos_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "title": "Server CPU Usage (%)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "targets": [{"expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "CPU %", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
    },
    {
      "title": "Server Memory Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "targets": [
        {"expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used", "refId": "A"},
        {"expr": "node_memory_MemTotal_bytes", "legendFormat": "Total", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}}
    },
    {
      "title": "Disk Space Usage",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "targets": [{"expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} * 100", "legendFormat": "Free %", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100}}
    },
    {
      "title": "API Requests by Endpoint",
      "type": "table",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "targets": [{"expr": "topk(10, sum by (endpoint) (rate(evolvixos_requests_total[5m])))", "legendFormat": "{{endpoint}}", "refId": "A", "format": "table", "instant": true}],
      "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true}}}]
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "targets": [{"expr": "pg_stat_activity_count", "legendFormat": "Active", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "tags": ["evolvixos", "production"]
}
