        c.execute('SELECT id, name, price_monthly, price_yearly, credits_monthly, max_agents, max_entities, max_functions, max_workflows, max_api_calls, features FROM plans WHERE is_active = 1 ORDER BY sort_order')
        rows = c.fetchall()
        conn.close()
