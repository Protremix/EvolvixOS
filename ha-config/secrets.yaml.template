# ─── EvolvixOS Voice PE Secrets Template ───────────────────────────
# Copy this file to secrets.yaml and fill in your values.
# DO NOT commit secrets.yaml to git!

# Wi-Fi credentials for the Voice PE device
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Home Assistant server URL (accessible from the Voice PE device)
# Use the IP or hostname of your HA instance
ha_url: "http://homeassistant.local:8123"

# ESPHome API encryption key (generate with: openssl rand -base64 32)
api_encryption_key: "GENERATE_WITH_openssl_rand_base64_32"

# ESPHome OTA password (generate with: openssl rand -hex 16)
ota_password: "GENERATE_WITH_openssl_rand_hex_16"

# ─── Optional: EvolvixOS API Key (if auth is enabled) ──────────────
# Only needed if EvolvixOS has voice_gateway.auth_enabled = true
# evolvix_api_key: "your-evolvixos-api-key"
