[Unit]
Description=EvolvixOS Platform API (Base44-style)
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/evolvixos/platform
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=PLATFORM_DATABASE_URL=postgresql+asyncpg://evolvixos:evolvixos@127.0.0.1:5432/evolvixos
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
