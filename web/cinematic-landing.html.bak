<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f5f5f7">
<title>EvolvixOS — Every builder needs a base</title>
<meta name="description" content="Build apps, websites, AI agents and APIs using your own words. Powered by open-source AI.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Inter',-apple-system,sans-serif}
body{background:#f5f5f7;color:#1a1a1a;overflow-x:hidden}
a{text-decoration:none;color:inherit}
.grid-bg{background-image:radial-gradient(circle at 1px 1px,rgba(0,0,0,.06) 1px,transparent 0);background-size:24px 24px}
.container{max-width:1200px;margin:0 auto;padding:0 24px}
/* Header */
.header{display:flex;justify-content:space-between;align-items:center;padding:20px 0}
.logo{display:flex;align-items:center;gap:10px}
.logo-mark{width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,#EE8A52 0%,#D9663A 42%,#7B3FA0 100%);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:16px}
.logo-text{font-weight:700;font-size:18px}
.nav{display:flex;gap:32px;align-items:center}
.nav a{font-size:14px;font-weight:500;color:#666;transition:color .2s}
.nav a:hover{color:#1a1a1a}
.btn-dark{padding:8px 20px;border-radius:10px;background:#1a1a1a;color:#fff!important;font-size:14px;font-weight:600;transition:transform .2s}
.btn-dark:hover{transform:scale(1.05)}
/* Hero */
.hero{text-align:center;padding:80px 0 40px}
.hero h1{font-size:56px;font-weight:800;letter-spacing:-1.5px;margin-bottom:16px;line-height:1.05}
.hero p.sub{font-size:20px;color:#666;margin-bottom:40px;line-height:1.5}
/* Builder Input */
.builder-box{background:#fff;border-radius:16px;padding:24px;box-shadow:0 4px 24px rgba(0,0,0,.08);border:1px solid #e5e5e7;max-width:720px;margin:0 auto 20px;text-align:left}
.builder-box textarea{width:100%;min-height:64px;border:none;outline:none;font-size:16px;resize:none;color:#1a1a1a;background:transparent;font-family:inherit}
.builder-box textarea::placeholder{color:#aaa}
.builder-footer{display:flex;justify-content:space-between;align-items:center;margin-top:16px;padding-top:16px;border-top:1px solid #f0f0f0}
.builder-hint{font-size:13px;color:#999;display:flex;align-items:center;gap:6px}
.btn-build{padding:10px 24px;border-radius:10px;border:none;font-size:15px;font-weight:600;color:#fff;cursor:pointer;transition:all .2s;background:#e5e5e7}
.btn-build.active{background:linear-gradient(135deg,#EE8A52,#D9663A)}
.btn-build.active:hover{transform:scale(1.05)}
/* Suggestions */
.suggestions{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:12px}
.suggestion{padding:8px 16px;border-radius:20px;border:1px solid #e5e5e7;background:#fff;font-size:13px;font-weight:500;color:#666;cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:6px}
.suggestion:hover{border-color:#D9663A;color:#D9663A;transform:translateY(-2px)}
.trusted{font-size:13px;color:#999;margin-top:12px}
/* Gallery */
.gallery-tabs{display:flex;gap:24px;justify-content:center;margin-bottom:32px}
.gallery-tab{padding:6px 16px;border-radius:20px;border:none;font-size:14px;font-weight:600;cursor:pointer;background:transparent;color:#666}
.gallery-tab.active{background:#1a1a1a;color:#fff}
.gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-bottom:60px}
.gallery-card{border-radius:16px;overflow:hidden;border:1px solid #e5e5e7;background:#fff;transition:transform .2s,box-shadow .2s}
.gallery-card:hover{transform:translateY(-4px);box-shadow:0 12px 32px rgba(0,0,0,.1)}
.gallery-img{height:200px;background-size:cover;background-position:center;position:relative}
.gallery-badge{position:absolute;top:12px;left:12px;padding:4px 12px;border-radius:12px;background:rgba(255,255,255,.9);font-size:12px;font-weight:600;color:#333}
.gallery-info{padding:16px}
.gallery-info h3{font-size:16px;font-weight:600;margin-bottom:4px}
.gallery-info p{font-size:13px;color:#999}
/* Features */
.features{padding:60px 0}
.features h2{font-size:36px;font-weight:800;text-align:center;margin-bottom:48px;letter-spacing:-1}
.features-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.feature-card{padding:28px;border-radius:16px;border:1px solid #e5e5e7;background:#fff}
.feature-icon{font-size:36px;margin-bottom:16px}
.feature-card h3{font-size:18px;font-weight:600;margin-bottom:8px}
.feature-card p{font-size:14px;color:#666;line-height:1.6}
/* CTA */
.cta{text-align:center;padding:80px 0;max-width:600px;margin:0 auto}
.cta h2{font-size:36px;font-weight:800;margin-bottom:16px}
.cta p{font-size:16px;color:#666;margin-bottom:32px}
.btn-cta{display:inline-block;padding:14px 32px;border-radius:12px;background:linear-gradient(135deg,#EE8A52,#D9663A);color:#fff;font-size:16px;font-weight:600;transition:transform .2s}
.btn-cta:hover{transform:scale(1.05)}
/* Footer */
.footer{border-top:1px solid #e5e5e7;padding:32px 0;display:flex;justify-content:space-between;align-items:center}
.footer-links{display:flex;gap:24px}
.footer-links a{font-size:13px;color:#999}
.footer-links a:hover{color:#666}
/* Build animation */
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
.building{animation:pulse 1.5s infinite}
/* Responsive */
@media(max-width:768px){.hero h1{font-size:36px}.gallery{grid-template-columns:1fr}.features-grid{grid-template-columns:1fr}.nav{display:none}}
</style>
</head>
<body>
<div class="container grid-bg" style="min-height:100vh">
  <!-- Header -->
  <header class="header">
    <div class="logo">
      <div class="logo-mark">E</div>
      <span class="logo-text">EvolvixOS</span>
    </div>
    <nav class="nav">
      <a href="/dashboard/overview">Dashboard</a>
      <a href="/pricing">Pricing</a>
      <a href="/terms">Terms</a>
      <a href="/auth/sign-in" class="btn-dark">Sign in</a>
    </nav>
  </header>

  <!-- Hero + Builder -->
  <div class="hero">
    <h1>Every builder needs<br>a base</h1>
    <p class="sub">Build apps, websites, AI agents and APIs using your own words.<br>Powered by open-source AI.</p>
    
    <div class="builder-box">
      <textarea id="prompt" placeholder="Build a CRM for my 12-person sales team that tracks deals and follow-ups..." onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();doBuild()}"></textarea>
      <div class="builder-footer">
        <span class="builder-hint">✨ AI will build your app in seconds</span>
        <button class="btn-build" id="buildBtn" onclick="doBuild()">Build it →</button>
      </div>
    </div>
    
    <div class="suggestions" id="suggestions">
      <button class="suggestion" onclick="setPrompt(this)">📊 CRM</button>
      <button class="suggestion" onclick="setPrompt(this)">🤖 AI Agent</button>
      <button class="suggestion" onclick="setPrompt(this)">📈 Dashboard</button>
      <button class="suggestion" onclick="setPrompt(this)">📦 Inventory</button>
      <button class="suggestion" onclick="setPrompt(this)">👥 HR Portal</button>
      <button class="suggestion" onclick="setPrompt(this)">⚡ REST API</button>
    </div>
    <p class="trusted">Trusted by builders worldwide</p>
  </div>

  <!-- Gallery -->
  <div class="container">
    <div class="gallery-tabs">
      <button class="gallery-tab active" onclick="filterGallery(this,'all')">Apps</button>
      <button class="gallery-tab" onclick="filterGallery(this,'agent')">AI Agents</button>
      <button class="gallery-tab" onclick="filterGallery(this,'dashboard')">Dashboards</button>
      <button class="gallery-tab" onclick="filterGallery(this,'api')">APIs</button>
    </div>
    <div class="gallery" id="gallery">
      <div class="gallery-card" data-cat="crm">
        <div class="gallery-img" style="background-image:url('https://images.unsplash.com/photo-1460925895917-afdab827c52f?w=600&q=80')">
          <span class="gallery-badge">CRM</span>
        </div>
        <div class="gallery-info"><h3>Sales Tracker</h3><p>Track deals and pipeline</p></div>
      </div>
      <div class="gallery-card" data-cat="agent">
        <div class="gallery-img" style="background-image:url('https://images.unsplash.com/photo-1677442136019-21780ecad995?w=600&q=80')">
          <span class="gallery-badge">AI Agent</span>
        </div>
        <div class="gallery-info"><h3>AI Chatbot</h3><p>24/7 customer support</p></div>
      </div>
      <div class="gallery-card" data-cat="dashboard">
        <div class="gallery-img" style="background-image:url('https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=600&q=80')">
          <span class="gallery-badge">Dashboard</span>
        </div>
        <div class="gallery-info"><h3>Analytics Hub</h3><p>Real-time metrics</p></div>
      </div>
      <div class="gallery-card" data-cat="inventory">
        <div class="gallery-img" style="background-image:url('https://images.unsplash.com/photo-1553413258-4c3d3b9c2a7b?w=600&q=80')">
          <span class="gallery-badge">Operations</span>
        </div>
        <div class="gallery-info"><h3>Inventory Pro</h3><p>Stock management</p></div>
      </div>
      <div class="gallery-card" data-cat="hr">
        <div class="gallery-img" style="background-image:url('https://images.unsplash.com/photo-1521737711867-e9b2f2a3c0e8?w=600&q=80')">
          <span class="gallery-badge">HR</span>
        </div>
        <div class="gallery-info"><h3>HR Platform</h3><p>Team management</p></div>
      </div>
      <div class="gallery-card" data-cat="api">
        <div class="gallery-img" style="background-image:url('https://images.unsplash.com/photo-1555066931-4365d14bab5c?w=600&q=80')">
          <span class="gallery-badge">DevOps</span>
        </div>
        <div class="gallery-info"><h3>Code Review</h3><p>Automated reviews</p></div>
      </div>
    </div>
  </div>

  <!-- Features -->
  <div class="features container">
    <h2>Everything you need to build</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">🤖</div>
        <h3>AI Agents</h3>
        <p>Create agents with long-term memory, custom tools, and external API access</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">📊</div>
        <h3>Entities & Data</h3>
        <p>JSON-schema entities with PostgreSQL CRUD, pagination, filtering, and relations</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">⚡</div>
        <h3>Backend Functions</h3>
        <p>Deploy Python code as HTTP endpoints in seconds</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔄</div>
        <h3>Workflows</h3>
        <p>Scheduled, entity-triggered, and connector-triggered automations</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🔌</div>
        <h3>Connectors</h3>
        <p>OAuth integrations with Google, Slack, GitHub, and more</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🧠</div>
        <h3>RAG Engine</h3>
        <p>Document ingestion and semantic search powered by embeddings</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="cta">
    <h2>Start building today</h2>
    <p>Join builders creating apps, agents, and APIs with EvolvixOS</p>
    <a href="/auth/sign-up" class="btn-cta">Create account →</a>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <div class="logo">
      <div class="logo-mark" style="width:24px;height:24px;border-radius:6px;font-size:12px"></div>
      <span style="font-size:14px;font-weight:600;color:#666">EvolvixOS</span>
    </div>
    <div class="footer-links">
      <a href="/terms">Terms</a>
      <a href="/privacy">Privacy</a>
      <a href="/refund-policy">Refund Policy</a>
    </div>
  </footer>
</div>

<script>
const prompts={'📊 CRM':'Build a CRM for my sales team that tracks deals, contacts, and follow-ups','🤖 AI Agent':'Create an AI agent that answers customer questions and stores conversation history','📈 Dashboard':'Build an analytics dashboard with charts showing revenue, users, and growth metrics','📦 Inventory':'Create an inventory management system with stock tracking and low-stock alerts','👥 HR Portal':'Build an HR portal for employee management, time-off requests, and reviews','⚡ REST API':'Create a REST API for my product catalog with search and filtering'};

function setPrompt(btn){
  const text=btn.textContent.trim();
  document.getElementById('prompt').value=prompts[text]||text;
  document.getElementById('buildBtn').classList.add('active');
  document.getElementById('prompt').focus();
}

function doBuild(){
  const p=document.getElementById('prompt').value.trim();
  if(!p)return;
  // Check if logged in
  const token=localStorage.getItem('evolvix_token');
  if(!token){
    window.location.href='/auth/sign-in?redirect=builder&prompt='+encodeURIComponent(p);
    return;
  }
  // Send to builder
  const btn=document.getElementById('buildBtn');
  btn.textContent='Building...';
  btn.classList.add('building');
  fetch('/platform/api/chat',{
    method:'POST',
    headers:{'Authorization':'Bearer '+token,'Content-Type':'application/json'},
    body:JSON.stringify({message:p,context:{mode:'builder'}})
  }).then(r=>{
    window.location.href='/dashboard/overview?built='+encodeURIComponent(p);
  }).catch(e=>{
    window.location.href='/dashboard/overview?built='+encodeURIComponent(p);
  });
}

document.getElementById('prompt').addEventListener('input',function(){
  const btn=document.getElementById('buildBtn');
  if(this.value.trim())btn.classList.add('active');else btn.classList.remove('active');
});

function filterGallery(btn,cat){
  document.querySelectorAll('.gallery-tab').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
  document.querySelectorAll('.gallery-card').forEach(c=>{
    if(cat==='all'||c.dataset.cat===cat)c.style.display='block';else c.style.display='none';
  });
}
</script>
</body>
</html>
