<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pricing — EvolvixOS</title>
  <meta name="description" content="Simple, transparent pricing. Start free, scale when ready. Every plan includes the full model stack.">
  <link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="apple-touch-icon" href="/assets/evolvixos-logo-180.png">
  <style>
    :root {
      --bg: #f5f5f7;
      --surface: #ffffff;
      --text: #1d1d1f;
      --text-secondary: #6e6e73;
      --text-muted: #86868b;
      --accent: #007aff;
      --accent-hover: #0056b3;
      --border: #d2d2d7;
      --radius: 12px;
      --radius-sm: 8px;
      --shadow: 0 2px 8px rgba(0,0,0,0.06);
      --shadow-lg: 0 8px 32px rgba(0,0,0,0.08);
      --font: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Display', sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
    }
    .container { max-width: 980px; margin: 0 auto; padding: 0 24px; }
    
    /* Nav */
    nav {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 24px; max-width: 980px; margin: 0 auto;
    }
    .nav-logo { font-size: 20px; font-weight: 700; color: var(--text); text-decoration: none; }
    .nav-logo span { color: var(--accent); }
    .nav-links { display: flex; gap: 24px; align-items: center; }
    .nav-links a { color: var(--text-secondary); text-decoration: none; font-size: 14px; font-weight: 500; transition: color 0.2s; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta { background: var(--accent); color: white !important; padding: 8px 16px; border-radius: var(--radius-sm); }
    .nav-cta:hover { background: var(--accent-hover); }

    /* Hero */
    .hero { text-align: center; padding: 60px 24px 40px; }
    .hero h1 { font-size: 48px; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 12px; }
    .hero p { font-size: 18px; color: var(--text-secondary); }

    /* Toggle */
    .toggle-bar { display: flex; justify-content: center; gap: 8px; margin-bottom: 40px; }
    .toggle-btn {
      padding: 8px 20px; border-radius: 100px; border: 1px solid var(--border);
      background: var(--surface); font-size: 14px; font-weight: 600; cursor: pointer;
      transition: all 0.2s; font-family: var(--font); color: var(--text-secondary);
    }
    .toggle-btn.active { background: var(--text); color: white; border-color: var(--text); }
    .save-badge { font-size: 11px; background: var(--accent); color: white; padding: 2px 6px; border-radius: 4px; margin-left: 4px; }

    /* Cards */
    .pricing-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 60px; }
    .tier-card {
      background: var(--surface); border-radius: var(--radius); padding: 32px;
      border: 1px solid var(--border); box-shadow: var(--shadow); position: relative;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .tier-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .tier-card.featured { border-color: var(--accent); border-width: 2px; }
    .featured-badge {
      position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
      background: var(--accent); color: white; font-size: 12px; font-weight: 600;
      padding: 4px 12px; border-radius: 100px;
    }
    .tier-name { font-size: 20px; font-weight: 700; margin-bottom: 6px; }
    .tier-desc { font-size: 14px; color: var(--text-secondary); margin-bottom: 24px; min-height: 40px; }
    .tier-price { display: flex; align-items: baseline; gap: 4px; margin-bottom: 4px; }
    .tier-price-amount { font-size: 40px; font-weight: 800; letter-spacing: -0.02em; }
    .tier-price-note { font-size: 13px; color: var(--text-muted); margin-bottom: 24px; min-height: 18px; }
    .tier-cta {
      width: 100%; padding: 12px; border-radius: var(--radius-sm); font-size: 15px;
      font-weight: 600; border: none; cursor: pointer; transition: all 0.2s;
      font-family: var(--font); margin-bottom: 28px;
    }
    .tier-cta.primary { background: var(--accent); color: white; }
    .tier-cta.primary:hover { background: var(--accent-hover); }
    .tier-cta.secondary { background: var(--bg); color: var(--text); border: 1px solid var(--border); }
    .tier-cta.secondary:hover { background: var(--border); }
    .tier-features { list-style: none; padding: 0; }
    .tier-features li { font-size: 14px; color: var(--text-secondary); padding: 6px 0; display: flex; align-items: start; gap: 8px; }
    .tier-features li::before { content: "\u2713"; color: var(--accent); font-weight: 700; flex-shrink: 0; }

    /* Footer note */
    .footer-note { text-align: center; padding: 40px 24px; font-size: 13px; color: var(--text-muted); }
    .footer-note a { color: var(--accent); text-decoration: none; }

    @media (max-width: 768px) {
      .pricing-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 32px; }
    }
  </style>
</head>
<body>
  <nav>
    <a href="/" class="nav-logo"><img src="/assets/evolvixos-logo-64.png" alt="EvolvixOS" style="width:22px;height:22px;object-fit:contain;vertical-align:middle;"> Evolvix<span>OS</span></a>
    <div class="nav-links">
      <a href="/pricing">Pricing</a>
      <a href="/contact">Contact</a>
      <a href="/dashboard/overview" class="nav-cta">Sign in</a>
    </div>
  </nav>

  <noscript>
    <div style="padding: 40px; text-align: center; max-width: 900px; margin: 0 auto;">
      <h2>Pricing</h2>
      <div style="display: flex; gap: 24px; justify-content: center; margin-top: 32px; flex-wrap: wrap;">
        <div style="border: 1px solid #d1d1d6; border-radius: 12px; padding: 32px; max-width: 260px;">
          <h3>Starter</h3>
          <p style="font-size: 36px; font-weight: 800; margin: 8px 0;">&euro;9<span style="font-size: 14px; color: #6e6e73;">/month</span></p>
          <p style="font-size: 14px; color: #6e6e73;">&euro;86/year &middot; 5,000 API calls/month</p>
        </div>
        <div style="border: 1px solid #d1d1d6; border-radius: 12px; padding: 32px; max-width: 260px;">
          <h3>Pro</h3>
          <p style="font-size: 36px; font-weight: 800; margin: 8px 0;">&euro;29<span style="font-size: 14px; color: #6e6e73;">/month</span></p>
          <p style="font-size: 14px; color: #6e6e73;">&euro;278/year &middot; 20,000 API calls/month</p>
        </div>
        <div style="border: 1px solid #d1d1d6; border-radius: 12px; padding: 32px; max-width: 260px;">
          <h3>Business</h3>
          <p style="font-size: 36px; font-weight: 800; margin: 8px 0;">&euro;49<span style="font-size: 14px; color: #6e6e73;">/month</span></p>
          <p style="font-size: 14px; color: #6e6e73;">&euro;470/year &middot; 50,000 API calls/month</p>
        </div>
      </div>
      <p style="margin-top: 24px; font-size: 13px; color: #6e6e73;">Prices include estimated taxes. Powered by Stripe.</p>
    </div>
  </noscript>

  <div class="container">
    <div class="hero">
      <h1>Choose your plan</h1>
      <p>Start free, scale when ready. Every plan includes the full model stack.</p>
    </div>

    <div class="toggle-bar">
      <button class="toggle-btn active" data-cycle="month">Monthly</button>
      <button class="toggle-btn" data-cycle="year">Yearly <span class="save-badge">Save 20%</span></button>
    </div>

    <div class="pricing-grid" id="pricingGrid"></div>

    <div class="footer-note">
      Prices shown in EUR. Powered by Stripe.<br>
      Need a custom plan? <a href="mailto:support@evolvixos.com">Contact us</a>
    </div>
  </div>

  <script>
    let currentCycle = "month";
    let authToken = null;
    try {
      authToken = localStorage.getItem("evolvix_token") ||
        document.cookie.replace(/(?:(?:^|.*;\s*)evolvix_token\s*\=\s*([^;]*).*$)|^.*$/, "$1");
    } catch(e) {}

    const TIERS = [
      {
        name: "Starter",
        description: "For individual developers getting started",
        features: ["5,000 API calls / month", "All AI models included", "Entity CRUD + Backend functions", "Community support"],
        prices: { month: 9, year: 86 },
        stripePrices: { month: "price_1UAELl2fz7mjXQMgBNDsM9b1", year: "price_1UAELl2fz7mjXQMgs0QQovNq" }
      },
      {
        name: "Pro",
        description: "For growing teams building production apps",
        features: ["20,000 API calls / month", "Priority model routing", "Workflows + automations", "Email support"],
        prices: { month: 29, year: 278 },
        stripePrices: { month: "price_1UAELm2fz7mjXQMgwazTQ2MA", year: "price_1UAELm2fz7mjXQMg9cy365Xv" }
      },
      {
        name: "Business",
        description: "For teams scaling AI infrastructure",
        features: ["50,000 API calls / month", "Advanced routing + privacy modes", "SSO + audit logs", "Priority support"],
        prices: { month: 49, year: 470 },
        stripePrices: { month: "price_1UAELm2fz7mjXQMglGtHJS1a", year: "price_1UAELm2fz7mjXQMgm9Jv5slH" }
      }
    ];

    const FEATURED_TIER = "Pro";

    function renderCards() {
      const grid = document.getElementById("pricingGrid");
      grid.innerHTML = TIERS.map(function(tier) {
        const featured = tier.name === FEATURED_TIER;
        const featuresHtml = tier.features.map(function(f) {
          return "<li>" + f + "</li>";
        }).join("");
        return '<div class="tier-card ' + (featured ? "featured" : "") + '">' +
          (featured ? '<div class="featured-badge">Most popular</div>' : "") +
          '<div class="tier-name">' + tier.name + '</div>' +
          '<div class="tier-desc">' + tier.description + '</div>' +
          '<div class="tier-price"><span class="tier-price-amount">&euro;' + tier.prices[currentCycle] + '</span></div>' +
          '<div class="tier-price-note">' + (currentCycle === "month" ? "per month" : "per year") + '</div>' +
          '<button class="tier-cta ' + (featured ? "primary" : "secondary") + '" ' +
          'data-tier="' + tier.name + '">Subscribe</button>' +
          '<ul class="tier-features">' + featuresHtml + '</ul>' +
          '</div>';
      }).join("");

      document.querySelectorAll(".tier-cta").forEach(function(btn) {
        btn.addEventListener("click", function() { openCheckout(btn.dataset.tier); });
      });
    }

    function setupToggle() {
      document.querySelectorAll(".toggle-btn").forEach(function(btn) {
        btn.addEventListener("click", function() {
          document.querySelectorAll(".toggle-btn").forEach(function(b) { b.classList.remove("active"); });
          btn.classList.add("active");
          currentCycle = btn.dataset.cycle;
          renderCards();
        });
      });
    }

    async function openCheckout(tierName) {
      const tier = TIERS.find(function(t) { return t.name === tierName; });
      if (!tier) return;
      const priceId = tier.stripePrices[currentCycle];

      try {
        const headers = { "Content-Type": "application/json" };
        if (authToken) headers["Authorization"] = "Bearer " + authToken;

        const res = await fetch("/auth/stripe-checkout", {
          method: "POST",
          headers: headers,
          body: JSON.stringify({
            price_id: priceId,
            item_type: "subscription",
            plan_name: tier.name,
            billing_cycle: currentCycle === "month" ? "monthly" : "yearly"
          })
        });

        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else if (data.error) {
          alert("Checkout error: " + data.error);
        } else {
          alert("Could not start checkout. Please try again.");
        }
      } catch (e) {
        alert("Network error: " + e.message);
      }
    }

    renderCards();
    setupToggle();
  </script>
</body>
</html>
