<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome — EvolvixOS</title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico"><link rel="apple-touch-icon" href="/assets/evolvixos-logo-180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Inter', -apple-system, system-ui, sans-serif; }
    :root {
      --bg: #f5f5f7; --card: #fff; --text: #1d1d1f; --muted: #86868b;
      --accent: #007aff; --green: #34c759; --radius: 12px;
    }
    body {
      background: var(--bg); color: var(--text); margin: 0;
      min-height: 100vh; display: flex; flex-direction: column;
      align-items: center; justify-content: center; -webkit-font-smoothing: antialiased;
    }
    .check {
      width: 80px; height: 80px; border-radius: 50%; background: var(--green);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 24px; animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .check svg { width: 40px; height: 40px; color: #fff; }
    @keyframes scaleIn { from { transform: scale(0); } to { transform: scale(1); } }
    h1 { font-size: 32px; font-weight: 700; margin: 0 0 8px; letter-spacing: -0.02em; }
    p { font-size: 17px; color: var(--muted); margin: 0 0 32px; text-align: center; max-width: 420px; line-height: 1.5; }
    .btn {
      background: var(--accent); color: #fff; border: none;
      padding: 14px 36px; border-radius: var(--radius);
      font-size: 16px; font-weight: 600; cursor: pointer;
      text-decoration: none; transition: background 0.2s, transform 0.1s;
      display: inline-block;
    }
    .btn:hover { background: #0066d6; }
    .btn:active { transform: scale(0.98); }
    .secondary {
      background: transparent; color: var(--accent); margin-left: 12px;
    }
    .secondary:hover { background: rgba(0,122,255,0.08); }
    .logo {
      position: fixed; top: 24px; left: 24px;
      display: flex; align-items: center; gap: 8px;
      text-decoration: none; color: var(--text); font-weight: 600; font-size: 18px;
    }
    .logo svg { width: 28px; height: 28px; }
  </style>
</head>
<body>
  <a href="/" class="logo">
    <img src="/assets/evolvixos-logo-64.png" alt="EvolvixOS" style="width:28px;height:28px;object-fit:contain;vertical-align:middle;">
    EvolvixOS
  </a>

  <div class="check">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"/>
    </svg>
  </div>
  <h1>Welcome to EvolvixOS!</h1>
  <p>Your subscription is active. Credits are now in your account. Let's start building.</p>
  <div>
    <a href="/dashboard/overview" class="btn">Launch Studio</a>
    <a href="/" class="btn secondary">Back to Home</a>
  </div>

  <script>
    // Check for payment success params in URL
    const params = new URLSearchParams(window.location.search);
    if (params.get('payment') === 'success') {
      // Clear any stale checkout state
      console.log('[Paddle] Payment success — subscription activated');
    }
  </script>
</body>
</html>
