// ═══ TERMINAL ═══
function executeTerminal(){
  var i=document.getElementById('terminal-input');var c=i.value.trim();if(!c)return;
  var o=document.getElementById('terminal-output');
  o.innerHTML+='<div class="terminal-line">$ '+escapeHtml(c)+'</div>';
  if(c==='clear'){clearTerminal();i.value='';return;}
  if(c==='help'){o.innerHTML+='<div class="terminal-line">Commands: help, status, python &lt;code&gt;, ls &lt;path&gt;, cat &lt;path&gt;, clear</div><div class="terminal-line">&nbsp;</div>';o.scrollTop=o.scrollHeight;i.value='';return;}
  o.innerHTML+='<div class="terminal-line" style="color:#888">Executing...</div>';
  o.scrollTop=o.scrollHeight;
  var isPython=c.startsWith('python ');
  var plugin='code_exec';
  var params={};
  if(isPython){params.code=c.substring(7);}
  else if(c.startsWith('cat ')){params.action='read';params.path=c.substring(4).trim();plugin='file_ops';}
  else if(c.startsWith('ls ')){params.action='list';params.path=c.substring(3).trim();plugin='file_ops';}
  else if(c==='ls'){params.action='list';params.path='/opt/evolvixos';plugin='file_ops';}
  else if(c==='status'){params.code='import json; print(json.dumps({"status":"ok","msg":"Platform running"}))';}
  else{params.code='print("'+c.replace(/"/g,'\\"')+'")';}
  fetch(PLATFORM+'/api/plugins/'+plugin+'/execute',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({params:params})})
    .then(function(r){return r.json();})
    .then(function(d){
      o.innerHTML=o.innerHTML.replace(/<div class="terminal-line" style="color:#888">Executing\.\.\.<\/div>/,'');
      if(d.stdout)o.innerHTML+='<div class="terminal-line">'+escapeHtml(d.stdout)+'</div>';
      if(d.stderr)o.innerHTML+='<div class="terminal-line" style="color:#ff6666">'+escapeHtml(d.stderr)+'</div>';
      if(d.entries)o.innerHTML+='<div class="terminal-line">'+d.entries.map(escapeHtml).join('  ')+'</div>';
      if(d.content)o.innerHTML+='<div class="terminal-line">'+escapeHtml(d.content.substring(0,2000))+'</div>';
      if(d.error)o.innerHTML+='<div class="terminal-line" style="color:#ff6666">Error: '+escapeHtml(d.error)+'</div>';
      o.innerHTML+='<div class="terminal-line">&nbsp;</div>';
      o.scrollTop=o.scrollHeight;
    })
    .catch(function(err){
      o.innerHTML=o.innerHTML.replace(/<div class="terminal-line" style="color:#888">Executing\.\.\.<\/div>/,'');
      o.innerHTML+='<div class="terminal-line" style="color:#ff6666">Error: '+escapeHtml(err.message||'Request failed')+'</div><div class="terminal-line">&nbsp;</div>';
      o.scrollTop=o.scrollHeight;
    });
  i.value='';
}
function clearTerminal(){document.getElementById('terminal-output').innerHTML='<div class="terminal-line">EvolvixOS Terminal v1.0 — Type \'help\' for commands</div><div class="terminal-line">&nbsp;</div>';}

// ═══ API KEYS (REAL API) ═══
function createApiKey(){var n=prompt('API key name:','My Key');if(!n)return;fetch(AUTH+'/api-keys/generate',{method:'POST',headers:{'Authorization':'Bearer '+TOKEN,'Content-Type':'application/json'},body:JSON.stringify({name:n})}).then(function(r){return r.json();}).then(function(d){if(d.api_key||d.key){prompt('Copy your key (shown once):',d.api_key||d.key);toast('API key created','success');loadApiKeys();}else{toast('Error: '+(d.error||'Unknown'),'error');}}).catch(function(){toast('Error creating key','error');});}
function loadApiKeys(){var l=document.getElementById('apikeys-list');fetch(AUTH+'/api-keys',{headers:{'Authorization':'Bearer '+TOKEN}}).then(function(r){return r.json();}).then(function(d){var keys=d.keys||[];l.innerHTML=keys.length?keys.map(function(k){return '<div class="card p-3 flex items-center justify-between"><div><span class="text-sm font-mono">'+k.key_id+'</span><span class="text-xs text-gray-500 ml-2">'+(k.name||'Default')+'</span></div><button class="text-xs text-red-500 hover:underline" onclick="toast(\'Key revoked\')">Revoke</button></div>';}).join(''):'<div class="text-center text-gray-400 py-8">No API keys yet</div>';}).catch(function(){l.innerHTML='<div class="text-center text-gray-400 py-8">Failed to load keys</div>';});}

// ═══ VERSIONS ═══
function renderVersions(){
  var l=document.getElementById('versions-list');
  if(!l)return;
  l.innerHTML='<div class="text-center text-gray-400 py-8">Loading versions...</div>';
  api('/versions').then(function(data){
    var versions=data.versions||data||[];
    if(!Array.isArray(versions)){versions=[];}
    if(!versions.length){
      l.innerHTML='<div class="text-center text-gray-400 py-8">'+
        '<svg class="w-12 h-12 mx-auto mb-2 opacity-30" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="9"/></svg>'+
        '<p class="text-sm">No version history yet.</p>'+
        '<p class="text-xs mt-1">Versions are created when you create entities, deploy functions, or publish apps.</p></div>';
      return;
    }
    l.innerHTML=versions.map(function(v){
      var vn=v.version_number||'?';
      var desc=v.change_description||'Unknown change';
      var name=v.entity_name||'';
      var type=v.entity_type||'';
      var date=v.created_date||'';
      var vid=v.id||'';
      var typeIcon={app:'📱',entity:'🗄️',function:'⚙️',workflow:'🔄'}[type]||'📄';
      var typeColor={app:'bg-blue-50 text-blue-600',entity:'bg-green-50 text-green-600',function:'bg-purple-50 text-purple-600',workflow:'bg-orange-50 text-orange-600'}[type]||'bg-gray-50 text-gray-600';
      return '<div class="card p-4 flex items-center gap-3 hover:border-brand-500/30 transition-all">'+
        '<div class="w-10 h-10 rounded-lg flex items-center justify-center '+typeColor+'"><span class="text-lg">'+typeIcon+'</span></div>'+
        '<div class="flex-1 min-w-0">'+
          '<div class="text-sm font-medium truncate">'+desc+'</div>'+
          '<div class="flex items-center gap-2 mt-0.5">'+
            '<span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-gray-100 text-gray-600">v'+vn+'</span>'+
            '<span class="text-xs text-gray-500">'+name+'</span>'+
            '<span class="text-[10px] text-gray-400">('+type+')</span>'+
          '</div>'+
          '<div class="text-[10px] text-gray-400 mt-0.5">'+date+'</div>'+
        '</div>'+
        '<button class="btn-secondary text-xs whitespace-nowrap" onclick="restoreVersion('+vid+')">Restore</button>'+
      '</div>';
    }).join('');
  }).catch(function(){
    l.innerHTML='<div class="text-center text-gray-400 py-8">Failed to load version history.</div>';
  });
}
function restoreVersion(vid){
  if(!confirm('Restore this version? This will overwrite the current state.'))return;
  api('/versions/'+vid+'/restore',{method:'POST',body:JSON.stringify({})})
    .then(function(data){
      toast('Restored: '+(data.entity_name||'')+' v'+(data.version_number||''));
      renderVersions();
    })
    .catch(function(){toast('Failed to restore version');});
}

// ═══ UTILS ═══
function toast(msg,type){var t=document.createElement('div');t.className='toast '+(type||'');t.textContent=msg;document.getElementById('toast-container').appendChild(t);setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},300);},3000);}
function escapeHtml(t){var d=document.createElement('div');d.textContent=t;return d.innerHTML;}
function openUserSettings(){
  var existing=document.getElementById('user-dropdown');
  if(existing){existing.remove();return;}
  var dd=document.createElement('div');
  dd.id='user-dropdown';
  dd.style.cssText='position:fixed;bottom:60px;left:16px;width:240px;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:100;overflow:hidden';
  var uname=document.getElementById('user-name').textContent;
  var uemail=document.getElementById('user-email').textContent;
  dd.innerHTML='<div style="padding:12px 16px;border-bottom:1px solid rgba(0,0,0,.06)"><div style="font-size:13px;font-weight:600">'+uname+'</div><div style="font-size:12px;color:#86868b">'+uemail+'</div></div><div style="padding:8px"><a href="/login" style="display:block;padding:8px 12px;border-radius:8px;font-size:13px;color:#1d1d1f;text-decoration:none">Switch Account</a><a onclick="doLogout()" style="display:block;padding:8px 12px;border-radius:8px;font-size:13px;color:#ff3b30;cursor:pointer;text-decoration:none">Sign Out</a></div>';
  document.body.appendChild(dd);
  setTimeout(function(){
    document.addEventListener('click',function close(e){
      if(!dd.contains(e.target)){dd.remove();document.removeEventListener('click',close);}
    });
  },0);
}
function doLogout(){
  if(TOKEN){
    fetch(AUTH+'/logout',{method:'POST',headers:{'Authorization':'Bearer '+TOKEN}}).catch(function(){});
  }
  localStorage.removeItem('evolvixos_user');
  localStorage.removeItem('evolvixos_token');
  window.location.href='/login';
}





