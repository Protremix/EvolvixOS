function loadFiles(){
  var list=document.getElementById('file-list');if(!list){toast('Files: use Workbench to upload');return;}
  list.innerHTML='<div class="text-center text-gray-400 py-8"><div class="spinner mx-auto mb-2"></div>Loading files...</div>';
  api('/files').then(function(data){
    var files=data.files||data||[];
    if(!files.length){list.innerHTML='<div class="text-center text-gray-400 py-8">No files uploaded yet.</div>';return;}
    list.innerHTML=files.map(function(f){
      var size=f.size?Math.round(f.size/1024)+'KB':'';
      var date=(f.created_date||f.uploaded_at||'').substring(0,10);
      var name=f.filename||f.name||'file';
      return '<div class="card p-3 flex items-center gap-3"><div style="width:40px;height:40px;background:rgba(0,122,255,.1);border-radius:8px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg></div><div class="flex-1"><div class="text-sm font-medium">'+escapeHtml(name)+'</div><div class="text-xs text-gray-500">'+(f.content_type||'file')+' &bull; '+size+' &bull; '+date+'</div></div><button class="btn-ghost text-xs" onclick="toast(\'Download\')">Download</button></div>';
    }).join('');
  }).catch(function(){list.innerHTML='<div class="text-center text-gray-400 py-8">Failed to load files. Sign in required.</div>';});
}
