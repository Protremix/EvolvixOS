function showCreateEntity(){
  var modal='<div id="entity-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[500px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Create Entity</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Entity Name</label>'+
        '<input type="text" id="entity-name" placeholder="e.g. Task, Project, User" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500" onkeydown="if(event.key===\'Enter\')confirmCreateEntity()"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Schema (JSON)</label>'+
        '<textarea id="entity-schema" rows="8" class="w-full px-3 py-2 text-xs font-mono rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">{"type":"object","properties":{"name":{"type":"string"},"status":{"type":"string","enum":["active","done"]},"priority":{"type":"number"}}}</textarea>'+
        '<p class="text-[10px] text-gray-400">id, created_date, updated_date, created_by are auto-added.</p></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmCreateEntity()">Create Entity</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'entity-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('entity-name').focus();
}
function confirmCreateEntity(){
  var name=document.getElementById('entity-name').value.trim();
  var schemaText=document.getElementById('entity-schema').value.trim();
  if(!name){toast('Entity name required','error');return;}
  var schema;
  try{schema=JSON.parse(schemaText);}catch(e){toast('Invalid JSON: '+e.message,'error');return;}
  if(!schema.type)schema.type='object';
  toast('Creating entity...');
  api('/entities',{method:'POST',body:JSON.stringify({name:name,schema:schema})}).then(function(data){
    toast('Entity created: '+name,'success');
    document.getElementById('entity-modal').remove();
    loadEntities();
  }).catch(function(err){toast('Create failed: '+(err.message||'error'),'error');});
}

function showCreateFunction(){
  var modal='<div id="function-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[550px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Deploy Backend Function</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Function Name</label>'+
        '<input type="text" id="fn-name" placeholder="e.g. getTime, sendEmail" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Python Code</label>'+
        '<textarea id="fn-code" rows="10" class="w-full px-3 py-2 text-xs font-mono rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">def handler(event, context):\n    return {"message": "Hello from EvolvixOS!"}</textarea>'+
        '<p class="text-[10px] text-gray-400">Deployed as: POST /api/fn/&lt;name&gt;</p></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmCreateFunction()">Deploy</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'function-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('fn-name').focus();
}
function confirmCreateFunction(){
  var name=document.getElementById('fn-name').value.trim();
  var code=document.getElementById('fn-code').value.trim();
  if(!name){toast('Name required','error');return;}
  if(!code){toast('Code required','error');return;}
  toast('Deploying function...');
  api('/functions',{method:'POST',body:JSON.stringify({name:name,code:code})}).then(function(data){
    toast('Function deployed: '+name,'success');
    document.getElementById('function-modal').remove();
    loadFunctions();
  }).catch(function(err){toast('Deploy failed: '+(err.message||'error'),'error');});
}

function showCreateWorkflow(){
  var modal='<div id="workflow-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[500px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Create Workflow</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Workflow Name</label>'+
        '<input type="text" id="wf-name" placeholder="e.g. Daily Report" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Trigger Type</label>'+
        '<select id="wf-trigger" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">'+
        '<option value="scheduled">Scheduled (cron)</option>'+
        '<option value="entity">Entity Event</option>'+
        '<option value="manual">Manual</option></select></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Cron Expression</label>'+
        '<input type="text" id="wf-cron" placeholder="0 * * * *" value="0 * * * *" class="w-full px-3 py-2 text-sm font-mono rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Action (Python)</label>'+
        '<textarea id="wf-action" rows="6" class="w-full px-3 py-2 text-xs font-mono rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">def handler(event, context):\n    print("Workflow executed!")\n    return {"status":"ok"}</textarea></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmCreateWorkflow()">Create</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'workflow-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('wf-name').focus();
}
function confirmCreateWorkflow(){
  var name=document.getElementById('wf-name').value.trim();
  var trigger=document.getElementById('wf-trigger').value;
  var cron=document.getElementById('wf-cron').value.trim();
  var action=document.getElementById('wf-action').value.trim();
  if(!name){toast('Name required','error');return;}
  toast('Creating workflow...');
  var body={name:name,trigger:trigger,action:action};
  if(trigger==='scheduled')body.cron=cron;
  api('/workflows',{method:'POST',body:JSON.stringify(body)}).then(function(data){
    toast('Workflow created: '+name,'success');
    document.getElementById('workflow-modal').remove();
    loadWorkflows();
  }).catch(function(err){toast('Create failed: '+(err.message||'error'),'error');});
}

function showCreateAgent(){
  var modal='<div id="agent-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[500px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Create AI Agent</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Agent Name</label>'+
        '<input type="text" id="agent-name" placeholder="e.g. CodeReviewer" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Model</label>'+
        '<select id="agent-model" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">'+
        '<option value="auto">Auto (smart routing)</option>'+
        '<option value="qwen2.5:14b">Qwen 2.5 14B (local)</option>'+
        '<option value="qwen2.5:7b">Qwen 2.5 7B (local)</option>'+
        '<option value="groq/gpt-oss-120b">GPT-OSS 120B (Groq)</option>'+
        '<option value="gemini-flash-latest">Gemini Flash (Google)</option></select></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Description</label>'+
        '<input type="text" id="agent-desc" placeholder="What does this agent do?" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">System Prompt</label>'+
        '<textarea id="agent-prompt" rows="4" placeholder="You are a helpful assistant..." class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></textarea></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Tools (comma-separated)</label>'+
        '<input type="text" id="agent-tools" value="code_exec, file_ops" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmCreateAgent()">Create</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'agent-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('agent-name').focus();
}
function confirmCreateAgent(){
  var name=document.getElementById('agent-name').value.trim();
  var model=document.getElementById('agent-model').value;
  var desc=document.getElementById('agent-desc').value.trim();
  var prompt=document.getElementById('agent-prompt').value.trim();
  var tools=document.getElementById('agent-tools').value.split(',').map(function(t){return t.trim();}).filter(Boolean);
  if(!name){toast('Name required','error');return;}
  toast('Creating agent...');
  api('/agents',{method:'POST',body:JSON.stringify({name:name,model:model,description:desc,system_prompt:prompt,tools:tools})}).then(function(data){
    toast('Agent created: '+name,'success');
    document.getElementById('agent-modal').remove();
    loadAgents();
  }).catch(function(err){toast('Create failed: '+(err.message||'error'),'error');});
}

function createNote(){
  var modal='<div id="note-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[450px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">New Note</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Title</label>'+
        '<input type="text" id="note-title-input" placeholder="Note title" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Content</label>'+
        '<textarea id="note-content-input" rows="6" placeholder="Write your note..." class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></textarea></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmCreateNote()">Save</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'note-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('note-title-input').focus();
}
function confirmCreateNote(){
  var title=document.getElementById('note-title-input').value.trim();
  var body=document.getElementById('note-content-input').value.trim();
  if(!title){toast('Title required','error');return;}
  toast('Saving note...');
  api('/entities/Note/records',{method:'POST',body:JSON.stringify({title:title,content:body})}).then(function(data){
    toast('Note saved','success');
    document.getElementById('note-modal').remove();
    loadNotes();
  }).catch(function(err){toast('Save failed: '+(err.message||'error'),'error');});
}

function showCreateTeam(){
  var modal='<div id="team-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[450px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Create Agent Team</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Team Name</label>'+
        '<input type="text" id="team-name-input" placeholder="e.g. Dev Team" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Description</label>'+
        '<textarea id="team-desc-input" rows="3" placeholder="What does this team do?" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></textarea></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmCreateTeam()">Create</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'team-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('team-name-input').focus();
}
function confirmCreateTeam(){
  var name=document.getElementById('team-name-input').value.trim();
  var desc=document.getElementById('team-desc-input').value.trim();
  if(!name){toast('Name required','error');return;}
  toast('Creating team...');
  api('/entities/AgentTeam/records',{method:'POST',body:JSON.stringify({name:name,description:desc,agents:[]})}).then(function(data){
    toast('Team created: '+name,'success');
    document.getElementById('team-modal').remove();
    loadTeams();
  }).catch(function(err){toast('Create failed: '+(err.message||'error'),'error');});
}
function loadTeams(){
  var list=document.getElementById('team-list');if(!list)return;
  api('/entities/AgentTeam/records?limit=20').then(function(data){
    var teams=data.records||data||[];
    list.innerHTML=teams.length?teams.map(function(t){
      var name=t.name||'unknown';
      return '<div class="card p-3 flex items-center justify-between"><div><span class="text-sm font-medium">'+escapeHtml(name)+'</span><span class="text-xs text-gray-500 ml-2">'+(t.description||'')+'</span></div></div>';
    }).join(''):'<div class="text-center text-gray-400 py-8">No teams yet. Click "+ Create Team".</div>';
  }).catch(function(){list.innerHTML='<div class="text-center text-gray-400 py-8">No teams yet.</div>';});
}

function showEntityRecords(name){
  var modal='<div id="records-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[700px] p-6" style="max-height:80vh;overflow:auto">'+
      '<div class="flex items-center justify-between mb-4">'+
        '<h3 class="text-lg font-semibold">Records: '+escapeHtml(name)+'</h3>'+
        '<button class="btn-primary text-xs" onclick="confirmCreateRecord(\''+name+'\')">+ Add Record</button>'+
      '</div>'+
      '<div id="records-list-modal">Loading...</div>'+
      '<div class="mt-4"><button class="btn-secondary" onclick="document.getElementById(\'records-modal\').remove()">Close</button></div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  api('/entities/'+name+'/records?limit=50').then(function(data){
    var records=data.records||data||[];
    var el=document.getElementById('records-list-modal');
    if(!records.length){el.innerHTML='<p class="text-center text-gray-400 py-4">No records yet.</p>';return;}
    var keys=Object.keys(records[0]).filter(function(k){return ['id','created_date','updated_date','created_by','is_deleted'].indexOf(k)<0;});
    el.innerHTML='<div class="overflow-auto"><table class="w-full text-xs"><thead><tr class="border-b">'+
      keys.map(function(k){return '<th class="text-left py-2 px-2 text-gray-500">'+escapeHtml(k)+'</th>';}).join('')+
      '<th class="py-2 px-2"></th></tr></thead><tbody>'+
      records.map(function(r){
        return '<tr class="border-b hover:bg-black/[.02]">'+
          keys.map(function(k){
            var v=r[k];if(typeof v==='object')v=JSON.stringify(v);
            return '<td class="py-2 px-2">'+escapeHtml(String(v||'').substring(0,80))+'</td>';
          }).join('')+
          '<td class="py-2 px-2"><button class="text-xs text-red-500 hover:underline" onclick="deleteRecord(\''+name+'\',\''+r.id+'\')">Delete</button></td>'+
        '</tr>';
      }).join('')+
      '</tbody></table></div>';
  }).catch(function(err){document.getElementById('records-list-modal').innerHTML='<p class="text-red-500 text-sm">'+escapeHtml(err.message||'Failed')+'</p>';});
}
function deleteRecord(entity,recordId){
  if(!confirm('Delete this record?'))return;
  api('/entities/'+entity+'/records/'+recordId,{method:'DELETE'}).then(function(){
    toast('Record deleted');
    document.getElementById('records-modal').remove();
    showEntityRecords(entity);
  }).catch(function(err){toast('Delete failed: '+(err.message||'error'),'error');});
}
function confirmCreateRecord(name){
  if(document.getElementById('records-modal'))document.getElementById('records-modal').remove();
  var modal='<div id="add-record-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[450px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Add Record to '+escapeHtml(name)+'</h3>'+
      '<div><label class="text-xs font-medium text-gray-600">Record Data (JSON)</label>'+
      '<textarea id="record-json" rows="8" class="w-full px-3 py-2 text-xs font-mono rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">{"name":"New Item","status":"active"}</textarea></div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="submitNewRecord(\''+name+'\')">Add Record</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'add-record-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
}
function submitNewRecord(name){
  var jsonText=document.getElementById('record-json').value.trim();
  var data;
  try{data=JSON.parse(jsonText);}catch(e){toast('Invalid JSON: '+e.message,'error');return;}
  toast('Creating record...');
  api('/entities/'+name+'/records',{method:'POST',body:JSON.stringify(data)}).then(function(){
    toast('Record created','success');
    document.getElementById('add-record-modal').remove();
    showEntityRecords(name);
  }).catch(function(err){toast('Create failed: '+(err.message||'error'),'error');});
}

function connectChannel(ch){
  var steps={
    whatsapp:'1. Open WhatsApp on your phone 2. Settings > Linked Devices > Link a Device 3. Scan the QR code',
    telegram:'1. Search @BotFather in Telegram 2. Create a bot with /newbot 3. Copy the bot token 4. Paste in Agent Settings',
    slack:'1. Go to api.slack.com/apps 2. Create a new app 3. Add bot scopes 4. Install to workspace 5. Copy Bot Token',
    imessage:'1. Open System Settings > Messages 2. Enable Text Message Forwarding 3. Link Apple ID',
    phone:'1. Purchase a phone number 2. Verify your account 3. Configure voice settings',
    line:'1. Go to developers.line.biz 2. Create a Messaging API channel 3. Copy Channel Access Token'
  };
  var step=steps[ch.toLowerCase()]||'Setup instructions not available.';
  var modal='<div id="channel-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[450px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Connect '+escapeHtml(ch)+'</h3>'+
      '<div class="space-y-2 text-sm text-gray-600">'+
        step.split(/[0-9]+\./).filter(Boolean).map(function(s,i){return '<div class="flex gap-2"><span class="text-brand-500 font-medium">'+(i+1)+'.</span><span>'+s.trim()+'</span></div>';}).join('')+
      '</div>'+
      '<div class="mt-4"><button class="btn-secondary" onclick="document.getElementById(\'channel-modal\').remove()">Close</button></div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
}

function runSkill(id){
  toast('Executing skill: '+id);
  api('/skills/'+id+'/execute',{method:'POST',body:JSON.stringify({})}).then(function(data){
    toast('Skill executed: '+id,'success');
    if(data.output||data.result){
      var modal='<div id="skill-result-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
        '<div class="modal w-[500px] p-6">'+
          '<h3 class="text-lg font-semibold mb-3">Skill Result: '+escapeHtml(id)+'</h3>'+
          '<pre class="text-xs bg-black/[.03] rounded-lg p-3 overflow-auto max-h-60">'+escapeHtml(JSON.stringify(data.output||data.result,null,2))+'</pre>'+
          '<div class="mt-4"><button class="btn-secondary" onclick="document.getElementById(\'skill-result-modal\').remove()">Close</button></div>'+
        '</div></div>';
      document.body.insertAdjacentHTML('beforeend',modal);
    }
  }).catch(function(err){toast('Skill failed: '+(err.message||'error'),'error');});
}

function saveMemoryItem(){
  var modal='<div id="memory-modal" class="modal-overlay" onclick="if(event.target===this)this.remove()">'+
    '<div class="modal w-[450px] p-6">'+
      '<h3 class="text-lg font-semibold mb-4">Save Memory</h3>'+
      '<div class="space-y-3">'+
        '<div><label class="text-xs font-medium text-gray-600">Type</label>'+
        '<select id="mem-type" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500">'+
        '<option value="fact">Fact</option><option value="preference">Preference</option>'+
        '<option value="instruction">Instruction</option><option value="decision">Decision</option></select></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Category</label>'+
        '<input type="text" id="mem-category" placeholder="e.g. Work, Personal" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></div>'+
        '<div><label class="text-xs font-medium text-gray-600">Content</label>'+
        '<textarea id="mem-content" rows="4" placeholder="What to remember..." class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mt-1 focus:border-brand-500"></textarea></div>'+
      '</div>'+
      '<div class="flex gap-2 mt-4">'+
        '<button class="btn-primary flex-1" onclick="confirmSaveMemory()">Save</button>'+
        '<button class="btn-secondary" onclick="document.getElementById(\'memory-modal\').remove()">Cancel</button>'+
      '</div>'+
    '</div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('mem-content').focus();
}
function confirmSaveMemory(){
  var type=document.getElementById('mem-type').value;
  var category=document.getElementById('mem-category').value.trim()||'General';
  var content=document.getElementById('mem-content').value.trim();
  if(!content){toast('Content required','error');return;}
  toast('Saving memory...');
  api('/entities/PlatformMemory/records',{method:'POST',body:JSON.stringify({type:type,category:category,content:content})}).then(function(){
    toast('Memory saved','success');
    document.getElementById('memory-modal').remove();
    loadMemoryData();
  }).catch(function(err){toast('Save failed: '+(err.message||'error'),'error');});
}

</script>
</body>
</html>
