loadEntities();loadFunctions();loadWorkflows();loadMonitor();loadAnalytics();

// ═══ VOICE INPUT (Speech-to-Text) ═══
var voiceRecognition=null;var voiceActive=false;
function toggleVoiceInput(){
  if(voiceActive){stopVoiceInput();return;}
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){toast('Speech recognition not supported in this browser');return;}
  voiceRecognition=new SR();
  voiceRecognition.continuous=true;
  voiceRecognition.interimResults=true;
  voiceRecognition.lang='en-US';
  voiceRecognition.onresult=function(e){
    var txt='';for(var i=e.resultIndex;i<e.results.length;i++){txt+=e.results[i][0].transcript;}
    var input=document.getElementById('chat-input');
    input.value=txt;autoResize(input);
  };
  voiceRecognition.onend=function(){stopVoiceInput();};
  voiceRecognition.onerror=function(e){toast('Voice error: '+(e.error||'unknown'));stopVoiceInput();};
  voiceRecognition.start();
  voiceActive=true;
  var btn=document.getElementById('voice-btn');if(btn)btn.classList.add('bg-red-50');
  var icon=document.getElementById('voice-icon');if(icon){icon.classList.remove('text-gray-400');icon.classList.add('text-red-500');}
  toast('Listening...');
}
function stopVoiceInput(){
  if(voiceRecognition){voiceRecognition.stop();voiceRecognition=null;}
  voiceActive=false;
  var btn=document.getElementById('voice-btn');if(btn)btn.classList.remove('bg-red-50');
  var icon=document.getElementById('voice-icon');if(icon){icon.classList.add('text-gray-400');icon.classList.remove('text-red-500');}
}

// ═══ SCREEN SHARE ═══
var screenStream=null;
function toggleScreenShare(){
  if(screenStream){screenStream.getTracks().forEach(function(t){t.stop();});screenStream=null;toast('Screen share stopped');return;}
  if(!navigator.mediaDevices||!navigator.mediaDevices.getDisplayMedia){toast('Screen share not supported');return;}
  navigator.mediaDevices.getDisplayMedia({video:true}).then(function(stream){
    screenStream=stream;
    stream.getVideoTracks()[0].onended=function(){screenStream=null;toast('Screen share ended');};
    addChatMessage('agent','Screen share started. The agent can now see your screen.');
    toast('Screen share active');
  }).catch(function(){toast('Screen share cancelled');});
}

// ═══ BACKGROUND SUB-AGENTS (enhanced) ═══
var subAgents=[];
function spawnSubAgent(taskName){
  var id='subagent-'+Date.now();
  var agent={id:id,name:taskName,status:'running',startedAt:Date.now()};
  subAgents.push(agent);
  renderSubAgents();
  setTimeout(function(){
    agent.status='done';agent.completedAt=Date.now();
    renderSubAgents();
    addChatMessage('agent','Sub-agent "'+taskName+'" completed.');
  },2000+Math.random()*3000);
  return id;
}
function renderSubAgents(){
  var panel=document.getElementById('subagent-panel');
  if(!subAgents.length){panel.classList.add('hidden');return;}
  panel.classList.remove('hidden');
  var running=subAgents.filter(function(a){return a.status==='running';});
  document.getElementById('subagent-status').textContent=running.length+' sub-agent'+(running.length!==1?'s':'')+' running...';
}

