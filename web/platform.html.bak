  {id:'excel-tools',name:'Excel Tools',category:'data',icon:'📊',desc:'Create spreadsheets, formulas, charts, and data analysis',installed:false},
  {id:'crm-sync',name:'CRM Sync',category:'data',icon:'🗂️',desc:'Sync contacts, deals, and pipelines with HubSpot/Salesforce',installed:false},
  {id:'weather-api',name:'Weather API',category:'dev',icon:'🌤️',desc:'Get real-time weather data and forecasts for any location',installed:false},
  {id:'image-gen',name:'Image Generation',category:'media',icon:'🖼️',desc:'Generate images with AI — DALL-E, Stable Diffusion, Midjourney styles',installed:false},
  {id:'docx-tools',name:'DOCX Tools',category:'dev',icon:'📝',desc:'Create and edit Word documents programmatically',installed:false},
  {id:'web-scraper',name:'Web Scraper',category:'dev',icon:'🌐',desc:'Extract structured data from any website with CSS selectors',installed:false}
];
function loadSkills(){
  var grid=document.getElementById('skills-grid');if(!grid)return;
  renderSkillsGrid(skillsData);
}
function renderSkillsGrid(list){
  var grid=document.getElementById('skills-grid');if(!grid)return;
  if(!list.length){grid.innerHTML='<div class="col-span-3 text-center text-gray-400 py-8">No skills found.</div>';return;}
  grid.innerHTML=list.map(function(s){
    return '<div class="card p-4 hover:border-brand-500 transition-all"><div class="flex items-center gap-3 mb-2"><div style="width:40px;height:40px;background:rgba(0,122,255,.08);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px">'+s.icon+'</div><div class="flex-1"><h3 class="text-sm font-semibold">'+s.name+'</h3><span class="text-[10px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-500 uppercase">'+s.category+'</span></div></div><p class="text-xs text-gray-600 mb-3">'+s.desc+'</p><div class="flex gap-2">'+(s.installed?'<span class="badge badge-green text-[10px]">Installed</span><button class="btn-ghost text-xs flex-1" onclick="runSkill(\''+s.id+'\')">Run</button>':'<button class="btn-primary text-xs flex-1" onclick="installSkill(\''+s.id+'\')">Install</button>')+'</div></div>';
  }).join('');
}
function filterSkills(q){var f=skillsData.filter(function(s){return s.name.toLowerCase().indexOf(q.toLowerCase())>=0||s.desc.toLowerCase().indexOf(q.toLowerCase())>=0;});renderSkillsGrid(f);}
function filterSkillCategory(cat){var f=cat==='all'?skillsData:skillsData.filter(function(s){return s.category===cat;});renderSkillsGrid(f);}
function installSkill(id){var s=skillsData.find(function(x){return x.id===id;});if(s)s.installed=true;toast('Installing '+id+'...');setTimeout(function(){toast(id+' installed','success');loadSkills();},1500);}

function showUploadSkill(){var i=document.createElement('input');i.type='file';i.accept='.py,.js,.sh,.zip';i.onchange=function(){toast('Uploading skill...');setTimeout(function(){toast('Skill uploaded','success');},1000);};i.click();}

// ═══ CLOUD BROWSER ═══
function openCloudBrowser(url){
  if(!url)url='https://www.google.com';
  var modal=document.createElement('div');
  modal.className='fixed inset-0 bg-black/40 z-50 flex items-center justify-center';
  modal.id='browser-modal';
  modal.innerHTML='<div class="card p-0 max-w-5xl w-full h-[80vh] flex flex-col overflow-hidden" style="background:#fff"><div class="flex items-center gap-2 p-3 border-b border-black/[.06]"><div class="flex gap-1"><span class="w-3 h-3 rounded-full bg-red-400"></span><span class="w-3 h-3 rounded-full bg-yellow-400"></span><span class="w-3 h-3 rounded-full bg-green-400"></span></div><input type="text" value="'+url+'" id="browser-url" class="flex-1 px-3 py-1.5 text-sm rounded-lg border border-black/[.08]" onkeydown="if(event.key===\'Enter\'){document.getElementById(\'browser-frame\').src=this.value;}"><button class="btn-ghost text-xs" onclick="document.getElementById(\'browser-modal\').remove()">Close</button></div><iframe id="browser-frame" src="'+url+'" class="flex-1 w-full border-0" sandbox="allow-scripts allow-same-origin"></iframe></div>';
  document.body.appendChild(modal);
}

// ═══ CSV EXPORT ═══
function exportEntityCsv(name){
  api('/entities/'+name+'/records?limit=500').then(function(data){
    var records=data.records||data||[];
    if(!records.length){toast('No records to export');return;}
    var fields=Object.keys(records[0]);
    var csv=fields.join(',')+'\n';
    records.forEach(function(r){csv+=fields.map(function(f){var v=r[f]||'';if(typeof v==='object')v=JSON.stringify(v);return '"'+String(v).replace(/"/g,'""')+'"';}).join(',')+'\n';});
    var blob=new Blob([csv],{type:'text/csv'});
    var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name+'.csv';a.click();
    toast('Exported '+records.length+' records to CSV','success');
  }).catch(function(){toast('Export failed');});
}
function inspectSchema(name){
  api('/entities/'+name).then(function(data){
    var schema=data.schema||{};
    var modal=document.createElement('div');
    modal.className='fixed inset-0 bg-black/40 z-50 flex items-center justify-center';
    modal.id='schema-modal';
    var props=schema.properties||{};
    var required=schema.required||[];
    modal.innerHTML='<div class="card p-6 max-w-2xl w-full" style="background:#fff"><div class="flex items-center justify-between mb-4"><h2 class="text-lg font-bold">'+name+' Schema</h2><button class="btn-ghost text-xs" onclick="document.getElementById(\'schema-modal\').remove()">Close</button></div><div class="space-y-2">'+Object.keys(props).map(function(k){var p=props[k];return '<div class="flex items-center justify-between p-2 rounded bg-black/[.02]"><div><span class="text-sm font-mono">'+k+'</span>'+(required.indexOf(k)>=0?'<span class="text-[10px] text-red-500 ml-1">required</span>':'')+'</div><span class="badge badge-blue text-[10px]">'+(p.type||'any')+'</span></div>';}).join('')+'</div></div>';
    document.body.appendChild(modal);
  }).catch(function(){toast('Failed to load schema');});
}



// === TOOLS PAGE FUNCTIONS ===
function runCode(){
  var code=document.getElementById('code-input').value||document.getElementById('code-input').placeholder;
  var lang=document.getElementById('code-lang').value;
  var out=document.getElementById('code-output');
  out.innerHTML='<span style="color:#888">Running...</span>';
  fetch(PLATFORM+'/api/tools/run',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({code:code,language:lang})})
    .then(function(r){return r.json();})
    .then(function(d){
      var html='';
      if(d.stdout)html+='<span style="color:#a6e3a1">'+escapeHtml(d.stdout)+'</span>';
      if(d.stderr)html+='<span style="color:#f38ba8">'+escapeHtml(d.stderr)+'</span>';
      if(d.error)html+='<span style="color:#f38ba8">Error: '+escapeHtml(d.error)+'</span>';
      if(!html)html='<span style="color:#888">No output (exit code '+(d.exit_code||0)+')</span>';
      out.innerHTML=html;
    })
    .catch(function(err){out.innerHTML='<span style="color:#f38ba8">'+escapeHtml(err.message||'Failed')+'</span>';});
}
function browserFetch(){
  var url=document.getElementById('browser-url').value.trim();if(!url)return;
  var el=document.getElementById('browser-result');
  el.innerHTML='<div class="spinner mx-auto"></div><p class="text-gray-400 text-center mt-2">Fetching '+escapeHtml(url)+'...</p>';
  fetch(PLATFORM+'/api/tools/browser',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({action:'navigate',url:url})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.error){el.innerHTML='<p class="text-red-500">Error: '+escapeHtml(d.error)+'</p>';return;}
      el.innerHTML='<div><p class="text-sm font-medium mb-2">URL: '+escapeHtml(d.url)+'</p><p class="text-xs text-gray-500 mb-3">Content length: '+(d.content_length||0)+' bytes</p><pre class="text-xs overflow-auto" style="max-height:400px">'+escapeHtml(d.preview||'No preview')+'</pre></div>';
    })
    .catch(function(err){el.innerHTML='<p class="text-red-500">'+escapeHtml(err.message||'Failed')+'</p>';});
}
function browserExtract(){
  var url=document.getElementById('browser-url').value.trim();if(!url)return;
  var el=document.getElementById('browser-result');
  el.innerHTML='<div class="spinner mx-auto"></div><p class="text-gray-400 text-center mt-2">Extracting text from '+escapeHtml(url)+'...</p>';
  fetch(PLATFORM+'/api/tools/browser',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({action:'extract',url:url})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.error){el.innerHTML='<p class="text-red-500">Error: '+escapeHtml(d.error)+'</p>';return;}
      el.innerHTML='<div><p class="text-sm font-medium mb-1">Title: '+escapeHtml(d.title||'(none)')+'</p><p class="text-xs text-gray-500 mb-3">URL: '+escapeHtml(d.url)+'</p><div class="text-sm">'+escapeHtml(d.text||'No text extracted')+'</div></div>';
    })
    .catch(function(err){el.innerHTML='<p class="text-red-500">'+escapeHtml(err.message||'Failed')+'</p>';});
}
function navigateToPath(p){document.getElementById("file-path").value=p;listFiles();}
function listFiles(){
  var path=document.getElementById('file-path').value.trim();if(!path)return;
  var el=document.getElementById('file-content');
  el.innerHTML='<div class="spinner mx-auto"></div>';
  fetch(PLATFORM+'/api/tools/files',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({action:'list',path:path})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.error){el.innerHTML='<p class="text-red-500">'+escapeHtml(d.error)+'</p>';return;}
      var html='<div class="text-xs text-gray-500 mb-2">Path: '+escapeHtml(d.path)+'</div>';
      html+='<div class="space-y-1">';
      (d.entries||[]).forEach(function(e){
        var icon=e.type==='dir'?'folder':'file';
        var color=e.type==='dir'?'text-brand-500':'text-gray-400';
        html+='<div class="flex items-center gap-2 cursor-pointer hover:bg-gray-50 p-1 rounded" onclick="navigateToPath(\'+d.path+\'/\'+e.name+\')"><span class="'+color+' text-xs">'+icon+'</span><span class="text-sm">'+escapeHtml(e.name)+'</span>'+(e.size?'<span class="text-xs text-gray-400 ml-auto">'+e.size+'B</span>':'')+'</div>';
      });
      html+='</div>';
      el.innerHTML=html;
    })
    .catch(function(err){el.innerHTML='<p class="text-red-500">'+escapeHtml(err.message||'Failed')+'</p>';});
}
function readFile(){
  var path=document.getElementById('file-path').value.trim();if(!path)return;
  var el=document.getElementById('file-content');
  el.innerHTML='<div class="spinner mx-auto"></div>';
  fetch(PLATFORM+'/api/tools/files',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({action:'read',path:path})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.error){el.innerHTML='<p class="text-red-500">'+escapeHtml(d.error)+'</p>';return;}
      el.innerHTML='<div class="text-xs text-gray-500 mb-2">File: '+escapeHtml(d.path)+' ('+d.size+' bytes)</div><pre class="text-xs overflow-auto" style="max-height:400px;white-space:pre-wrap">'+escapeHtml(d.content||'(empty)')+'</pre>';
    })
    .catch(function(err){el.innerHTML='<p class="text-red-500">'+escapeHtml(err.message||'Failed')+'</p>';});
}
function runGrep(){
  var pattern=document.getElementById('grep-pattern').value.trim();if(!pattern)return;
  var path=document.getElementById('grep-path').value.trim()||'/opt/evolvixos';
  var el=document.getElementById('file-content');
  el.innerHTML='<div class="spinner mx-auto"></div>';
  fetch(PLATFORM+'/api/tools/grep',{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({pattern:pattern,path:path})})
    .then(function(r){return r.json();})
    .then(function(d){
      if(d.error){el.innerHTML='<p class="text-red-500">'+escapeHtml(d.error)+'</p>';return;}
      var html='<div class="text-xs text-gray-500 mb-2">'+d.count+' matches for "'+escapeHtml(pattern)+'"</div>';
      html+='<pre class="text-xs overflow-auto" style="max-height:400px;white-space:pre-wrap">'+escapeHtml((d.matches||[]).join('\n'))+'</pre>';
      el.innerHTML=html;
    })
    .catch(function(err){el.innerHTML='<p class="text-red-500">'+escapeHtml(err.message||'Failed')+'</p>';});
}

// === MISSING UI FUNCTIONS ===
function deleteEntity(name){
  if(!confirm('Delete entity "'+name+'" and all its records?'))return;
  api('/entities/'+name,{method:'DELETE'}).then(function(){toast('Entity deleted: '+name);loadEntities();}).catch(function(err){toast('Delete failed: '+(err.message||'error'),'error');});
}
function deleteFunction(name){
  if(!confirm('Delete function "'+name+'"?'))return;
  api('/functions/'+name,{method:'DELETE'}).then(function(){toast('Function deleted: '+name);loadFunctions();}).catch(function(err){toast('Delete failed: '+(err.message||'error'),'error');});
}
function testFunction(name){
  toast('Testing '+name+'...');
  fetch(PLATFORM+'/api/fn/'+name,{method:'POST',headers:{'Content-Type':'application/json','Authorization':'Bearer '+TOKEN},body:JSON.stringify({})})
    .then(function(r){return r.json();})
    .then(function(data){toast('Result received');alert('Function: '+name+'\n\nResult:\n'+JSON.stringify(data,null,2));})
    .catch(function(){api('/fn/'+name).then(function(data){alert('Function: '+name+'\n\nResult:\n'+JSON.stringify(data,null,2));}).catch(function(err2){toast('Test failed: '+(err2.message||'error'),'error');});});
}
function executeWorkflow(name){
  toast('Executing workflow: '+name+'...');
  api('/workflows/'+name+'/execute',{method:'POST',body:JSON.stringify({})}).then(function(data){toast('Workflow executed: '+name);loadWorkflows();}).catch(function(err){toast('Execute failed: '+(err.message||'error'),'error');});
}
function toggleWorkflow(name,active){
  var endpoint=active?'deactivate':'activate';
  toast((active?'Deactivating':'Activating')+' '+name+'...');
  api('/workflows/'+name+'/'+endpoint,{method:'PUT'}).then(function(){toast((active?'Deactivated':'Activated')+' '+name);loadWorkflows();}).catch(function(err){toast('Failed: '+(err.message||'error'),'error');});
}
function toggleCollab(){var p=document.getElementById('collab-panel');if(p)p.classList.toggle('hidden');else toast('Collab panel not available');}


