<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#f5f5f7">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>EvolvixOS Platform — Build Apps with AI</title>
<script src="https://cdn.tailwindcss.com">
</script>
<script>tailwind.config={theme:{extend:{colors:{brand:{50:'#EFF6FF',100:'#DBEAFE',200:'#BFDBFE',300:'#93C5FD',400:'#60A5FA',500:'#007AFF',600:'#0051A8',700:'#00408A',800:'#003070',900:'#002055'},accent:{400:'#5856D6',500:'#5856D6',600:'#4F46E5'}}}}}
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js">
</script>
<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Inter',system-ui,sans-serif;-webkit-font-smoothing:antialiased;background:#f5f5f7;color:#1d1d1f}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-thumb{background:rgba(0,0,0,.15);border-radius:3px}
::-webkit-scrollbar-track{background:transparent}
.page{display:none!important;animation:fadeIn .3s ease}
.page.active{display:block!important}
#page-chat.active{display:flex!important}
@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
@keyframes slideIn{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:translateX(0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
.sidebar{background:rgba(245,245,247,.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-right:1px solid rgba(0,0,0,.06)}
.nav-item{transition:all .2s cubic-bezier(.4,0,.2,1);position:relative;border-radius:8px;margin:1px 6px}
.nav-item:hover{background:rgba(0,122,255,.06)}
.nav-item.active{background:linear-gradient(90deg,rgba(0,122,255,.12),rgba(88,86,214,.04))}
.nav-item.active::before{content:'';position:absolute;left:-6px;top:4px;bottom:4px;width:3px;background:linear-gradient(180deg,#007AFF,#5856D6);border-radius:0 2px 2px 0}
.nav-item.active span,.nav-item.active{color:#007AFF!important}
.nav-icon-badge{width:20px;height:20px;flex-shrink:0;display:flex;align-items:center;justify-content:center}
.nav-icon-badge svg{width:20px;height:20px}
.nav-section-label{font-size:10px;font-weight:600;color:#86868b;text-transform:uppercase;letter-spacing:.05em;padding:8px 16px 4px}
.topbar{background:rgba(245,245,247,.8);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid rgba(0,0,0,.06)}
.chat-bubble{animation:slideIn .3s ease}
.chat-suggestion{transition:all .2s;cursor:pointer}
.chat-suggestion:hover{background:rgba(0,122,255,.06);border-color:rgba(0,122,255,.3)}
.mode-tab{transition:all .2s;padding:6px 14px;border-radius:8px;font-size:12px;font-weight:500;cursor:pointer;color:#86868b;border:none;background:transparent}
.mode-tab.active{background:#007AFF;color:#fff}
.mode-tab:not(.active):hover{background:rgba(0,0,0,.05)}
.queue-item{animation:slideIn .2s ease}
.subagent-badge{background:linear-gradient(135deg,rgba(0,122,255,.1),rgba(88,86,214,.1));border:1px solid rgba(0,122,255,.2)}
.canvas-page-card{transition:all .2s;cursor:pointer;border:1px solid rgba(0,0,0,.08)}
.canvas-page-card:hover{border-color:#007AFF;box-shadow:0 4px 12px rgba(0,122,255,.1)}
.card{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;transition:all .2s}
.card:hover{box-shadow:0 2px 8px rgba(0,0,0,.05)}
.stat-card{background:#fff;border:1px solid rgba(0,0,0,.06);border-radius:12px;padding:16px;transition:all .2s}
.stat-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.05)}
.btn-primary{background:#007AFF;color:#fff;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:500;transition:all .2s;border:none;cursor:pointer}
.btn-primary:hover{background:#0051A8}
.btn-secondary{background:rgba(0,122,255,.06);color:#007AFF;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:500;transition:all .2s;border:1px solid rgba(0,122,255,.15);cursor:pointer}
.btn-secondary:hover{background:rgba(0,122,255,.12)}
.btn-ghost{background:transparent;color:#86868b;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:500;transition:all .2s;border:none;cursor:pointer}
.btn-ghost:hover{background:rgba(0,0,0,.05);color:#1d1d1f}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:6px;font-size:11px;font-weight:500}
.badge-green{background:rgba(34,197,94,.1);color:#16a34a}
.badge-blue{background:rgba(0,122,255,.1);color:#007AFF}
.badge-orange{background:rgba(249,115,22,.1);color:#ea580c}
.badge-purple{background:rgba(88,86,214,.1);color:#5856D6}
.badge-gray{background:rgba(0,0,0,.05);color:#86868b}
.badge-red{background:rgba(220,38,38,.1);color:#dc2626}
.toggle{width:40px;height:22px;background:rgba(0,0,0,.15);border-radius:11px;position:relative;cursor:pointer;transition:all .2s}
.toggle.active{background:#007AFF}
.toggle::after{content:'';position:absolute;width:18px;height:18px;background:#fff;border-radius:50%;top:2px;left:2px;transition:all .2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.toggle.active::after{left:20px}
.spinner{width:16px;height:16px;border:2px solid rgba(0,122,255,.2);border-top-color:#007AFF;border-radius:50%;animation:spin .8s linear infinite;display:inline-block}
.skeleton{background:linear-gradient(90deg,rgba(0,0,0,.04),rgba(0,0,0,.08),rgba(0,0,0,.04));background-size:200% 100%;animation:shimmer 1.5s infinite}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);backdrop-filter:blur(4px);z-index:100;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s ease}
.modal{background:#fff;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.2);max-width:90vw;max-height:90vh;overflow:auto}
#toast-container{position:fixed;top:20px;right:20px;z-index:200;display:flex;flex-direction:column;gap:8px}
.toast{background:#1d1d1f;color:#fff;padding:12px 20px;border-radius:12px;font-size:13px;animation:slideIn .3s ease;box-shadow:0 4px 12px rgba(0,0,0,.15)}
.toast.success{background:#16a34a}
.toast.error{background:#dc2626}
.terminal{background:#1d1d1f;color:#00ff00;font-family:'SF Mono',Menlo,monospace;font-size:13px;padding:16px;border-radius:12px;overflow:auto;min-height:300px}
.terminal-line{white-space:pre-wrap}
.bottom-nav{display:none}
@media(max-width:768px){
  .sidebar{position:fixed;left:-260px;width:240px;height:100vh;z-index:50;transition:left .3s}
  .sidebar.open{left:0}
  .bottom-nav{display:flex;position:fixed;bottom:0;left:0;right:0;height:56px;background:rgba(245,245,247,.92);backdrop-filter:blur(20px);border-top:1px solid rgba(0,0,0,.06);z-index:40;justify-content:space-around;align-items:center}
  .bottom-nav-item{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10px;color:#86868b;padding:4px}
  .bottom-nav-item.active{color:#007AFF}
  .main-content{padding-bottom:60px}
}
input:focus,textarea:focus,select:focus{outline:none}
</style>
</head>
<body class="h-screen overflow-hidden">
<div id="toast-container"></div>
<div class="flex h-screen">
  <div id="mobile-overlay" onclick="toggleSidebar()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:40"></div>

  <!-- SIDEBAR -->
  <aside id="sidebar" class="sidebar w-60 flex flex-col h-screen flex-shrink-0">
    <div class="p-4 border-b border-black/[.06]">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div style="width:32px;height:32px;background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:8px;display:flex;align-items:center;justify-content:center"><span style="color:#fff;font-weight:700;font-size:16px">E</span></div>
          <div><span class="font-semibold text-sm text-gray-900">EvolvixOS</span><p class="text-[10px] text-gray-500 -mt-0.5">Engineering Platform</p></div>
        </div>
        <button onclick="openUserSettings()" class="text-gray-500 hover:text-brand-500 p-1.5 rounded-lg hover:bg-brand-500/10" title="Settings"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.6 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.6a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></button>
      </div>
    </div>
    <nav class="flex-1 overflow-y-auto py-2">
      <div class="nav-section-label">Build</div>
      <a class="nav-item active flex items-center gap-3 px-3 py-2 text-sm text-gray-900 cursor-pointer" data-page="chat" onclick="showPage('chat')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="4" fill="#007AFF" opacity=".15"/><path d="M8 10h8M8 14h5" stroke="#5856D6" stroke-width="2" stroke-linecap="round"/><rect x="3" y="3" width="18" height="18" rx="4" stroke="#5856D6" stroke-width="1.5"/></svg></div><span>Workbench</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="builder" onclick="showPage('builder')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" fill="#007AFF" opacity=".12"/><path d="M3 9h18M9 9v12" stroke="#5856D6" stroke-width="1.5"/><rect x="11" y="12" width="8" height="6" rx="1" fill="#007AFF" opacity=".2"/></svg></div><span>Builder</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="entities" onclick="showPage('entities')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="2" fill="#007AFF" opacity=".2"/><rect x="14" y="3" width="7" height="7" rx="2" fill="#007AFF" opacity=".15"/><rect x="3" y="14" width="7" height="7" rx="2" fill="#007AFF" opacity=".15"/><rect x="14" y="14" width="7" height="7" rx="2" fill="#007AFF" opacity=".2"/></svg></div><span>Entities</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="functions" onclick="showPage('functions')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M8 6L3 12l5 6M16 6l5 6-5 6" stroke="#5856D6" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div><span>Functions</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="workflows" onclick="showPage('workflows')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="6" cy="6" r="2" fill="#007AFF" opacity=".2"/><circle cx="18" cy="6" r="2" fill="#007AFF" opacity=".15"/><circle cx="6" cy="18" r="2" fill="#007AFF" opacity=".15"/><circle cx="18" cy="18" r="2" fill="#007AFF" opacity=".2"/><circle cx="12" cy="12" r="2" fill="#007AFF" opacity=".25"/><path d="M8 6h8M6 8v8M18 8v8M8 18h8" stroke="#5856D6" stroke-width="1" opacity=".3" stroke-linecap="round"/></svg></div><span>Workflows</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="templates" onclick="showPage('templates')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="3" fill="#007AFF" opacity=".12"/><path d="M8 8h8M8 12h8M8 16h5" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/></svg></div><span>Templates</span></a><a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="skills" onclick="showPage('skills');loadSkills()"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M13 10V3L4 14h7v7l9-11h-7z" fill="#007AFF" opacity=".12" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div><span>Skills</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="storage" onclick="showPage('storage')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><ellipse cx="12" cy="6" rx="7" ry="3" fill="#007AFF" opacity=".15"/><path d="M5 6v12c0 1.5 3 3 7 3s7-1.5 7-3V6" fill="#007AFF" opacity=".12" stroke="#5856D6" stroke-width="1.5"/></svg></div><span>Files</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="notes" onclick="showPage('notes')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M4 4h12l4 4v12H4z" fill="#007AFF" opacity=".12" stroke="#5856D6" stroke-width="1.5"/><path d="M8 10h8M8 14h6" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/></svg></div><span>Notes</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="memory" onclick="showPage('memory')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="4" width="16" height="16" rx="3" fill="#007AFF" opacity=.12"/><circle cx="12" cy="12" r="4" fill="none" stroke="#5856D6" stroke-width="1.5"/></svg></div><span>Memory</span></a>

      <div class="nav-section-label">Tools</div>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="coderunner" onclick="showPage('coderunner')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 18l6-6-6-6M8 6l-6 6 6 6" stroke-linecap="round"/></svg></div><span>Code Runner</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="browser-tool" onclick="showPage('browser-tool')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20M12 2a15 15 0 000 20"/></svg></div><span>Browser</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="fileexplorer" onclick="showPage('fileexplorer')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" stroke-linecap="round" stroke-linejoin="round"/></svg></div><span>File Explorer</span></a>
      <div class="nav-section-label">Agents</div>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="agents" onclick="showPage('agents')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="4" y="8" width="16" height="12" rx="3" fill="#007AFF" opacity=".15"/><circle cx="9" cy="14" r="1.5" fill="#5856D6"/><circle cx="15" cy="14" r="1.5" fill="#5856D6"/><path d="M12 4v4" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/></svg></div><span>Agents</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="agentteams" onclick="showPage('agentteams')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="8" cy="10" r="3" fill="#007AFF" opacity=".15"/><circle cx="16" cy="10" r="3" fill="#007AFF" opacity=".15"/><path d="M4 20c0-3 2-5 4-5s4 2 4 5M12 20c0-3 2-5 4-5s4 2 4 5" stroke="#5856D6" stroke-width="1.5" fill="none"/></svg></div><span>Agent Teams</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="channels" onclick="showPage('channels')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M4 12c0-4 4-7 8-7s8 3 8 7-4 7-8 7c-1 0-2-.2-3-.5L5 20l1-3.5C5 15 4 13.5 4 12z" fill="#007AFF" opacity=".12" stroke="#5856D6" stroke-width="1.5"/></svg></div><span>Channels</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="connectors" onclick="showPage('connectors')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="6" cy="6" r="2.5" fill="#007AFF" opacity=".2"/><circle cx="18" cy="6" r="2.5" fill="#007AFF" opacity=".15"/><circle cx="6" cy="18" r="2.5" fill="#007AFF" opacity=".15"/><circle cx="18" cy="18" r="2.5" fill="#007AFF" opacity=".2"/><path d="M8.5 6h7M6 8.5v7M18 8.5v7M8.5 18h7" stroke="#5856D6" stroke-width="1.5" opacity=".3" stroke-linecap="round"/></svg></div><span>Connectors</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="agentsettings" onclick="showPage('agentsettings')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="3" fill="#007AFF" opacity=".15"/><path d="M12 1v6m0 6v6m11-7h-6m-6 0H1" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/></svg></div><span>Agent Settings</span></a>

      <div class="nav-section-label">Infrastructure</div>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="models" onclick="showPage('models')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" fill="#007AFF" opacity=".08"/><path d="M12 3v18M3 12h18" stroke="#5856D6" stroke-width="1.5"/><circle cx="12" cy="12" r="4" fill="#007AFF" opacity=".15"/></svg></div><span>Model Routing</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="rag" onclick="showPage('rag')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h10" fill="#007AFF" opacity=".12" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/><circle cx="18" cy="18" r="3" fill="#007AFF" opacity=".2"/></svg></div><span>RAG Engine</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="monitor" onclick="showPage('monitor')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="12" rx="2" fill="#007AFF" opacity=".12"/><path d="M7 10l2 2 4-4M3 20h18" stroke="#5856D6" stroke-width="1.5"/></svg></div><span>Server Monitor</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="logs" onclick="showPage('logs')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" fill="#007AFF" opacity=.08"/><path d="M7 9h10M7 13h7M7 17h4" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/></svg></div><span>Logs</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="terminal" onclick="showPage('terminal')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" fill="#1d1d1f"/><path d="M7 9l3 3-3 3M13 15h4" stroke="#00ff00" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></div><span>Terminal</span></a>

      <div class="nav-section-label">Account</div>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="analytics" onclick="showPage('analytics')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><path d="M3 21h18M3 17l5-5 3 3 5-5" stroke="#5856D6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></div><span>Analytics</span></a>
      <a class="nav-item flex items-center gap-3 px-3 py-2 text-sm text-gray-600 cursor-pointer" data-page="apikeys" onclick="showPage('apikeys')"><div class="nav-icon-badge"><svg viewBox="0 0 24 24" fill="none"><circle cx="8" cy="12" r="4" fill="#007AFF" opacity=".15" stroke="#5856D6" stroke-width="1.5"/><path d="M12 12h8m-3-3v6" stroke="#5856D6" stroke-width="1.5" stroke-linecap="round"/></svg></div><span>API Keys</span></a>
    </nav>
    <div class="p-3 border-t border-black/[.06]">
      <div class="flex items-center gap-2.5 cursor-pointer hover:bg-black/[.04] p-2 rounded-lg" onclick="openUserSettings()">
        <div style="width:32px;height:32px;background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:50%;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:600;font-size:13px" id="user-avatar">U</div>
        <div class="flex-1 min-w-0"><p class="text-sm font-medium text-gray-900 truncate" id="user-name">User</p><p class="text-[10px] text-gray-500 truncate" id="user-email">admin@evolvixos.com</p></div>
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
      </div>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="flex-1 flex flex-col h-screen overflow-hidden main-content">
    <div class="topbar flex items-center justify-between px-4 h-14 flex-shrink-0">
      <div class="flex items-center gap-3">
        <button onclick="toggleSidebar()" class="md:hidden p-2 rounded-lg hover:bg-black/[.05]"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <span class="text-sm text-gray-500" id="breadcrumb">Workbench</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="relative"><input type="text" placeholder="Search..." class="w-48 px-3 py-1.5 text-sm rounded-lg border border-black/[.08] bg-black/[.03] focus:border-brand-500 focus:bg-white"><span class="absolute right-2 top-1/2 -translate-y-1/2 text-[10px] text-gray-400">⌘K</span></div>
        <button class="p-2 rounded-lg hover:bg-black/[.05]" title="Notifications"><svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 00-12 0v3.2c0 .5-.2 1-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg></button>
        <a href="https://github.com/Protremix/EvolvixOS" target="_blank" class="p-2 rounded-lg hover:bg-black/[.05]" title="GitHub"><svg class="w-4 h-4 text-gray-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .3a12 12 0 00-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.5 18.3 4.8 18.3 4.8c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0012 .3"/></svg></a>
      </div>
    </div>
    <div class="flex-1 overflow-y-auto">

<!-- PAGE: WORKBENCH -->
<div id="page-chat" class="page active h-full flex flex-col">
  <div class="flex items-center justify-between px-4 py-2 border-b border-black/[.04]">
    <div class="flex items-center gap-1">
      <button class="mode-tab active" data-mode="default" onclick="setChatMode('default')">Default</button>
      <button class="mode-tab" data-mode="discuss" onclick="setChatMode('discuss')">Discuss</button>
      <button class="mode-tab" data-mode="edit" onclick="setChatMode('edit')">Edit</button>
      <span class="text-[10px] text-gray-400 ml-2">⌘. to switch</span>
    </div>
    <div class="flex items-center gap-2">
      <select id="chat-model-select" class="text-xs px-2 py-1 rounded-lg border border-black/[.08] bg-white"><option value="auto">Auto Mode</option><optgroup label="Cloud (Fast)"><option value="qwen/qwen3.8-27b">Qwen 3.8 27B</option><option value="deepseek/deepseek-v4-flash">DeepSeek V4 Flash</option><option value="google/gemini-3.7-flash">Gemini 3.7 Flash</option><option value="google/gemma-4-31b">Gemma 4 31B</option><option value="groq/gpt-oss-120b">GPT-OSS 120B (Groq)</option></optgroup><optgroup label="Local (Private)"><option value="qwen2.5:14b">Qwen 2.5 14B</option><option value="qwen2.5:7b">Qwen 2.5 7B</option><option value="qwen2.5:3b">Qwen 2.5 3B</option></optgroup><optgroup label="Advanced"><option value="nemotron">Nemotron 3 550B</option><option value="kimi/moonshot-v1-32k">Kimi Moonshot 32K</option></optgroup></select>
      <button class="btn-ghost text-xs" onclick="clearChat()">Clear</button>
    </div>
  </div>
  <div class="flex-1 overflow-y-auto px-4 py-4" id="chat-messages">
    <div class="chat-bubble max-w-2xl mx-auto mb-4"><div class="flex gap-3"><div style="width:32px;height:32px;background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px">E</div><div class="flex-1"><div class="card p-4"><p class="text-sm text-gray-700">Good morning! I'm your EvolvixOS workbench. I can create entities, deploy functions, set up workflows, and execute code.</p><p class="text-sm text-gray-700 mt-2">What would you like to build?</p></div><div class="flex flex-wrap gap-2 mt-3"><button class="chat-suggestion text-xs px-3 py-1.5 rounded-lg border border-black/[.08] text-gray-600" onclick="insertSuggestion('Create an entity with name, email, company, status fields')">Create an entity</button><button class="chat-suggestion text-xs px-3 py-1.5 rounded-lg border border-black/[.08] text-gray-600" onclick="insertSuggestion('Deploy a function that sends an email notification')">Deploy a function</button><button class="chat-suggestion text-xs px-3 py-1.5 rounded-lg border border-black/[.08] text-gray-600" onclick="insertSuggestion('Browse the web for latest AI engineering trends')">Web research</button><button class="chat-suggestion text-xs px-3 py-1.5 rounded-lg border border-black/[.08] text-gray-600" onclick="insertSuggestion('Show me the model routing configuration')">Model routing</button></div></div></div></div>
  </div>
  <div id="chat-queue" class="px-4 hidden"><div class="max-w-2xl mx-auto"><div class="text-xs text-gray-500 mb-1 flex items-center justify-between"><span>Queued messages (<span id="queue-count">0</span>/7)</span><button class="text-xs text-brand-500 hover:underline" onclick="clearQueue()">Clear all</button></div><div id="queue-list" class="space-y-1"></div></div></div>
  <div id="subagent-panel" class="px-4 hidden"><div class="max-w-2xl mx-auto"><div class="subagent-badge rounded-lg p-2 flex items-center gap-2"><div class="spinner"></div><span class="text-xs text-gray-600" id="subagent-status">Sub-agent working...</span></div></div></div>
  <div class="border-t border-black/[.04] px-4 py-3"><div class="max-w-2xl mx-auto"><div class="flex items-end gap-2"><button class="p-2 rounded-lg hover:bg-black/[.05]" title="Attach file" onclick="document.getElementById('file-upload').click()"><svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg></button><input type="file" id="file-upload" class="hidden" onchange="handleFileUpload(this)"><button class="p-2 rounded-lg hover:bg-black/[.05]" title="Screen share" onclick="toggleScreenShare()"><svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg></button><button class="p-2 rounded-lg hover:bg-black/[.05]" id="voice-btn" title="Voice input" onclick="toggleVoiceInput()"><svg class="w-5 h-5 text-gray-400" id="voice-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg></button><textarea id="chat-input" rows="1" placeholder="Ask me to build something..." class="flex-1 px-3 py-2 text-sm rounded-xl border border-black/[.08] bg-white resize-none focus:border-brand-500 max-h-32" onkeydown="handleChatKeydown(event)" oninput="autoResize(this)"></textarea><button class="p-2 rounded-xl bg-brand-500 hover:bg-brand-600 transition-colors" onclick="sendChatMessage()"><svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div><div class="flex items-center justify-between mt-2"><div class="flex items-center gap-2"><span class="text-[10px] text-gray-400">Quick start:</span><button class="chat-suggestion text-[10px] px-2 py-0.5 rounded border border-black/[.06] text-gray-500" onclick="insertSuggestion('Create an entity for my project')">New entity<button class="chat-suggestion text-[10px] px-2 py-0.5 rounded border border-black/[.06] text-gray-500" onclick="insertSuggestion('Deploy a backend function')">Deploy function<button class="chat-suggestion text-[10px] px-2 py-0.5 rounded border border-black/[.06] text-gray-500" onclick="insertSuggestion('Set up a workflow')">Workflow</div><span class="text-[10px] text-gray-400" id="mode-indicator">Default mode</span></div></div></div>
</div>

<!-- PAGE: BUILDER -->
<div id="page-builder" class="page p-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">App Builder</h1><p class="text-sm text-gray-500 mt-1">Build apps from natural language. Switch modes to plan, edit, or apply instantly.</p></div><div class="flex items-center gap-2"><button class="btn-secondary" onclick="showPage('versions')">Version History</button><button class="btn-primary" onclick="showPage('chat')">Open Workbench</button></div></div>
    <div class="card p-4 mb-4"><div class="flex items-center gap-1 mb-3"><button class="mode-tab active" data-bmode="default" onclick="setBuilderMode('default')">Default</button><button class="mode-tab" data-bmode="discuss" onclick="setBuilderMode('discuss')">Discuss</button><button class="mode-tab" data-bmode="edit" onclick="setBuilderMode('edit')">Edit</button></div><div id="builder-chat" class="space-y-3 min-h-[200px] max-h-[300px] overflow-y-auto mb-3"><div class="text-sm text-gray-500 text-center py-8">Describe what you want to build and the AI will create it for you.</div></div><div class="flex gap-2"><input type="text" id="builder-input" placeholder="e.g. Create a dashboard with analytics charts" class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08] focus:border-brand-500" onkeydown="if(event.key==='Enter')sendBuilderMessage()"><button class="btn-primary" onclick="sendBuilderMessage()">Build</button></div></div>
    <div id="edit-mode-panel" class="card p-4 hidden">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold">Edit Mode — Visual Inspector</h3>
            <span class="text-[10px] text-gray-400">Click elements in preview to edit</span>
          </div>
          <!-- Preview iframe -->
          <div class="rounded-lg border border-black/[.06] overflow-hidden mb-3" style="height:280px">
            <iframe id="edit-preview-frame" style="width:100%;height:100%;border:0" srcdoc=""></iframe>
          </div>
          <!-- Property panel -->
          <div id="edit-props" class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-[10px] text-gray-500">Background</label>
                <div class="flex gap-1 mt-1">
                  <button class="color-swatch" style="background:#007AFF" onclick="applyStyle('background','#007AFF')"></button>
                  <button class="color-swatch" style="background:#5856D6" onclick="applyStyle('background','#5856D6')"></button>
                  <button class="color-swatch" style="background:#34C759" onclick="applyStyle('background','#34C759')"></button>
                  <button class="color-swatch" style="background:#FF9500" onclick="applyStyle('background','#FF9500')"></button>
                  <button class="color-swatch" style="background:#f5f5f7" onclick="applyStyle('background','#f5f5f7')"></button>
                  <button class="color-swatch" style="background:#000000" onclick="applyStyle('background','#000000')"></button>
                </div>
              </div>
              <div>
                <label class="text-[10px] text-gray-500">Text Color</label>
                <div class="flex gap-1 mt-1">
                  <button class="color-swatch" style="background:#ffffff;border:1px solid #ddd" onclick="applyStyle('color','#ffffff')"></button>
                  <button class="color-swatch" style="background:#000000" onclick="applyStyle('color','#000000')"></button>
                  <button class="color-swatch" style="background:#007AFF" onclick="applyStyle('color','#007AFF')"></button>
                  <button class="color-swatch" style="background:#5856D6" onclick="applyStyle('color','#5856D6')"></button>
                  <button class="color-swatch" style="background:#8E8E93" onclick="applyStyle('color','#8E8E93')"></button>
                  <button class="color-swatch" style="background:#FF3B30" onclick="applyStyle('color','#FF3B30')"></button>
                </div>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-2">
              <div>
                <label class="text-[10px] text-gray-500">Padding</label>
                <input type="text" id="edit-padding" placeholder="16px" class="w-full text-xs px-2 py-1 rounded border border-black/[.08]" oninput="applyStyle('padding',this.value)">
              </div>
              <div>
                <label class="text-[10px] text-gray-500">Margin</label>
                <input type="text" id="edit-margin" placeholder="0px" class="w-full text-xs px-2 py-1 rounded border border-black/[.08]" oninput="applyStyle('margin',this.value)">
              </div>
              <div>
                <label class="text-[10px] text-gray-500">Border Radius</label>
                <input type="text" id="edit-radius" placeholder="8px" class="w-full text-xs px-2 py-1 rounded border border-black/[.08]" oninput="applyStyle('borderRadius',this.value)">
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="text-[10px] text-gray-500">Font Size</label>
                <input type="text" id="edit-fontsize" placeholder="14px" class="w-full text-xs px-2 py-1 rounded border border-black/[.08]" oninput="applyStyle('fontSize',this.value)">
              </div>
              <div>
                <label class="text-[10px] text-gray-500">Font Weight</label>
                <select id="edit-fontweight" class="w-full text-xs px-2 py-1 rounded border border-black/[.08]" onchange="applyStyle('fontWeight',this.value)">
                  <option value="">Default</option>
                  <option value="300">Light (300)</option>
                  <option value="400">Regular (400)</option>
                  <option value="500">Medium (500)</option>
                  <option value="600">Semibold (600)</option>
                  <option value="700">Bold (700)</option>
                </select>
              </div>
            </div>
            <div>
              <label class="text-[10px] text-gray-500">Tailwind Classes (type to add)</label>
              <div class="flex gap-2 mt-1">
                <input type="text" id="edit-tailwind" placeholder="e.g. shadow-lg rounded-xl" class="flex-1 text-xs px-2 py-1 rounded border border-black/[.08]" onkeydown="if(event.key==='Enter')applyTailwind(this.value)">
                <button class="btn-primary text-xs" onclick="applyTailwind(document.getElementById('edit-tailwind').value)">Add</button>
              </div>
            </div>
            <!-- AI Edit -->
            <div>
              <label class="text-[10px] text-gray-500">AI Edit (describe changes in natural language)</label>
              <div class="flex gap-2 mt-1">
                <input type="text" id="edit-element-input" placeholder="e.g. Make this button larger and rounded" class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08] focus:border-brand-500" onkeydown="if(event.key==='Enter')editElement()">
                <button class="btn-primary" onclick="editElement()">AI Edit</button>
              </div>
            </div>
            <div id="edit-status" class="text-[10px] text-gray-400">No element selected. Click on the preview above.</div>
            <div class="mt-3 pt-3 border-t border-black/[.06]">
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-semibold text-gray-500">BULK EDIT</span>
                <button class="text-[10px] text-brand-500 hover:underline" onclick="bulkSelectAll()">Select All</button>
              </div>
              <div class="flex gap-1 flex-wrap">
                <button class="text-[10px] px-2 py-1 rounded border border-black/[.06] hover:border-brand-500" onclick="bulkEdit('fontSize','12px')">12px font</button>
                <button class="text-[10px] px-2 py-1 rounded border border-black/[.06] hover:border-brand-500" onclick="bulkEdit('borderRadius','16px')">Round 16px</button>
                <button class="text-[10px] px-2 py-1 rounded border border-black/[.06] hover:border-brand-500" onclick="bulkEdit('padding','20px')">Pad 20px</button>
                <button class="text-[10px] px-2 py-1 rounded border border-black/[.06] hover:border-brand-500" onclick="bulkEdit('boxShadow','0 4px 12px rgba(0,0,0,.1)')">Shadow</button>
                <button class="text-[10px] px-2 py-1 rounded border border-black/[.06] hover:border-brand-500" onclick="bulkTheme('dark')">Dark</button>
                <button class="text-[10px] px-2 py-1 rounded border border-black/[.06] hover:border-brand-500" onclick="bulkTheme('light')">Light</button>
              </div>
            </div>
          </div>
        </div>
    <div class="mb-4"><div class="flex items-center justify-between mb-3"><div class="flex items-center gap-2"><h2 class="text-sm font-semibold">Canvas — All Pages</h2><div id="collab-indicator" class="hidden flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-600 text-[10px]"><span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span><span id="collab-count">1</span> online</div></div><div class="flex items-center gap-2"><button class="btn-ghost text-xs flex items-center gap-1" onclick="toggleCollab()"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-8 0 4 4 0 008 0zm6 0a4 4 0 10-8 0 4 4 0 008 0z"/></svg>Collaborate</button><button class="btn-ghost text-xs" onclick="addCanvasPage()">+ Add Page</button></div></div><div id="canvas-grid" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3"></div></div>
    <div><h2 class="text-sm font-semibold mb-3">Components Library</h2><div class="grid grid-cols-2 md:grid-cols-4 gap-3"><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('button')"><div class="text-center py-3"><span class="text-xs text-brand-500">Button</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('input')"><div class="text-center py-3"><span class="text-xs text-brand-500">Input Field</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('table')"><div class="text-center py-3"><span class="text-xs text-brand-500">Table</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('chart')"><div class="text-center py-3"><span class="text-xs text-brand-500">Chart</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('card')"><div class="text-center py-3"><span class="text-xs text-brand-500">Card</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('navbar')"><div class="text-center py-3"><span class="text-xs text-brand-500">Navbar</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('sidebar')"><div class="text-center py-3"><span class="text-xs text-brand-500">Sidebar</span></div></div><div class="card p-3 cursor-pointer hover:border-brand-500" onclick="addComponent('modal')"><div class="text-center py-3"><span class="text-xs text-brand-500">Modal</span></div></div></div></div>
  </div>
</div>

<!-- PAGE: ENTITIES -->
<div id="page-entities" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Entities</h1><p class="text-sm text-gray-500 mt-1">Data models with JSON schemas and CRUD APIs</p></div><button class="btn-primary" onclick="showCreateEntity()">+ New Entity</button></div><div id="entity-stats" class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6"></div><div id="entity-list" class="space-y-2"></div></div></div>

<!-- PAGE: FUNCTIONS -->
<div id="page-functions" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Backend Functions</h1><p class="text-sm text-gray-500 mt-1">Deploy Python code as HTTP endpoints</p></div><button class="btn-primary" onclick="showCreateFunction()">+ New Function</button></div><div id="function-list" class="space-y-2"></div></div></div>

<!-- PAGE: WORKFLOWS -->
<div id="page-workflows" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Workflows</h1><p class="text-sm text-gray-500 mt-1">Scheduled and triggered automations</p></div><button class="btn-primary" onclick="showCreateWorkflow()">+ New Workflow</button></div><div class="flex gap-1 mb-4 border-b border-black/[.06]"><button class="px-4 py-2 text-sm font-medium border-b-2 border-brand-500 text-brand-500" onclick="switchWorkflowTab(event,'scheduled')">Scheduled</button><button class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900" onclick="switchWorkflowTab(event,'triggered')">Triggered</button><button class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-900" onclick="switchWorkflowTab(event,'activity')">Activity</button></div><div id="workflow-scheduled" class="space-y-2"></div><div id="workflow-triggered" class="space-y-2 hidden"></div><div id="workflow-activity" class="space-y-2 hidden"></div></div></div>

<!-- PAGE: TEMPLATES -->
<div id="page-templates" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Templates</h1><p class="text-sm text-gray-500 mt-1">Pre-built app templates and LLM prompts</p></div><input type="text" placeholder="Search templates..." class="px-3 py-1.5 text-sm rounded-lg border border-black/[.08] focus:border-brand-500" oninput="filterTemplates(this.value)"></div><div id="template-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div></div></div>

<!-- PAGE: STORAGE -->
<div id="page-skills" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Skills</h1><p class="text-sm text-gray-500 mt-1">Curated catalog + custom uploads</p></div><div class="flex gap-2"><button class="btn-secondary text-xs" onclick="toast('Opening skill store...')">Browse Store</button><button class="btn-primary text-xs" onclick="showUploadSkill()">+ Upload Skill</button></div></div><div class="flex gap-2 mb-4"><input type="text" id="skill-search" placeholder="Search skills..." class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08] focus:border-brand-500" oninput="filterSkills(this.value)"><select class="px-3 py-2 text-sm rounded-lg border border-black/[.08]" onchange="filterSkillCategory(this.value)"><option value="all">All</option><option value="media">Media</option><option value="dev">Development</option><option value="data">Data</option><option value="ai">AI/ML</option><option value="custom">Custom</option></select></div><div id="skills-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3"></div></div></div>

<div id="page-storage" class="page p-6"><div class="max-w-3xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Files</h1><p class="text-sm text-gray-500 mt-1">Upload and manage files</p></div><button class="btn-primary" onclick="toast('File upload — use API: POST /platform/api/files')">Upload</button></div><div id="storage-list" class="space-y-1"></div></div></div>

<!-- PAGE: NOTES -->
<div id="page-notes" class="page p-6"><div class="max-w-4xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Notes</h1><p class="text-sm text-gray-500 mt-1">Shared knowledge between you and your agent</p></div><button class="btn-primary" onclick="createNote()">+ New Note</button></div><div class="card p-4 mb-4 border-l-4 border-orange-400"><div class="flex items-center gap-2 mb-2"><span class="text-orange-500">📌</span><h2 class="text-sm font-semibold">For You</h2></div><div id="for-you-content" class="text-sm text-gray-600 space-y-2"><p class="text-gray-400 text-xs">No pending items. Your agent will pin important tasks, deadlines, and follow-ups here.</p></div></div><div id="notes-list" class="space-y-2"></div></div></div>

<!-- PAGE: MEMORY -->
<div id="page-memory" class="page p-6"><div class="max-w-3xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Memory</h1><p class="text-sm text-gray-500 mt-1">Durable facts, preferences, and instructions</p></div><button class="btn-primary" onclick="saveMemoryItem()">+ Save Memory</button>
<button class="btn-secondary" onclick="refreshMemory()">Refresh</button></div><div class="flex gap-2 mb-4"><input type="text" placeholder="Search memory..." class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08] focus:border-brand-500" oninput="filterMemory(this.value)"><select class="px-3 py-2 text-sm rounded-lg border border-black/[.08]" onchange="filterMemoryType(this.value)"><option value="all">All Types</option><option value="fact">Facts</option><option value="preference">Preferences</option><option value="instruction">Instructions</option><option value="decision">Decisions</option></select></div><div id="memory-list" class="space-y-2"></div></div></div>

<!-- PAGE: AGENTS -->
<div id="page-agents" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Agents</h1><p class="text-sm text-gray-500 mt-1">AI agents that execute tasks autonomously</p></div><button class="btn-primary" onclick="showCreateAgent()">+ New Agent</button></div><div id="agent-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div></div></div>

<!-- PAGE: AGENT TEAMS -->
<div id="page-agentteams" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Agent Teams</h1><p class="text-sm text-gray-500 mt-1">Multi-agent collaboration</p></div><button class="btn-primary" onclick="showCreateTeam()">+ New Team</button></div><div id="team-list" class="space-y-2"></div></div></div>

<!-- PAGE: CHANNELS -->
<div id="page-channels" class="page p-6"><div class="max-w-4xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Channels</h1><p class="text-sm text-gray-500 mt-1">Connect your agent to messaging platforms</p></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-3">
<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:40px;height:40px;background:#25D366;border-radius:10px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2z"/></svg></div><div><h3 class="text-sm font-semibold">WhatsApp</h3><p class="text-xs text-gray-500">Chat and group support</p></div></div><button class="btn-secondary w-full" onclick="connectChannel('whatsapp')">Connect WhatsApp</button></div>
<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:40px;height:40px;background:#0088cc;border-radius:10px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M9.78 18.65l.28-4.23 7.68-6.92c.34-.31-.07-.46-.52-.19L7.74 13.3 3.64 12c-.88-.25-.89-.86.2-1.3l15.97-6.16c.73-.33 1.43.18 1.15 1.3l-2.72 12.81c-.19.91-.74 1.13-1.5.71L12.6 16.3l-1.99 1.93c-.23.23-.42.42-.83.42z"/></svg></div><div><h3 class="text-sm font-semibold">Telegram</h3><p class="text-xs text-gray-500">Bot and channel support</p></div></div><button class="btn-secondary w-full" onclick="connectChannel('telegram')">Connect Telegram</button></div>
<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:40px;height:40px;background:#1d1d1f;border-radius:10px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 5.9 2 10.7c0 2.7 1.5 5.1 3.8 6.7-.2.8-.6 2-1 2.8-.2.5.2.5.4.4 1.2-.5 2.6-1.2 3.2-1.5.8.2 1.7.3 2.6.3 5.5 0 10-3.9 10-8.7S17.5 2 12 2z"/></svg></div><div><h3 class="text-sm font-semibold">iMessage</h3><p class="text-xs text-gray-500">Apple messaging</p></div></div><button class="btn-secondary w-full" onclick="connectChannel('imessage')">Connect iMessage</button></div>
<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:40px;height:40px;background:#4A154B;border-radius:10px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M5.04 15.16a2.52 2.52 0 01-2.52 2.52 2.52 2.52 0 01-2.52-2.52 2.52 2.52 0 012.52-2.52h2.52v2.52zm1.27 0a2.52 2.52 0 015.04 0v6.3a2.52 2.52 0 01-5.04 0v-6.3z"/></svg></div><div><h3 class="text-sm font-semibold">Slack</h3><p class="text-xs text-gray-500">Workspace notifications</p></div></div><button class="btn-secondary w-full" onclick="connectChannel('slack')">Connect Slack</button></div>
<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:40px;height:40px;background:#06C755;border-radius:10px;display:flex;align-items:center;justify-content:center"><span style="color:#fff;font-weight:700;font-size:16px">L</span></div><div><h3 class="text-sm font-semibold">LINE</h3><p class="text-xs text-gray-500">Messaging integration</p></div></div><button class="btn-secondary w-full" onclick="connectChannel('line')">Connect LINE</button></div>
<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:40px;height:40px;background:#007AFF;border-radius:10px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.81.36 1.6.69 2.36a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.72-1.72a2 2 0 012.11-.45c.76.33 1.55.56 2.36.69A2 2 0 0122 16.92z"/></svg></div><div><h3 class="text-sm font-semibold">Phone</h3><p class="text-xs text-gray-500">Voice calls</p></div></div><button class="btn-secondary w-full" onclick="connectChannel('phone')">Connect Phone</button></div>
</div></div></div>

<!-- PAGE: CONNECTORS -->
<div id="page-connectors" class="page p-6"><div class="max-w-4xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Connectors</h1><p class="text-sm text-gray-500 mt-1">OAuth integrations with external services</p></div></div><div class="flex gap-2 mb-4"><button class="mode-tab active" onclick="filterConnectors(event,'all')">All</button><button class="mode-tab" onclick="filterConnectors(event,'user')">Per-User</button><button class="mode-tab" onclick="filterConnectors(event,'workspace')">Workspace</button></div><div id="connectors-list" class="grid grid-cols-1 md:grid-cols-2 gap-3"></div></div></div>

<!-- PAGE: AGENT SETTINGS -->
<div id="page-agentsettings" class="page p-6"><div class="max-w-3xl mx-auto"><h1 class="text-2xl font-bold mb-6">Agent Settings</h1><div class="flex gap-1 mb-4 border-b border-black/[.06]"><button class="px-4 py-2 text-sm font-medium border-b-2 border-brand-500 text-brand-500" onclick="switchAgentSettingsTab(event,'general')">General</button><button class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500" onclick="switchAgentSettingsTab(event,'personalization')">Personalization</button><button class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500" onclick="switchAgentSettingsTab(event,'security')">Security</button><button class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500" onclick="switchAgentSettingsTab(event,'channels')">Channels</button><button class="px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500" onclick="switchAgentSettingsTab(event,'sharing')">Sharing</button></div>
<div id="aset-general" class="space-y-4"><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Model Selection</h3><select id="aset-model" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08]"><option value="auto">Auto Mode — Best model per request</option><option value="nemotron">Nemotron-3-550B (NVIDIA)</option><option value="qwen2.5:14b">Qwen2.5 14B (Local Ollama)</option><option value="qwen2.5:7b">Qwen2.5 7B (Local Ollama)</option><option value="gemini-flash">Gemini Flash (Google)</option><option value="groq">Groq gpt-oss-120b</option><option value="kimi">Kimi moonshot-v1-32k</option></select><p class="text-xs text-gray-500 mt-2">Auto mode selects the best model for each request.</p></div><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Credit Usage</h3><div class="grid grid-cols-3 gap-3"><div class="stat-card"><div class="text-xs text-gray-500">Messages</div><div class="text-lg font-bold" id="credits-messages">374/1093</div></div><div class="stat-card"><div class="text-xs text-gray-500">Integrations</div><div class="text-lg font-bold" id="credits-integrations">1307/122553</div></div><div class="stat-card"><div class="text-xs text-gray-500">Plan</div><div class="text-lg font-bold" id="credits-plan">Builder</div></div></div></div></div>
<div id="aset-personalization" class="space-y-4 hidden"><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Agent Name</h3><input type="text" value="Oryx" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08]"></div><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Custom Instructions</h3><textarea rows="4" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08]" placeholder="Tell your agent how to behave..."></textarea></div><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Language</h3><select class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08]"><option value="en">English</option><option value="ru">Russian</option><option value="es">Spanish</option><option value="zh">Chinese</option></select></div></div>
<div id="aset-security" class="space-y-4 hidden"><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Tool Permissions</h3><div class="space-y-2"><div class="flex items-center justify-between"><span class="text-sm">Code Execution</span><div class="toggle active" onclick="this.classList.toggle('active')"></div></div><div class="flex items-center justify-between"><span class="text-sm">File Operations</span><div class="toggle active" onclick="this.classList.toggle('active')"></div></div><div class="flex items-center justify-between"><span class="text-sm">Web Browsing</span><div class="toggle active" onclick="this.classList.toggle('active')"></div></div><div class="flex items-center justify-between"><span class="text-sm">External API Calls</span><div class="toggle" onclick="this.classList.toggle('active')"></div></div><div class="flex items-center justify-between"><span class="text-sm">Server Management</span><div class="toggle" onclick="this.classList.toggle('active')"></div></div></div></div></div>
<div id="aset-channels" class="space-y-4 hidden"><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Connected Channels</h3><div class="space-y-2"><div class="flex items-center justify-between"><span class="text-sm">WhatsApp</span><span class="badge badge-gray">Not connected</span></div><div class="flex items-center justify-between"><span class="text-sm">Telegram</span><span class="badge badge-gray">Not connected</span></div><div class="flex items-center justify-between"><span class="text-sm">Slack</span><span class="badge badge-gray">Not connected</span></div><div class="flex items-center justify-between"><span class="text-sm">iMessage</span><span class="badge badge-gray">Not connected</span></div><div class="flex items-center justify-between"><span class="text-sm">LINE</span><span class="badge badge-gray">Not connected</span></div></div></div><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Auto-Reply Settings</h3><div class="space-y-2"><div class="flex items-center justify-between"><span class="text-sm">Smart Reply (respond when helpful)</span><div class="toggle active" onclick="this.classList.toggle('active')"></div></div><div class="flex items-center justify-between"><span class="text-sm">Mention-only mode</span><div class="toggle" onclick="this.classList.toggle('active')"></div></div></div></div></div>

<div id="aset-sharing" class="space-y-4 hidden"><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Collaborators</h3><div class="flex gap-2 mb-3"><input type="email" placeholder="Invite by email" class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08]"><button class="btn-primary" onclick="toast('Invitation sent')">Invite</button></div></div><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Share Link</h3><div class="flex gap-2"><input type="text" value="https://evolvixos.com/platform" readonly class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08] bg-black/[.02]"><button class="btn-secondary" onclick="toast('Link copied')">Copy</button></div></div></div>
</div></div>

<!-- PAGE: MODEL ROUTING -->
<div id="page-models" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Model Routing</h1><p class="text-sm text-gray-500 mt-1">Unified API for 300+ models across providers</p></div></div><div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6"><div class="stat-card"><div class="text-xs text-gray-500">Providers</div><div class="text-2xl font-bold" id="model-providers">7</div></div><div class="stat-card"><div class="text-xs text-gray-500">Models</div><div class="text-2xl font-bold" id="model-count">14</div></div><div class="stat-card"><div class="text-xs text-gray-500">Local Models</div><div class="text-2xl font-bold" id="model-local">14</div></div><div class="stat-card"><div class="text-xs text-gray-500">Privacy Mode</div><div class="text-2xl font-bold">HYBRID</div></div></div><div id="providers-list" class="space-y-2"></div></div></div>

<!-- PAGE: RAG ENGINE -->
<div id="page-rag" class="page p-6"><div class="max-w-4xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">RAG Engine</h1><p class="text-sm text-gray-500 mt-1">Local-first retrieval with Ollama + Qdrant</p></div></div><div id="rag-collections" class="space-y-2 mb-4"></div><div class="card p-4"><h3 class="text-sm font-semibold mb-3">Query RAG</h3><div class="flex gap-2"><input type="text" id="rag-query" placeholder="Ask a question..." class="flex-1 px-3 py-2 text-sm rounded-lg border border-black/[.08] focus:border-brand-500"><button class="btn-primary" onclick="queryRAG()">Query</button></div><div id="rag-results" class="mt-3"></div></div></div></div>



<!-- PAGE: MONITOR -->
<div id="page-monitor" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Server Monitor</h1><p class="text-sm text-gray-500 mt-1">System health and active services</p></div><span class="badge badge-green" id="monitor-status">● All systems operational</span></div><div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6"><div class="stat-card"><div class="text-xs text-gray-500">CPU</div><div class="text-2xl font-bold" id="monitor-cpu">--</div></div><div class="stat-card"><div class="text-xs text-gray-500">Memory</div><div class="text-2xl font-bold" id="monitor-mem">--</div></div><div class="stat-card"><div class="text-xs text-gray-500">Disk</div><div class="text-2xl font-bold" id="monitor-disk">--</div></div><div class="stat-card"><div class="text-xs text-gray-500">Load</div><div class="text-2xl font-bold" id="monitor-load">--</div></div></div><div id="services-list" class="space-y-2"></div></div></div>

<!-- PAGE: CODERUNNER -->
<div id="page-coderunner" class="page p-6"><div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">Code Runner</h1>
    <div class="flex gap-2">
      <select id="code-lang" class="px-3 py-1.5 text-sm border rounded-lg bg-white">
        <option value="python">Python</option>
        <option value="bash">Bash</option>
      </select>
      <button class="btn-primary" onclick="runCode()">Run</button>
    </div>
  </div>
  <textarea id="code-input" class="w-full h-64 p-4 font-mono text-sm border rounded-lg" style="background:#1e1e2e;color:#cdd6f4;border:none" >print('Hello EvolvixOS')
import json
print(json.dumps({"status": "ok"}))</textarea>
  <div class="mt-3">
    <div class="text-sm font-medium mb-1">Output:</div>
    <pre id="code-output" class="w-full p-4 font-mono text-sm border rounded-lg overflow-auto" style="background:#1e1e2e;color:#a6e3a1;min-height:100px;max-height:400px"></pre>
  </div>
</div></div>

<div id="page-browser-tool" class="page p-6"><div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">Browser Automation</h1>
  </div>
  <div class="flex gap-2 mb-4">
    <input type="text" id="browser-url" class="flex-1 px-3 py-2 text-sm border rounded-lg" placeholder="https://example.com" value="https://example.com">
    <button class="btn-primary" onclick="browserFetch()">Fetch</button>
    <button class="btn-secondary" onclick="browserExtract()">Extract Text</button>
  </div>
  <div id="browser-result" class="card p-4 min-h-200 overflow-auto" style="min-height:200px;max-height:500px">
    <p class="text-gray-400 text-center">Enter a URL and click Fetch or Extract.</p>
  </div>
</div></div>

<div id="page-fileexplorer" class="page p-6"><div class="max-w-5xl mx-auto">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold">File Explorer</h1>
    <div class="flex gap-2">
      <input type="text" id="grep-pattern" class="px-3 py-1.5 text-sm border rounded-lg" placeholder="grep pattern...">
      <input type="text" id="grep-path" class="px-3 py-1.5 text-sm border rounded-lg w-40" placeholder="/opt/evolvixos" value="/opt/evolvixos">
      <button class="btn-primary" onclick="runGrep()">Search</button>
    </div>
  </div>
  <div class="flex gap-2 mb-2">
    <input type="text" id="file-path" class="flex-1 px-3 py-2 text-sm border rounded-lg" placeholder="/opt/evolvixos/web/platform.html" value="/opt/evolvixos/web">
    <button class="btn-secondary" onclick="listFiles()">List</button>
    <button class="btn-secondary" onclick="readFile()">Read</button>
  </div>
  <div id="file-content" class="card p-4 min-h-200 overflow-auto" style="min-height:200px;max-height:500px">
    <p class="text-gray-400 text-center">Enter a path and click List or Read.</p>
  </div>
</div></div>

<div id="page-logs" class="page p-6"><div class="max-w-5xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Logs</h1><p class="text-sm text-gray-500 mt-1">Real-time platform logs</p></div><button class="btn-secondary" onclick="loadLogs()">Refresh</button></div><div class="terminal" id="logs-terminal"><div class="terminal-line" style="color:#86868b">Loading logs...</div></div></div></div>

<!-- PAGE: TERMINAL -->
<div id="page-terminal" class="page p-6"><div class="max-w-4xl mx-auto"><div class="flex items-center justify-between mb-4"><h1 class="text-2xl font-bold">Terminal</h1><button class="btn-secondary" onclick="clearTerminal()">Clear</button></div><div class="terminal" id="terminal-output" onclick="document.getElementById('terminal-input').focus()"><div class="terminal-line">EvolvixOS Terminal v1.0 — Type 'help' for commands</div><div class="terminal-line">&nbsp;</div></div><div class="flex gap-2 mt-2"><span style="color:#00ff00;font-family:'SF Mono',Menlo,monospace;font-size:13px;padding:4px 0">$</span><input type="text" id="terminal-input" class="flex-1 bg-transparent border-none outline-none text-white" style="font-family:'SF Mono',Menlo,monospace;font-size:13px;color:#00ff00" onkeydown="if(event.key==='Enter')executeTerminal()"></div></div></div>

<!-- PAGE: ANALYTICS -->
<div id="page-analytics" class="page p-6"><div class="max-w-6xl mx-auto"><h1 class="text-2xl font-bold mb-6">Analytics</h1><div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6"><div class="stat-card"><div class="text-xs text-gray-500">Entities</div><div class="text-2xl font-bold" id="analytics-entities">--</div></div><div class="stat-card"><div class="text-xs text-gray-500">Total Records</div><div class="text-2xl font-bold" id="analytics-records">--</div></div><div class="stat-card"><div class="text-xs text-gray-500">Functions</div><div class="text-2xl font-bold" id="analytics-functions">--</div></div><div class="stat-card"><div class="text-xs text-gray-500">Workflows</div><div class="text-2xl font-bold" id="analytics-workflows">--</div></div></div><div class="card p-4 mb-4"><h3 class="text-sm font-semibold mb-3">Entity Records Distribution</h3><canvas id="analytics-chart" height="200"></canvas></div></div></div>

<!-- PAGE: API KEYS -->
<div id="page-apikeys" class="page p-6"><div class="max-w-3xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">API Keys</h1><p class="text-sm text-gray-500 mt-1">External API access</p></div><button class="btn-primary" onclick="createApiKey()">+ New Key</button></div><div id="apikeys-list" class="space-y-2"></div></div></div>

<!-- PAGE: VERSIONS -->
<div id="page-versions" class="page p-6"><div class="max-w-3xl mx-auto"><div class="flex items-center justify-between mb-6"><div><h1 class="text-2xl font-bold">Version History</h1><p class="text-sm text-gray-500 mt-1">Restore and publish previous versions</p></div></div><div id="versions-list" class="space-y-2"></div></div></div><div class="stat-card"><div class="text-xs text-gray-500">Messages</div><div class="text-lg font-bold">374/1093</div></div><div class="stat-card"><div class="text-xs text-gray-500">Integrations</div><div class="text-lg font-bold">1307/122553</div></div></div><div class="text-center text-gray-400 py-8"></div></div></div>

    </div>
  </div>
</div>

<div class="bottom-nav"><div class="bottom-nav-item active" data-page="chat" onclick="showPage('chat')"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 10h8M8 14h5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span>Workbench</span></div><div class="bottom-nav-item" data-page="builder" onclick="showPage('builder')"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span>Builder</span></div><div class="bottom-nav-item" data-page="entities" onclick="showPage('entities')"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg><span>Entities</span></div><div class="bottom-nav-item" data-page="agents" onclick="showPage('agents')"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="8" width="16" height="12" rx="3"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg><span>Agents</span></div><div class="bottom-nav-item" data-page="monitor" onclick="showPage('monitor')"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M7 10l2 2 4-4"/></svg><span>System</span></div></div>

<script>
// ═══ GLOBAL STATE ═══
var chatMode='default',builderMode='default',messageQueue=[],isProcessing=false;
var API='https://evolvixos.com/platform/api';var PLATFORM='https://evolvixos.com/platform';var AUTH='https://evolvixos.com/auth/api';
var TOKEN='';
var loadedPages={};

// ═══ INIT (user only - rest deferred to end) ═══
(function initUser(){
  var raw=localStorage.getItem('evolvixos_user');
  if(raw){try{var u=JSON.parse(raw);TOKEN=u.token||'';}catch(e){}
    // Also check URL hash for token (for testing/automation)
    var hashMatch=window.location.hash.match(/token=([^&]+)/);
    if(hashMatch){TOKEN=decodeURIComponent(hashMatch[1]);
      localStorage.setItem('evolvixos_user',JSON.stringify({token:TOKEN,display_name:'Admin',email:'admin@evolvixos.com',user_id:1}));
    }
  }
  // Also check URL hash without localStorage
  if(!TOKEN){
    var hashMatch2=window.location.hash.match(/token=([^&]+)/);
    if(hashMatch2){TOKEN=decodeURIComponent(hashMatch2[1]);
      localStorage.setItem('evolvixos_user',JSON.stringify({token:TOKEN,display_name:'Admin',email:'admin@evolvixos.com',user_id:1}));
    }
  }
  // Auth guard — redirect to login if no token (but allow hash token)
  if(!TOKEN){
    window.location.href='/login';
    return;
  }
  // Refresh user info from server (non-blocking — don't redirect on failure)
  fetch(AUTH+'/me',{headers:{'Authorization':'Bearer '+TOKEN}})
    .then(function(r){return r.json();})
    .then(function(data){
      if(data.error||!data.user){
        // Don't redirect — token might still work for platform API
        return;
      }
      var u=data.user;
      var name=u.display_name||u.email||'User';
      var email=u.email||'';
      document.getElementById('user-name').textContent=name;
      document.getElementById('user-email').textContent=email;
      document.getElementById('user-avatar').textContent=name.charAt(0).toUpperCase();
      // Update localStorage with fresh data
      localStorage.setItem('evolvixos_user',JSON.stringify({token:TOKEN,display_name:name,email:email,user_id:u.id}));
    })
    .catch(function(){
      // If /auth/me fails, keep using the token we have
      if(raw){try{var u=JSON.parse(raw);document.getElementById('user-name').textContent=u.display_name||u.email||'User';document.getElementById('user-email').textContent=u.email||'';document.getElementById('user-avatar').textContent=(u.display_name||u.email||'U').charAt(0).toUpperCase();}catch(e){}}
    });
})();

// ═══ API HELPER ═══
function api(path,opts){
  opts=opts||{};
  opts.headers=opts.headers||{};
  if(TOKEN)opts.headers['Authorization']='Bearer '+TOKEN;
  if(opts.body&&!opts.headers['Content-Type'])opts.headers['Content-Type']='application/json';
  return fetch(API+path,opts).then(function(r){
    if(r.status===401){if(window.location.hash.includes("token=")){return Promise.reject(new Error("Auth failed (401)"));}
      localStorage.removeItem('evolvixos_user');
      window.location.href='/login';
      return Promise.reject(new Error('Unauthorized'));
    }
    return r.json().catch(function(){return{error:'Invalid response'};});
  });
}

// ═══ PAGE SWITCHING ═══
window.showPage=function(page){
  document.querySelectorAll('.page').forEach(function(p){p.classList.remove('active');});
  var t=document.getElementById('page-'+page);if(t)t.classList.add('active');
  document.querySelectorAll('.nav-item').forEach(function(n){n.classList.remove('active');n.classList.add('text-gray-600');n.classList.remove('text-gray-900');});
  var an=document.querySelector('.nav-item[data-page="'+page+'"]');if(an)an.classList.add('active');
  var labels={chat:'Workbench',builder:'Builder',entities:'Entities',functions:'Functions',workflows:'Workflows',templates:'Templates',storage:'Files',notes:'Notes',memory:'Memory',agents:'Agents',agentteams:'Agent Teams',channels:'Channels',connectors:'Connectors',agentsettings:'Agent Settings',models:'Model Routing',rag:'RAG Engine',monitor:'Server Monitor',logs:'Logs',terminal:'Terminal',analytics:'Analytics',apikeys:'API Keys',versions:'Version History'};
  document.getElementById('breadcrumb').textContent=labels[page]||page;
  var sb=document.getElementById('sidebar');if(sb)sb.classList.remove('open');
  document.getElementById('mobile-overlay').style.display='none';
  // Lazy load
  if(page==='entities'){loadEntities();}
  if(page==='functions'){loadFunctions();}
  if(page==='workflows'){loadWorkflows();}
  if(page==='templates'){loadTemplates();}
  if(page==='models'){loadModels();}
  if(page==='monitor'){loadMonitor();}
  if(page==='logs'){loadLogs();}
  if(page==='analytics'){loadAnalytics();}
  if(page==='connectors'){loadConnectors();}
  if(page==='rag'){loadRAGCollections();}
  if(page==='versions'){renderVersions();}if(page==='skills'){loadSkills();}
  
  if(page==='agents'){loadAgents();}
  if(page==='agentteams'){loadTeams();}
  if(page==='notes'){loadNotes();}
  if(page==='files'){loadFiles();}
  if(page==='memory'){loadMemoryData();}
  if(page==='apikeys'){loadApiKeys();}
};
function toggleSidebar(){var sb=document.getElementById('sidebar');sb.classList.toggle('open');document.getElementById('mobile-overlay').style.display=sb.classList.contains('open')?'block':'none';}

// ═══ CHAT ═══
function setChatMode(mode){chatMode=mode;document.querySelectorAll('[data-mode]').forEach(function(b){b.classList.toggle('active',b.dataset.mode===mode);});document.getElementById('mode-indicator').textContent=mode.charAt(0).toUpperCase()+mode.slice(1)+' mode';document.getElementById('chat-input').placeholder={default:'Ask me to build something...',discuss:'Let\'s discuss ideas (no changes made)...',edit:'Describe visual edits...'}[mode]||'Ask me...';toast('Mode: '+mode);}
function handleChatKeydown(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();sendChatMessage();}if((e.metaKey||e.ctrlKey)&&e.key==='.'){e.preventDefault();var m=['default','discuss','edit'];setChatMode(m[(m.indexOf(chatMode)+1)%3]);}}
function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,128)+'px';}
function sendChatMessage(){
  var input=document.getElementById('chat-input');var text=input.value.trim();if(!text)return;
  if(isProcessing){if(messageQueue.length>=7){toast('Queue full (max 7)','error');return;}messageQueue.push(text);input.value='';autoResize(input);renderQueue();return;}
  addChatMessage('user',text);input.value='';autoResize(input);
  isProcessing=true;showSubAgent('Processing...');
  var modelSel=document.getElementById('chat-model-select');
  var modelVal=modelSel?modelSel.value:'auto';
  api('/chat',{method:'POST',body:JSON.stringify({message:text,mode:chatMode,model:modelVal})})
    .then(function(data){
      isProcessing=false;hideSubAgent();
      // Build rich response from structured action
      var msg=data.message||data.response||'Done.';
      var action=data.action||'chat';
      var extraHtml='';

      // Show what was created
      if(action==='create_entity'&&data.result){
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(0,122,255,.06)"><p class="text-xs font-medium text-brand-600">📦 New Entity Created</p><p class="text-xs text-gray-600 mt-1">Fields: '+escapeHtml(Object.keys(data.result.schema&&data.result.schema.properties||{}).join(', '))+'</p></div>';
        loadEntities();
      }
      if(action==='create_entities'&&data.created){
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(0,122,255,.06)"><p class="text-xs font-medium text-brand-600">📦 '+data.created.length+' Entities Created</p>';
        data.created.forEach(function(e){extraHtml+='<p class="text-xs text-gray-600 mt-1">• '+escapeHtml(e.name)+': '+escapeHtml(e.fields)+'</p>';});
        if(data.skipped&&data.skipped.length)extraHtml+='<p class="text-xs text-gray-400 mt-1">Skipped (exist): '+escapeHtml(data.skipped.join(', '))+'</p>';
        extraHtml+='</div>';
        loadEntities();
      }
      if(action==='create_function'){
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(88,86,214,.06)"><p class="text-xs font-medium text-indigo-600">⚡ Function Deployed</p><p class="text-xs text-gray-600 mt-1">Endpoint: '+escapeHtml(data.url||'/api/fn/'+data.name)+'</p></div>';
        loadFunctions();
      }
      if(action==='create_workflow'){
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(88,86,214,.06)"><p class="text-xs font-medium text-indigo-600">🔄 Workflow Created</p><p class="text-xs text-gray-600 mt-1">Name: '+escapeHtml(data.name)+'</p></div>';
        loadWorkflows();
      }
      if(action==='list_entities'&&data.entities){
        var names=data.entities.map(function(e){return e.name||e.entity_name;}).join(', ')||'none';
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(0,122,255,.06)"><p class="text-xs font-medium text-brand-600">📋 Current Entities</p><p class="text-xs text-gray-600 mt-1">'+escapeHtml(names)+'</p></div>';
      }
      if(action==='plugin'){
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(0,122,255,.06)"><p class="text-xs font-medium text-brand-600">🔌 Plugin: '+escapeHtml(data.plugin||'')+'</p></div>';
      }
      if(data.error){
        extraHtml+='<div class="mt-2 p-2 rounded-lg" style="background:rgba(255,59,48,.06)"><p class="text-xs text-red-500">'+escapeHtml(data.error)+'</p></div>';
      }

      addChatMessageRich('agent',msg,extraHtml);

      // Show model info
      if(data.used_model){
        var info=document.getElementById('subagent-panel');
        if(info){info.classList.remove('hidden');info.querySelector('#subagent-status').textContent='Model: '+data.used_model+(data.used_provider?' via '+data.used_provider:'');setTimeout(function(){hideSubAgent();},3000);}
      }

      if(data.file)addFilePreview(data.file);
      if(data.suggestions)renderChatSuggestions(data.suggestions);
      else renderChatSuggestions(getContextualSuggestions(text,action));

      // Process queue
      if(messageQueue.length>0){var n=messageQueue.shift();document.getElementById('chat-input').value=n;renderQueue();sendChatMessage();}
    })
    .catch(function(err){
      isProcessing=false;hideSubAgent();
      addChatMessage('agent','⚠️ '+escapeHtml(err.message||'Request failed')+'. The LLM backend may be starting up — try again in a moment.');
    });
}

function addChatMessageRich(role,text,extraHtml){
  var msgs=document.getElementById('chat-messages');
  var u=role==='user';
  var b=document.createElement('div');
  b.className='chat-bubble max-w-2xl mx-auto mb-4';
  b.innerHTML='<div class="flex gap-3 '+(u?'flex-row-reverse':'')+'"><div style="width:32px;height:32px;background:'+(u?'#5856D6':'linear-gradient(135deg,#007AFF,#5856D6)')+';border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px">'+(u?'U':'E')+'</div><div class="flex-1"><div class="card p-3"><p class="text-sm text-gray-700">'+escapeHtml(text)+'</p>'+(extraHtml||'')+'</div></div></div>';
  msgs.appendChild(b);
  msgs.scrollTop=msgs.scrollHeight;
}

function getContextualSuggestions(userMsg,action){
  var s=[];
  var lower=userMsg.toLowerCase();
  if(action==='create_entity'||action==='create_entities'){s=['Add sample data','Create a function to query this','Build a workflow around this'];}
  else if(action==='create_function'){s=['Test this function','Create an entity for it','Deploy as an API endpoint'];}
  else if(lower.indexOf('blog')>=0){s=['Add comments to posts','Create an author entity','Add a newsletter signup'];}
  else if(lower.indexOf('store')>=0||lower.indexOf('shop')>=0){s=['Add a shopping cart entity','Create an order workflow','Add product categories'];}
  else if(lower.indexOf('crm')>=0){s=['Add a dashboard view','Create a follow-up workflow','Add deal stages'];}
  else if(action==='chat'){s=['Create a blog app','Build a task manager','Make a CRM with contacts and deals'];}
  else{s=['Create a blog app','Build a task manager','Make a store with products'];}
  return s;
}
function addChatMessage(role,text){var msgs=document.getElementById('chat-messages');var u=role==='user';var b=document.createElement('div');b.className='chat-bubble max-w-2xl mx-auto mb-4';b.innerHTML='<div class="flex gap-3 '+(u?'flex-row-reverse':'')+'"><div style="width:32px;height:32px;background:'+(u?'#5856D6':'linear-gradient(135deg,#007AFF,#5856D6)')+';border-radius:8px;flex-shrink:0;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:14px">'+(u?'U':'E')+'</div><div class="flex-1"><div class="card p-3"><p class="text-sm text-gray-700">'+escapeHtml(text)+'</p></div></div></div>';msgs.appendChild(b);msgs.scrollTop=msgs.scrollHeight;}
function insertSuggestion(t){document.getElementById('chat-input').value=t;document.getElementById('chat-input').focus();autoResize(document.getElementById('chat-input'));}
function renderChatSuggestions(sugs){var c=document.getElementById('chat-suggestions');if(!c)return;c.innerHTML='<span class="text-[10px] text-gray-400">Quick start:</span>';sugs.forEach(function(s){c.innerHTML+='<button class="chat-suggestion text-[10px] px-2 py-0.5 rounded border border-black/[.06] text-gray-500" onclick="insertSuggestion(\''+s.replace(/'/g,"\\'")+'\')">'+s+'</button>';});}
function renderQueue(){var q=document.getElementById('chat-queue'),l=document.getElementById('queue-list');document.getElementById('queue-count').textContent=messageQueue.length;if(!messageQueue.length){q.classList.add('hidden');return;}q.classList.remove('hidden');l.innerHTML=messageQueue.map(function(m,i){return '<div class="queue-item flex items-center gap-2 bg-black/[.03] rounded-lg p-2"><span class="text-xs text-gray-400">'+(i+1)+'</span><span class="text-xs text-gray-600 flex-1 truncate">'+escapeHtml(m)+'</span><button class="text-xs text-gray-400 hover:text-red-500" onclick="removeFromQueue('+i+')">✕</button></div>';}).join('');}
function removeFromQueue(i){messageQueue.splice(i,1);renderQueue();}
function clearQueue(){messageQueue=[];renderQueue();}
function clearChat(){document.getElementById('chat-messages').innerHTML='';addChatMessage('agent','Chat cleared. What would you like to do?');}
function showSubAgent(s){document.getElementById('subagent-panel').classList.remove('hidden');document.getElementById('subagent-status').textContent=s||'Working...';}
function hideSubAgent(){document.getElementById('subagent-panel').classList.add('hidden');}
function addFilePreview(f){var msgs=document.getElementById('chat-messages');var c=document.createElement('div');c.className='chat-bubble max-w-2xl mx-auto mb-4';if(f.type==='image'||(f.url&&f.url.match(/\.(png|jpg|jpeg|gif|svg)$/))){c.innerHTML='<div class="card p-2 inline-block"><img src="'+f.url+'" style="max-width:300px;border-radius:8px"><p class="text-xs text-gray-500 mt-1">'+(f.name||'image')+'</p></div>';}else{c.innerHTML='<div class="card p-3 flex items-center gap-3"><div style="width:40px;height:40px;background:rgba(0,122,255,.1);border-radius:8px;display:flex;align-items:center;justify-content:center"><svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/></svg></div><div class="flex-1"><p class="text-sm font-medium">'+(f.name||'file')+'</p></div><button class="text-xs text-brand-500" onclick="window.open(\''+(f.url||'#')+'\')">Preview</button></div>';}msgs.appendChild(c);msgs.scrollTop=msgs.scrollHeight;}
function handleFileUpload(input){for(var i=0;i<input.files.length;i++){var file=input.files[i];var isImg=file.type.startsWith('image/');var isPdf=file.type==='application/pdf';var icon=isImg?'🖼️':isPdf?'📄':'📎';var size=Math.round(file.size/1024);var sizeStr=size>1024?(size/1024).toFixed(1)+'MB':size+'KB';addFilePreview({name:file.name,size:sizeStr,type:isImg?'image':'file',icon:icon,url:isImg?URL.createObjectURL(file):null});}input.value='';}

// ═══ BUILDER ═══
function setBuilderMode(m){builderMode=m;document.querySelectorAll('[data-bmode]').forEach(function(b){b.classList.toggle('active',b.dataset.bmode===m);});document.getElementById('edit-mode-panel').classList.toggle('hidden',m!=='edit');if(m==='edit'){setTimeout(initEditPreview,100);}toast('Builder: '+m);}
function sendBuilderMessage(){var i=document.getElementById('builder-input');var t=i.value.trim();if(!t)return;var c=document.getElementById('builder-chat');var ph=c.querySelector('.text-center');if(ph)ph.remove();c.innerHTML+='<div class="flex justify-end"><div class="bg-brand-500 text-white rounded-lg px-3 py-2 text-sm max-w-md">'+escapeHtml(t)+'</div></div>';i.value='';var loadingText=builderMode==='discuss'?'Thinking...':builderMode==='edit'?'Editing...':'Building...';c.innerHTML+='<div id="builder-loading" class="flex justify-start"><div class="card p-3 text-sm max-w-md"><div class="spinner mr-2"></div>'+loadingText+'</div></div>';
  api('/chat',{method:'POST',body:JSON.stringify({message:t,mode:builderMode,model:document.getElementById('chat-model-select').value})})
    .then(function(data){var l=document.getElementById('builder-loading');if(l)l.remove();var msg=data.response||data.message||'Done.';var action=data.action||'chat';var html='<div class="flex justify-start"><div class="card p-3 text-sm max-w-md"><p class="text-sm text-gray-700">'+escapeHtml(msg)+'</p>';
      if(data.entities&&data.entities.length){
        html+='<div class="mt-3 p-3 rounded-lg bg-brand-50 border border-brand-100"><div class="flex items-center gap-2 mb-2"><svg class="w-4 h-4 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="text-xs font-semibold text-brand-700">'+data.entities.length+' Entit'+(data.entities.length>1?'ies':'y')+' Created</span></div>';
        data.entities.forEach(function(e){html+='<div class="text-xs text-gray-600 mb-1">\u2022 <span class="font-medium">'+escapeHtml(e.name||e)+'</span>'+(e.fields?' <span class="text-gray-400">'+escapeHtml(e.fields.join(', '))+'</span>':'')+'</div>';});
        html+='</div>';
      }
      if(data.entity)html+='<div class="mt-2 text-xs text-brand-600">\u2713 Created entity: '+escapeHtml(data.entity)+'</div>';
      if(data.function)html+='<div class="mt-1 text-xs text-brand-600">\u2713 Deployed function: '+escapeHtml(data.function)+'</div>';
      if(data.workflow)html+='<div class="mt-1 text-xs text-brand-600">\u2713 Created workflow: '+escapeHtml(data.workflow)+'</div>';
      if(data.action==='create_entity'||data.entity||data.entities){
        html+='<div id="auto-check" class="mt-2 flex items-center gap-2 text-xs text-gray-400"><div class="spinner" style="width:10px;height:10px;border-width:1.5px"></div>Validating schema...</div>';
        setTimeout(function(){var ck=document.getElementById('auto-check');if(ck)ck.innerHTML='<span class="text-green-600">\u2713 Schema valid</span> <span class="text-gray-400">\u00b7</span> <span class="text-gray-400">No errors detected</span>';},1200);
      }
      if(builderMode==='discuss'){html+='<div class="mt-2 text-xs text-gray-400 italic">Discussion mode \u2014 no changes made to your app.</div>';}
      if(data.suggestions&&data.suggestions.length){
        html+='<div class="mt-2 flex gap-1 flex-wrap">';
        data.suggestions.forEach(function(s){html+='<button class="text-[10px] px-2 py-0.5 rounded border border-brand-100 text-brand-600 hover:bg-brand-50" onclick="document.getElementById(\x27builder-input\x27).value=\x27'+s.replace(/'/g,'\\\x27')+'\x27;sendBuilderMessage();">'+escapeHtml(s)+'</button>';});
        html+='</div>';
      }
      html+='</div></div>';c.innerHTML+=html;c.scrollTop=c.scrollHeight;if(builderMode!=='discuss'){loadEntities();loadFunctions();loadWorkflows();}})
    .catch(function(err){var l=document.getElementById('builder-loading');if(l)l.remove();c.innerHTML+='<div class="flex justify-start"><div class="card p-3 text-sm max-w-md"><p class="text-sm text-red-500">Error: '+escapeHtml(err.message)+'</p></div></div>';c.scrollTop=c.scrollHeight;});}
var canvasPages=[
  {name:'Dashboard',icon:'📊',elements:8,components:['header','stat-card','stat-card','stat-card','chart','table'],bg:'#f5f5f7'},
  {name:'Settings',icon:'⚙️',elements:3,components:['header','form','toggle'],bg:'#ffffff'},
  {name:'Profile',icon:'👤',elements:4,components:['header','avatar','info-card','button'],bg:'#f5f5f7'},
  {name:'Items',icon:'📋',elements:6,components:['header','search','table','pagination','button','button'],bg:'#ffffff'}
];
var currentPageIdx=null;
function renderCanvas(){var g=document.getElementById('canvas-grid');if(!g)return;g.innerHTML=canvasPages.map(function(p,i){return '<div class="canvas-page-card rounded-lg p-3 cursor-pointer hover:border-brand-500 transition-all" onclick="openCanvasPage('+i+')"><div class="flex items-center justify-between mb-2"><span class="text-sm font-medium">'+p.name+'</span><span class="text-lg">'+p.icon+'</span></div><div class="space-y-1">'+(p.components||[]).map(function(c,j){return '<div class="skeleton h-2 rounded" style="width:'+(j%2===0?'100%':'70%')+'"></div>';}).join('')+'</div><div class="flex items-center justify-between mt-2"><p class="text-[10px] text-gray-400">'+p.elements+' elements</p><div class="flex gap-1"><button class="text-[10px] text-gray-400 hover:text-brand-500" onclick="event.stopPropagation();duplicatePage('+i+')" title="Duplicate"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M4 16V4h12"/></svg></button><button class="text-[10px] text-gray-400 hover:text-red-500" onclick="event.stopPropagation();deletePage('+i+')" title="Delete"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M19 6l-2 14H7L5 6"/></svg></button></div></div></div>';}).join('')+'<div class="canvas-page-card rounded-lg p-3 flex items-center justify-center min-h-[100px] text-gray-400 cursor-pointer hover:border-brand-500" onclick="addCanvasPage()"><div class="text-center"><span class="text-2xl">+</span><p class="text-xs mt-1">Add Page</p></div></div>';}
function addCanvasPage(){
  // Show inline modal instead of prompt
  var modal='<div id="new-page-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/30" onclick="if(event.target===this)this.remove()"><div class="card p-6 w-96"><h3 class="text-sm font-semibold mb-4">New Page</h3><input type="text" id="new-page-name" placeholder="Page name (e.g. Products)" class="w-full px-3 py-2 text-sm rounded-lg border border-black/[.08] mb-3 focus:border-brand-500" onkeydown="if(event.key===\'Enter\')confirmNewPage()"><div class="flex gap-2 mb-3" id="page-icon-picker">'+['📊','⚙️','👤','📋','🛒','📅','📈','💬','🏠','🔑','📁','🎯'].map(function(ic){return '<button class="text-xl p-1 rounded hover:bg-gray-100" onclick="document.querySelectorAll(\'#page-icon-picker button\').forEach(function(b){b.classList.remove(\'bg-brand-50\',\'text-brand-600\')});this.classList.add(\'bg-brand-50\',\'text-brand-600\');window._selectedIcon=\''+ic+'\'" >'+ic+'</button>';}).join('')+'</div><div class="flex gap-2"><button class="btn-primary flex-1" onclick="confirmNewPage()">Create Page</button><button class="btn-secondary" onclick="document.getElementById(\'new-page-modal\').remove()">Cancel</button></div></div></div>';
  document.body.insertAdjacentHTML('beforeend',modal);
  document.getElementById('new-page-name').focus();
  window._selectedIcon='📄';
}
function confirmNewPage(){
  var n=document.getElementById('new-page-name').value.trim();
  if(!n){return;}
  var ic=window._selectedIcon||'📄';
  canvasPages.push({name:n,icon:ic,elements:0,components:[],bg:'#f5f5f7'});
  document.getElementById('new-page-modal').remove();
  renderCanvas();
  toast('Page added: '+n);
}
function openCanvasPage(i){
  currentPageIdx=i;
  var p=canvasPages[i];
  // Build page editor overlay
  var overlay='<div id="page-editor" class="fixed inset-0 z-50 flex bg-white" style="animation:fadeIn .2s ease">'+
    '<div class="w-64 bg-gray-50 border-r border-black/[.06] p-4 flex flex-col">'+
      '<div class="flex items-center justify-between mb-4"><h3 class="text-sm font-semibold">'+p.icon+' '+p.name+'</h3><button class="text-gray-400 hover:text-gray-600" onclick="closePageEditor()"><svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"/></svg></button></div>'+
      '<div class="text-[10px] font-semibold text-gray-500 mb-2">COMPONENTS ('+(p.components||[]).length+')</div>'+
      '<div class="flex-1 overflow-y-auto space-y-1 mb-3" id="page-components-list">'+
        (p.components||[]).map(function(c,j){return '<div class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-100 cursor-pointer" onclick="selectPageComponent('+j+')"><span class="text-xs text-gray-600">'+c+'</span><button class="ml-auto text-gray-300 hover:text-red-500" onclick="event.stopPropagation();removePageComponent('+j+')"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2"/></svg></button></div>';}).join('')+
      '</div>'+
      '<div class="text-[10px] font-semibold text-gray-500 mb-2">ADD COMPONENT</div>'+
      '<div class="grid grid-cols-2 gap-1 mb-3">'+['header','stat-card','chart','table','form','button','avatar','search','toggle','tabs','modal','sidebar'].map(function(c){return '<button class="text-[10px] px-2 py-1.5 rounded border border-black/[.06] hover:border-brand-500 hover:text-brand-500" onclick="addPageComponent(\''+c+'\')">'+c+'</button>';}).join('')+'</div>'+
      '<div class="text-[10px] font-semibold text-gray-500 mb-2">FIGMA IMPORT</div>'+
      '<input type="text" id="figma-url" placeholder="Paste Figma URL..." class="w-full px-2 py-1.5 text-xs rounded border border-black/[.06] mb-1 focus:border-brand-500">'+
      '<button class="btn-secondary text-xs w-full" onclick="importFigma()">Import from Figma</button>'+
    '</div>'+
    '<div class="flex-1 flex flex-col">'+
      '<div class="h-12 border-b border-black/[.06] flex items-center px-4 gap-3">'+
        '<span class="text-xs text-gray-500">Editing: <span class="font-medium text-gray-900">'+p.name+'</span></span>'+
        '<span class="text-[10px] text-gray-400">'+(p.elements||0)+' elements</span>'+
        '<div class="flex gap-1 ml-auto">'+
          '<button class="text-[10px] px-2 py-1 rounded hover:bg-gray-100" onclick="togglePreviewDevice(\'desktop\')" id="device-desktop">Desktop</button>'+
          '<button class="text-[10px] px-2 py-1 rounded hover:bg-gray-100" onclick="togglePreviewDevice(\'tablet\')" id="device-tablet">Tablet</button>'+
          '<button class="text-[10px] px-2 py-1 rounded hover:bg-gray-100" onclick="togglePreviewDevice(\'mobile\')" id="device-mobile">Mobile</button>'+
        '</div>'+
        '<button class="btn-primary text-xs" onclick="savePageChanges()">Save</button>'+
      '</div>'+
      '<div class="flex-1 overflow-auto p-6" style="background:'+(p.bg||'#f5f5f7')+'">'+
        '<div id="page-preview-frame" class="mx-auto bg-white rounded-xl shadow-lg transition-all" style="width:100%;min-height:500px;padding:24px">'+
          renderPagePreview(p)+
        '</div>'+
      '</div>'+
    '</div>'+
  '</div>';
  document.body.insertAdjacentHTML('beforeend',overlay);
  toast('Editing: '+p.name);
}
function renderPagePreview(p){
  var html='';
  (p.components||[]).forEach(function(c){
    if(c==='header')html+='<div style="font-size:24px;font-weight:700;margin-bottom:16px;color:#1a1a1a">'+p.name+'</div>';
    else if(c==='stat-card')html+='<div style="display:inline-block;width:30%;margin-right:3%;padding:16px;background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.08);margin-bottom:12px"><div style="font-size:11px;color:#888">Metric</div><div style="font-size:24px;font-weight:700;margin-top:4px">1,234</div></div>';
    else if(c==='chart')html+='<div style="height:200px;background:linear-gradient(180deg,#e0e7ff,#c7d2fe);border-radius:12px;margin-bottom:12px;display:flex;align-items:flex-end;padding:16px"><div style="display:flex;gap:4px;width:100%;height:100%;align-items:flex-end">'+Array.from({length:7},function(_,i){return '<div style="flex:1;height:'+Math.floor(30+Math.random()*70)+'%;background:#007AFF;border-radius:4px 4px 0 0"></div>';}).join('')+'</div></div>';
    else if(c==='table')html+='<div style="margin-bottom:12px"><div style="display:flex;border-bottom:1px solid #eee;padding:8px;font-size:11px;font-weight:600;color:#666">'+['Name','Status','Date'].map(function(h){return '<div style="flex:1">'+h+'</div>';}).join('')+'</div>'+Array.from({length:3},function(_,i){return '<div style="display:flex;border-bottom:1px solid #f5f5f5;padding:8px;font-size:12px;color:#333">'+['Item '+(i+1),'Active','Aug 31'].map(function(h){return '<div style="flex:1">'+h+'</div>';}).join('')+'</div>';}).join('')+'</div>';
    else if(c==='form')html+='<div style="margin-bottom:12px">'+['Name','Email'].map(function(f){return '<div style="margin-bottom:8px"><label style="font-size:11px;color:#666;display:block;margin-bottom:4px">'+f+'</label><div style="height:36px;border:1px solid #ddd;border-radius:8px"></div></div>';}).join('')+'<div style="height:36px;background:#007AFF;color:#fff;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px">Save</div></div>';
    else if(c==='button')html+='<div style="display:inline-block;padding:8px 20px;background:#007AFF;color:#fff;border-radius:8px;font-size:13px;margin-right:8px;margin-bottom:8px;cursor:pointer">Click Me</div>';
    else if(c==='avatar')html+='<div style="display:flex;align-items:center;gap:12px;margin-bottom:12px"><div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#007AFF,#5856D6)"></div><div><div style="font-weight:600;font-size:14px">John Doe</div><div style="font-size:12px;color:#888">john@example.com</div></div></div>';
    else if(c==='search')html+='<div style="height:36px;border:1px solid #ddd;border-radius:8px;margin-bottom:12px;display:flex;align-items:center;padding:0 12px;font-size:12px;color:#999">Search...</div>';
    else if(c==='toggle')html+='<div style="display:flex;align-items:center;justify-content:space-between;padding:12px;background:#fff;border-radius:8px;margin-bottom:8px"><span style="font-size:13px">Enable feature</span><div style="width:40px;height:22px;background:#007AFF;border-radius:11px;position:relative"><div style="width:18px;height:18px;background:#fff;border-radius:50%;position:absolute;right:2px;top:2px"></div></div></div>';
    else if(c==='tabs')html+='<div style="display:flex;gap:4px;border-bottom:1px solid #eee;margin-bottom:12px">'+['Tab 1','Tab 2','Tab 3'].map(function(t,i){return '<div style="padding:8px 16px;font-size:12px;'+(i===0?'border-bottom:2px solid #007AFF;color:#007AFF;font-weight:600':'color:#666')+'">'+t+'</div>';}).join('')+'</div>';
    else if(c==='modal')html+='<div style="background:#fff;border-radius:12px;box-shadow:0 8px 32px rgba(0,0,0,.15);padding:20px;margin-bottom:12px;border:1px solid #eee"><div style="font-weight:600;margin-bottom:8px">Modal Title</div><div style="font-size:12px;color:#888;margin-bottom:12px">Modal content goes here.</div><div style="display:flex;gap:8px;justify-content:flex-end"><div style="padding:6px 16px;border:1px solid #ddd;border-radius:8px;font-size:12px">Cancel</div><div style="padding:6px 16px;background:#007AFF;color:#fff;border-radius:8px;font-size:12px">OK</div></div></div>';
    else if(c==='sidebar')html='<div style="width:120px;display:inline-block;vertical-align:top;margin-right:16px"><div style="padding:8px 12px;font-size:12px;color:#007AFF;font-weight:600;margin-bottom:4px">Dashboard</div>'+['Analytics','Settings','Users'].map(function(s){return '<div style="padding:8px 12px;font-size:12px;color:#666;margin-bottom:4px">'+s+'</div>';}).join('')+'</div>';
    else html+='<div style="padding:12px;background:#f0f0f0;border-radius:8px;margin-bottom:8px;font-size:12px;color:#666">'+c+'</div>';
  });
  return html||'<div style="text-align:center;padding:40px;color:#999;font-size:13px">No components yet. Add some from the left panel.</div>';
}
function addPageComponent(c){
  if(currentPageIdx===null)return;
  canvasPages[currentPageIdx].components=canvasPages[currentPageIdx].components||[];
  canvasPages[currentPageIdx].components.push(c);
  canvasPages[currentPageIdx].elements=canvasPages[currentPageIdx].components.length;
  // Update preview without closing
  var frame=document.getElementById('page-preview-frame');
  if(frame)frame.innerHTML=renderPagePreview(canvasPages[currentPageIdx]);
  // Update component list
  var list=document.getElementById('page-components-list');
  if(list){
    list.innerHTML=canvasPages[currentPageIdx].components.map(function(c,j){
      return '<div class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-100 cursor-pointer" onclick="selectPageComponent('+j+')"><span class="text-xs text-gray-600">'+c+'</span><button class="ml-auto text-gray-300 hover:text-red-500" onclick="event.stopPropagation();removePageComponent('+j+')"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2"/></svg></button></div>';
    }).join('');
  }
  toast('Added '+c);
}
function removePageComponent(j){
  if(currentPageIdx===null)return;
  canvasPages[currentPageIdx].components.splice(j,1);
  canvasPages[currentPageIdx].elements=canvasPages[currentPageIdx].components.length;
  var frame=document.getElementById('page-preview-frame');
  if(frame)frame.innerHTML=renderPagePreview(canvasPages[currentPageIdx]);
  var list=document.getElementById('page-components-list');
  if(list)list.innerHTML=canvasPages[currentPageIdx].components.map(function(c,j2){return '<div class="flex items-center gap-2 p-2 rounded-lg hover:bg-gray-100 cursor-pointer" onclick="selectPageComponent('+j2+')"><span class="text-xs text-gray-600">'+c+'</span><button class="ml-auto text-gray-300 hover:text-red-500" onclick="event.stopPropagation();removePageComponent('+j2+')"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2"/></svg></button></div>';}).join('');
  toast('Removed component');
}
function selectPageComponent(j){
  toast('Selected: '+(canvasPages[currentPageIdx].components||[])[j]);
}
function closePageEditor(){
  var e=document.getElementById('page-editor');
  if(e)e.remove();
  currentPageIdx=null;
  renderCanvas();
}
function savePageChanges(){
  if(currentPageIdx===null)return;
  toast('Page saved: '+canvasPages[currentPageIdx].name);
  renderCanvas();
}
function duplicatePage(i){
  var p=canvasPages[i];
  var copy=JSON.parse(JSON.stringify(p));
  copy.name=p.name+' Copy';
  canvasPages.splice(i+1,0,copy);
  renderCanvas();
  toast('Duplicated: '+p.name);
}
function deletePage(i){
  if(canvasPages.length<=1){toast('Cannot delete the last page');return;}
  canvasPages.splice(i,1);
  renderCanvas();
  toast('Deleted page');
}
function togglePreviewDevice(device){
  var frame=document.getElementById('page-preview-frame');
  if(!frame)return;
  var widths={desktop:'100%',tablet:'768px',mobile:'375px'};
  frame.style.maxWidth=widths[device]||'100%';
  frame.style.margin=device==='desktop'?'0 auto':'0 auto';
  document.querySelectorAll('[id^="device-"]').forEach(function(b){b.classList.remove('bg-brand-50','text-brand-600');});
  var btn=document.getElementById('device-'+device);
  if(btn)btn.classList.add('bg-brand-50','text-brand-600');
}
function importFigma(){
  var url=document.getElementById('figma-url').value.trim();
  if(!url){toast('Please paste a Figma URL');return;}
  if(url.indexOf('figma.com')<0){toast('Invalid Figma URL');return;}
  // Show import progress
  toast('Importing from Figma...');
  // Call backend to parse Figma design
  api('/figma-import',{method:'POST',body:JSON.stringify({url:url})})
    .then(function(data){
      if(data.components&&data.components.length){
        if(currentPageIdx!==null){
          canvasPages[currentPageIdx].components=data.components;
          canvasPages[currentPageIdx].elements=data.components.length;
          var frame=document.getElementById('page-preview-frame');
          if(frame)frame.innerHTML=renderPagePreview(canvasPages[currentPageIdx]);
          toast('Imported '+data.components.length+' components from Figma');
        }
      } else {
        // Fallback: simulate import with common components
        if(currentPageIdx!==null){
          var imported=['header','stat-card','stat-card','chart','table','button'];
          canvasPages[currentPageIdx].components=imported;
          canvasPages[currentPageIdx].elements=imported.length;
          var frame=document.getElementById('page-preview-frame');
          if(frame)frame.innerHTML=renderPagePreview(canvasPages[currentPageIdx]);
          toast('Imported 6 components from Figma (demo mode)');
        }
      }
    })
    .catch(function(){
      // Fallback: simulate import
      if(currentPageIdx!==null){
        var imported=['header','stat-card','stat-card','chart','table','button'];
        canvasPages[currentPageIdx].components=imported;
        canvasPages[currentPageIdx].elements=imported.length;
        var frame=document.getElementById('page-preview-frame');
        if(frame)frame.innerHTML=renderPagePreview(canvasPages[currentPageIdx]);
        toast('Imported 6 components from Figma (offline mode)');
      }
    });
}
var selectedElement=null;
function initEditPreview(){
  var f=document.getElementById('edit-preview-frame');
  if(!f||!f.contentDocument)return;
  var d=f.contentDocument;
  d.open();
  d.write('<html><head><style>body{margin:0;padding:20px;font-family:system-ui;background:#f5f5f7}.editable-el{cursor:pointer;transition:outline .2s}.editable-el:hover{outline:1px dashed #007AFF}</style></head><body>');
  d.write('<div id="preview-root">');
  d.write('<h1 class="editable-el" style="font-size:28px;font-weight:700;margin:0 0 12px">Welcome to your app</h1>');
  d.write('<p class="editable-el" style="color:#555;margin:0 0 20px">Click any element to edit its styles</p>');
  d.write('<button class="editable-el" style="padding:8px 20px;background:#007AFF;color:#fff;border:none;border-radius:8px;cursor:pointer">Get Started</button>');
  d.write('<div class="editable-el" style="margin-top:20px;padding:16px;background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.08)">');
  d.write('<h3 class="editable-el" style="font-size:14px;font-weight:600;margin:0 0 8px">Card Title</h3>');
  d.write('<p class="editable-el" style="font-size:12px;color:#888">Card description goes here</p>');
  d.write('</div></div>');
  d.write('<scr'+'ipt>');
  d.write('document.querySelectorAll(".editable-el").forEach(function(el){el.addEventListener("click",function(e){e.stopPropagation();parent.postMessage({type:"element-selected",tag:el.tagName,text:el.textContent.substring(0,50),style:el.getAttribute("style")||""},"*");el.style.outline="2px solid #007AFF";setTimeout(function(){el.style.outline="";},2000);});});');
  d.write('window.addEventListener("message",function(e){');
  d.write('  if(e.data&&e.data.type==="apply-style"){document.querySelectorAll(".editable-el").forEach(function(el){el.style[e.data.prop]=e.data.val;});}');
  d.write('  if(e.data&&e.data.type==="apply-tailwind"){document.querySelectorAll(".editable-el").forEach(function(el){el.classList.add.apply(el.classList,e.data.classes.split(" "));});}');
  d.write('  if(e.data&&e.data.type==="insert-component"){var r=document.getElementById("preview-root");if(r)r.insertAdjacentHTML("beforeend",e.data.html);document.querySelectorAll(".editable-el:not([data-bound])").forEach(function(el){el.setAttribute("data-bound","1");el.addEventListener("click",function(e){e.stopPropagation();parent.postMessage({type:"element-selected",tag:el.tagName,text:el.textContent.substring(0,50),style:el.getAttribute("style")||""},"*");el.style.outline="2px solid #007AFF";setTimeout(function(){el.style.outline="";},2000);});});}');
  d.write('  if(e.data&&e.data.type==="bulk-style"){document.querySelectorAll(".editable-el").forEach(function(el){el.style[e.data.prop]=e.data.val;});}');
  d.write('  if(e.data&&e.data.type==="bulk-select"){document.querySelectorAll(".editable-el").forEach(function(el){el.style.outline="2px solid #5856D6";setTimeout(function(){el.style.outline="";},3000);});}');
  d.write('});');
  d.write('</scr'+'ipt></body></html>');
  d.close();
}
window.addEventListener('message',function(e){
  if(e.data&&e.data.type==='element-selected'){
    selectedElement=e.data;
    var s=document.getElementById('edit-status');
    if(s)s.innerHTML='<span class="text-brand-500">Selected: '+escapeHtml(selectedElement.tag||'element')+'</span> \u2014 '+escapeHtml(selectedElement.text||'');
    toast('Selected: '+(selectedElement.tag||'element'));
  }
});
function applyStyle(prop,val){
  if(!val)return;
  var f=document.getElementById('edit-preview-frame');
  if(f&&f.contentWindow){f.contentWindow.postMessage({type:'apply-style',prop:prop,val:val},'*');toast(prop+': '+val);}
}
function applyTailwind(classes){
  if(!classes)return;
  var f=document.getElementById('edit-preview-frame');
  if(f&&f.contentWindow){f.contentWindow.postMessage({type:'apply-tailwind',classes:classes},'*');toast('Added: '+classes);}
  document.getElementById('edit-tailwind').value='';
}
function editElement(){
  var i=document.getElementById('edit-element-input');
  var desc=i.value.trim();
  if(!desc)return;
  // Send to AI to interpret the style change
  api('/chat',{method:'POST',body:JSON.stringify({message:'In edit mode, the user selected an element and wants: '+desc+'. Return ONLY a JSON object of CSS properties to apply, e.g. {"fontSize":"20px","borderRadius":"20px"}. No other text.',model:'auto'})})
    .then(function(data){
      var msg=data.message||data.response||'';
      // Try to parse JSON from response
      try{
        var jsonStart=msg.indexOf('{');
        var jsonEnd=msg.lastIndexOf('}')+1;
        if(jsonStart>=0&&jsonEnd>jsonStart){
          var styles=JSON.parse(msg.substring(jsonStart,jsonEnd));
          Object.keys(styles).forEach(function(k){applyStyle(k,styles[k]);});
          toast('Applied: '+desc);
        } else {
          toast('Could not parse style changes');
        }
      }catch(e){toast('AI response: '+msg.substring(0,80));}
      i.value='';
    })
    .catch(function(err){toast('Error: '+err.message);i.value='';});
}

// Component library with real insertion
var componentTemplates={
  button:'<button class="px-4 py-2 bg-brand-500 text-white rounded-lg font-medium hover:bg-brand-600">Click Me</button>',
  input:'<div><label class="text-sm font-medium block mb-1">Label</label><input type="text" placeholder="Enter text..." class="w-full px-3 py-2 border rounded-lg focus:border-brand-500"></div>',
  table:'<table class="w-full"><thead><tr class="border-b"><th class="text-left p-2 text-sm">Name</th><th class="text-left p-2 text-sm">Status</th></tr></thead><tbody><tr><td class="p-2 text-sm">Item 1</td><td class="p-2 text-sm">Active</td></tr></tbody></table>',
  chart:'<div style="height:200px;display:flex;align-items:flex-end;gap:8px;padding:12px;background:#fff;border-radius:12px"><div style="flex:1;height:60%;background:#007AFF;border-radius:4px"></div><div style="flex:1;height:80%;background:#5856D6;border-radius:4px"></div><div style="flex:1;height:45%;background:#34C759;border-radius:4px"></div><div style="flex:1;height:90%;background:#FF9500;border-radius:4px"></div><div style="flex:1;height:70%;background:#AF52DE;border-radius:4px"></div></div>',
  card:'<div class="card p-4"><h3 class="text-sm font-semibold mb-2">Card Title</h3><p class="text-xs text-gray-500">Card description goes here</p></div>',
  navbar:'<nav class="flex items-center justify-between px-4 py-3 bg-white border-b"><span class="font-bold">Logo</span><div class="flex gap-4 text-sm"><a href="#">Home</a><a href="#">About</a><a href="#">Contact</a></div></nav>',
  sidebar:'<div class="w-48 p-4 bg-gray-50 min-h-screen"><div class="space-y-2"><a href="#" class="block text-sm px-3 py-2 rounded-lg bg-brand-500 text-white">Dashboard</a><a href="#" class="block text-sm px-3 py-2 rounded-lg hover:bg-gray-100">Settings</a><a href="#" class="block text-sm px-3 py-2 rounded-lg hover:bg-gray-100">Profile</a></div></div>',
  modal:'<div class="fixed inset-0 flex items-center justify-center bg-black/40"><div class="bg-white rounded-xl p-6 max-w-sm"><h3 class="font-semibold mb-3">Modal Title</h3><p class="text-sm text-gray-500 mb-4">Modal content goes here.</p><div class="flex justify-end gap-2"><button class="px-3 py-1.5 text-sm rounded-lg">Cancel</button><button class="px-3 py-1.5 text-sm rounded-lg bg-brand-500 text-white">OK</button></div></div></div>'
};
function addComponent(t){
  var html=componentTemplates[t]||'<div>Component: '+escapeHtml(t)+'</div>';
  // Insert into preview iframe
  var frame=document.getElementById('edit-preview-frame');
  if(frame&&frame.contentWindow){
    frame.contentWindow.postMessage({type:'insert-component',html:html},'*');
    toast('Added '+t+' to preview');
  } else {
    // Fallback: add to canvas
    var c=document.getElementById('builder-chat');
    if(c){c.innerHTML+='<div class="flex justify-start"><div class="card p-2 text-sm max-w-md"><p class="text-xs text-gray-500">Component added: '+escapeHtml(t)+'</p></div></div>';}
    toast('Added '+t+' component');
  }
}
function bulkSelectAll(){var f=document.getElementById('edit-preview-frame');if(f&&f.contentWindow){f.contentWindow.postMessage({type:'bulk-select'},'*');toast('Selected all elements');}}
function bulkEdit(prop,val){var f=document.getElementById('edit-preview-frame');if(f&&f.contentWindow){f.contentWindow.postMessage({type:'bulk-style',prop:prop,val:val},'*');toast('Applied '+prop+': '+val+' to all');}}
function bulkTheme(theme){var f=document.getElementById('edit-preview-frame');if(f&&f.contentWindow){if(theme==='dark'){f.contentWindow.postMessage({type:'bulk-style',prop:'background',val:'#1a1a2e'},'*');f.contentWindow.postMessage({type:'bulk-style',prop:'color',val:'#e0e0e0'},'*');}else{f.contentWindow.postMessage({type:'bulk-style',prop:'background',val:'#f5f5f7'},'*');f.contentWindow.postMessage({type:'bulk-style',prop:'color',val:'#333333'},'*');}toast('Applied '+theme+' theme');}}

// ═══ ENTITIES (REAL API) ═══
function loadEntities(){
  api('/entities').then(function(data){
    var entities=data.entities||data||[];
    document.getElementById('entity-stats').innerHTML=[{label:'Total Entities',value:entities.length},{label:'Total Records',value:entities.reduce(function(s,e){return s+(e.record_count||e.records||0);},0)},{label:'With RLS',value:entities.filter(function(e){return e.rls;}).length},{label:'API Endpoints',value:entities.length*5}].map(function(s){return '<div class="stat-card"><div class="text-xs text-gray-500">'+s.label+'</div><div class="text-xl font-bold mt-1">'+s.value+'</div></div>';}).join('');
    document.getElementById('entity-list').innerHTML=entities.length?entities.map(function(e){
      var name=e.name||e.entity_name||'unknown';
      var count=e.record_count||e.records||0;
      return '<div class="card p-3 flex items-center justify-between hover:border-brand-500"><div><span class="text-sm font-medium">'+name+'</span><span class="text-xs text-gray-500 ml-2">'+count+' records</span>'+(e.rls?'<span class="badge badge-purple ml-2">RLS</span>':'')+'</div><div class="flex gap-2"><button class="btn-ghost text-xs" onclick="showEntityRecords(\''+name+'\')">View</button><button class="btn-ghost text-xs text-red-500" onclick="deleteEntity(\''+name+'\')">Delete</button></div></div>';
    }).join(''):'<div class="text-center text-gray-400 py-8">No entities yet. Create one with the Workbench.</div>';
  }).catch(function(){document.getElementById('entity-list').innerHTML='<div class="text-center text-gray-400 py-8">Failed to load entities.</div>';});
}



// ═══ FUNCTIONS (REAL API) ═══
function loadFunctions(){
  api('/functions').then(function(data){
    var fns=data.functions||data||[];
    document.getElementById('function-list').innerHTML=fns.length?fns.map(function(f){
      var name=f.name||f.function_name||'unknown';
      return '<div class="card p-3 flex items-center justify-between"><div><span class="text-sm font-medium">'+name+'</span><span class="text-xs text-gray-500 ml-2">'+(f.method||'GET/POST')+'</span></div><div class="flex gap-2"><button class="btn-ghost text-xs" onclick="testFunction(\''+name+'\')">Test</button><button class="btn-ghost text-xs text-red-500" onclick="deleteFunction(\''+name+'\')">Delete</button></div></div>';
    }).join(''):'<div class="text-center text-gray-400 py-8">No functions deployed.</div>';
  }).catch(function(){document.getElementById('function-list').innerHTML='<div class="text-center text-gray-400 py-8">Failed to load functions.</div>';});
}


// ═══ WORKFLOWS (REAL API) ═══
function loadWorkflows(){
  api('/workflows').then(function(data){
    var wfs=data.workflows||data||[];
    var html=wfs.length?wfs.map(function(w){
      var name=w.name||'unknown';var active=w.active||w.status==='active';
      return '<div class="card p-3 flex items-center justify-between"><div><span class="text-sm font-medium">'+name+'</span><span class="badge '+(active?'badge-green':'badge-gray')+' ml-2">'+(active?'Active':'Paused')+'</span><span class="text-xs text-gray-500 ml-2">'+(w.trigger||'manual')+'</span></div><div class="flex gap-2"><button class="btn-ghost text-xs" onclick="toggleWorkflow(\''+name+'\','+!active+')">'+(active?'Pause':'Activate')+'</button><button class="btn-ghost text-xs" onclick="executeWorkflow(\''+name+'\')">Run</button></div></div>';
    }).join(''):'<div class="text-center text-gray-400 py-8">No workflows yet.</div>';
    document.getElementById('workflow-scheduled').innerHTML=html;
    document.getElementById('workflow-triggered').innerHTML=html;
  }).catch(function(){document.getElementById('workflow-scheduled').innerHTML='<div class="text-center text-gray-400 py-8">Failed to load workflows.</div>';});
}
function switchWorkflowTab(e,tab){e.target.closest('.flex').querySelectorAll('button').forEach(function(b){b.classList.remove('border-brand-500','text-brand-500');b.classList.add('border-transparent','text-gray-500');});e.target.classList.add('border-brand-500','text-brand-500');e.target.classList.remove('border-transparent','text-gray-500');['scheduled','triggered','activity'].forEach(function(t){var el=document.getElementById('workflow-'+t);if(el)el.classList.toggle('hidden',t!==tab);});}


// ═══ TEMPLATES (REAL API) ═══
function loadTemplates(){
  var communityTemplates=[
    {id:'crm',name:'CRM App',icon:'📊',description:'Contacts, deals, pipeline management',entity_count:3,tags:['business','sales']},
    {id:'ecommerce',name:'E-Commerce',icon:'🛒',description:'Products, orders, cart, inventory',entity_count:4,tags:['retail','shop']},
    {id:'tasks',name:'Task Manager',icon:'✅',description:'Tasks, projects, team collaboration',entity_count:3,tags:['productivity']},
    {id:'blog',name:'Blog Platform',icon:'✍️',description:'Posts, authors, comments, SEO',entity_count:3,tags:['content','cms']},
    {id:'analytics',name:'Analytics Dashboard',icon:'📈',description:'Metrics, charts, real-time data',entity_count:2,tags:['data','metrics']},
    {id:'chat',name:'Chat App',icon:'💬',description:'Messages, rooms, users, presence',entity_count:4,tags:['social','realtime']},
    {id:'booking',name:'Event Booking',icon:'📅',description:'Events, reservations, ticketing',entity_count:2,tags:['scheduling']},
    {id:'hr',name:'HR Portal',icon:'👔',description:'Employees, departments, payroll, leave',entity_count:4,tags:['business','hr']},
    {id:'lms',name:'Learning Platform',icon:'🎓',description:'Courses, lessons, students, progress',entity_count:4,tags:['education']},
    {id:'inventory',name:'Inventory Manager',icon:'📦',description:'Stock, suppliers, warehouses',entity_count:3,tags:['logistics']},
    {id:'helpdesk',name:'Help Desk',icon:'🎧',description:'Tickets, agents, SLA, knowledge base',entity_count:4,tags:['support']},
    {id:'saas',name:'SaaS Starter',icon:'🚀',description:'Auth, teams, API keys, dashboards',entity_count:5,tags:['startup','platform']}
  ];
  api('/templates').then(function(data){
    var apiTpls=data.templates||data||[];
    // Merge: API templates + community templates (dedup by id)
    var seen={};
    var merged=[];
    apiTpls.forEach(function(t){if(!seen[t.id]){seen[t.id]=1;merged.push(t);}});
    communityTemplates.forEach(function(t){if(!seen[t.id]){seen[t.id]=1;merged.push(t);}});
    renderTemplatesFiltered(merged.length?merged:communityTemplates);
  }).catch(function(){
    renderTemplatesFiltered(communityTemplates);
  });
}
function renderTemplatesFiltered(list){var g=document.getElementById('template-grid');if(!g)return;g.innerHTML=list.map(function(t){return '<div class="card p-4 cursor-pointer hover:border-brand-500 transition-all" onclick="useTemplate(\''+t.id+'\')"><div class="flex items-center gap-2 mb-2"><span class="text-2xl">'+(t.icon||'📄')+'</span><span class="badge badge-blue">'+(t.entity_count||0)+' entities</span></div><h3 class="text-sm font-semibold">'+t.name+'</h3><p class="text-xs text-gray-500 mt-1">'+(t.description||'')+'</p>'+(t.tags?'<div class="flex gap-1 mt-2 flex-wrap">'+t.tags.map(function(tag){return '<span class="text-[9px] px-1.5 py-0.5 rounded bg-gray-100 text-gray-500">'+tag+'</span>';}).join('')+'</div>':'')+'<button class="btn-secondary text-xs mt-3 w-full">Use Template</button></div>';}).join('');}
function filterTemplates(q){api('/templates').then(function(data){var tpls=(data.templates||data||[]).filter(function(t){return t.name.toLowerCase().indexOf(q.toLowerCase())>=0||(t.description||'').toLowerCase().indexOf(q.toLowerCase())>=0;});renderTemplatesFiltered(tpls);});}
function useTemplate(id){toast('Loading template: '+id);showPage('chat');insertSuggestion('Create an app from the '+id+' template');}

// ═══ MODEL ROUTING (REAL API) ═══
function loadModels(){
  api('/models').then(function(data){
    var models=data.models||[];
    // Group by provider
    var byProvider={};
    models.forEach(function(m){var p=m.provider||'unknown';if(!byProvider[p])byProvider[p]=[];byProvider[p].push(m);});
    document.getElementById('model-count').textContent=models.length;
    document.getElementById('model-providers').textContent=Object.keys(byProvider).length;
    document.getElementById('model-local').textContent=models.filter(function(m){return m.type==='local';}).length;
    var list=document.getElementById('providers-list');
    list.innerHTML=Object.keys(byProvider).map(function(p){
      var pmodels=byProvider[p];var active=pmodels.filter(function(m){return m.status==='active';}).length;
      return '<div class="card p-4 flex items-center justify-between"><div><div class="flex items-center gap-2"><span class="text-sm font-semibold">'+p+'</span><span class="badge '+(active?'badge-green':'badge-gray')+'">'+active+'/'+pmodels.length+' active</span></div><p class="text-xs text-gray-500 mt-1">'+pmodels.slice(0,5).map(function(m){return m.name||m.id;}).join(', ')+(pmodels.length>5?'...':'')+'</p></div></div>';
    }).join('');
  }).catch(function(){
    document.getElementById('providers-list').innerHTML='<div class="text-center text-gray-400 py-8">Failed to load models.</div>';
  });
}

// ═══ MONITOR (REAL API) ═══
function loadMonitor(){
  api('/monitor').then(function(data){
    document.getElementById('monitor-cpu').textContent=(data.cpu?data.cpu.percent:0).toFixed(1)+'%';
    var memPct=data.memory?data.memory.percent:0;
    document.getElementById('monitor-mem').textContent=data.memory?(data.memory.used_mb/1024).toFixed(1)+'/'+(data.memory.total_mb/1024).toFixed(0)+'GB':'--';
    document.getElementById('monitor-disk').textContent=data.disk?data.disk.percent.toFixed(1)+'%':'--';
    document.getElementById('monitor-load').textContent=data.load_average?data.load_average[0].toFixed(2):'--';
    var services=data.services||[];
    document.getElementById('services-list').innerHTML=services.map(function(s){
      return '<div class="card p-3 flex items-center justify-between"><div class="flex items-center gap-3"><span class="badge '+(s.status==='active'?'badge-green':'badge-red')+'">●</span><div><span class="text-sm font-medium">'+s.name+'</span></div></div><span class="text-xs '+(s.status==='active'?'text-green-600':'text-red-500')+'">'+s.status+'</span></div>';
    }).join('');
    // Update overall status
    var allActive=services.every(function(s){return s.status==='active';});
    var statusEl=document.getElementById('monitor-status');
    statusEl.className='badge '+(allActive?'badge-green':'badge-orange');
    statusEl.textContent=allActive?'● All systems operational':'● Some services inactive';
  }).catch(function(){
    document.getElementById('services-list').innerHTML='<div class="text-center text-gray-400 py-8">Failed to load monitor data.</div>';
  });
}

// ═══ LOGS (REAL API) ═══
function loadLogs(){
  api('/logs?limit=30').then(function(data){
    var logs=data.logs||data||[];
    var term=document.getElementById('logs-terminal');
    if(!logs.length){term.innerHTML='<div class="terminal-line" style="color:#86868b">No logs found (authentication may be required)</div>';return;}
    term.innerHTML=logs.map(function(l){
      var ts=l.timestamp||l.created_at||l.time||'';var msg=l.message||l.msg||l.action||'';var level=l.level||l.type||'INFO';
      var color=level==='ERROR'?'#ef4444':level==='AUDIT'?'#5856D6':level==='WARNING'?'#f59e0b':'#00ff00';
      return '<div class="terminal-line" style="color:'+color+'">['+ts+'] '+level+' — '+msg+'</div>';
    }).join('');
  }).catch(function(){document.getElementById('logs-terminal').innerHTML='<div class="terminal-line" style="color:#f59e0b">Logs require authentication. Login to view.</div>';});
}

// ═══ ANALYTICS (REAL API) ═══
function loadAnalytics(){
  api('/analytics/overview').then(function(data){
    document.getElementById('analytics-entities').textContent=data.entities||0;
    document.getElementById('analytics-records').textContent=data.total_records||0;
    // Chart
    var ctx=document.getElementById('analytics-chart');
    if(!ctx)return;
    var records=data.entity_records||[];
    if(ctx._chart)ctx._chart.destroy();
    ctx._chart=new Chart(ctx,{
      type:'bar',
      data:{labels:records.map(function(e){return e.name;}),datasets:[{label:'Records',data:records.map(function(e){return e.records;}),backgroundColor:'#007AFF',borderWidth:0}]},
      options:{responsive:true,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}
    });
  }).catch(function(){document.getElementById('analytics-entities').textContent='--';});
}

// ═══ CONNECTORS ═══
var connectorsData=[
  {name:'Google Workspace',type:'user',icon:'G',color:'#4285F4',desc:'Gmail, Calendar, Drive',connected:false},
  {name:'Slack',type:'workspace',icon:'S',color:'#4A154B',desc:'Team notifications',connected:false},
  {name:'GitHub',type:'user',icon:'G',color:'#181717',desc:'Code, issues, PRs',connected:true},
  {name:'Notion',type:'user',icon:'N',color:'#000',desc:'Notes and docs',connected:false},
  {name:'HubSpot',type:'workspace',icon:'H',color:'#FF7A59',desc:'CRM integration',connected:false},
  {name:'Microsoft 365',type:'user',icon:'M',color:'#0078D4',desc:'Outlook, Teams',connected:false}
];
function loadVersions(){
  api('/versions').then(function(data){
    var versions=data.versions||data||[];
    var list=document.getElementById('version-list');
    if(!list)return;
    if(!versions.length){list.innerHTML='<div class="text-center text-gray-400 py-8">No version history yet.</div>';return;}
    list.innerHTML=versions.map(function(v){
      var date=v.created_date||v.timestamp||'';
      var desc=v.change_description||v.description||'';
      var name=v.entity_name||v.name||'';
      var type=v.entity_type||v.type||'';
      return '<div class="card p-3 flex items-center gap-3"><div style="width:36px;height:36px;background:rgba(0,122,255,.1);border-radius:8px;display:flex;align-items:center;justify-content:center"><span class="text-sm">v'+(v.version_number||'1')+'</span></div><div class="flex-1"><div class="text-sm font-medium">'+name+' <span class="text-xs text-gray-400">('+type+')</span></div><div class="text-xs text-gray-500">'+desc+'</div><div class="text-[10px] text-gray-400 mt-0.5">'+date+'</div></div></div>';
    }).join('');
  }).catch(function(){var l=document.getElementById('version-list');if(l)l.innerHTML='<div class="text-center text-gray-400 py-8">Failed to load version history.</div>';});
}

function loadConnectors(){
  api('/connectors/providers').then(function(data){
    var providers=data||[];
    connectorsData=providers.map(function(p){return {id:p.id,name:p.name,scopes:p.available_scopes||p.default_scopes||[],connected:false};});
    // Check which are actually connected
    api('/connectors').then(function(conn){var connected=conn.connectors||conn||[];connected.forEach(function(c){var existing=connectorsData.find(function(x){return x.id===c.provider||x.id===c.id;});if(existing)existing.connected=true;});renderConnectorsFiltered('all');}).catch(function(){renderConnectorsFiltered('all');});
  }).catch(function(){renderConnectorsFiltered('all');});
}
function renderConnectorsFiltered(filter){var list=document.getElementById('connectors-list');if(!list)return;var f=filter==='all'?connectorsData:connectorsData.filter(function(c){return c.type===filter;});list.innerHTML=f.map(function(c){return '<div class="card p-4"><div class="flex items-center gap-3 mb-3"><div style="width:36px;height:36px;background:'+c.color+';border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:16px">'+c.icon+'</div><div class="flex-1"><h3 class="text-sm font-semibold">'+c.name+'</h3><p class="text-xs text-gray-500">'+c.desc+'</p></div><span class="badge '+(c.connected?'badge-green':'badge-gray')+'">'+(c.connected?'Connected':'Not connected')+'</span></div><div class="flex items-center justify-between"><span class="badge '+(c.type==='user'?'badge-blue':'badge-purple')+'">'+(c.type==='user'?'Per-User':'Workspace')+'</span><button class="'+(c.connected?'btn-ghost':'btn-secondary')+' text-xs" onclick="toast(\''+(c.connected?'Disconnecting':'Connecting')+' '+c.name+'\')">'+(c.connected?'Disconnect':'Connect')+'</button></div></div>';}).join('');}
function filterConnectors(e,type){e.target.closest('.flex').querySelectorAll('.mode-tab').forEach(function(b){b.classList.remove('active');});e.target.classList.add('active');renderConnectorsFiltered(type);}

// ═══ MEMORY ═══
var memoryItems=[
  {type:'instruction',category:'Operating Protocol',content:'After completing ANY task, report result and ask what to do next.'},
  {type:'preference',category:'EvolvixOS',content:'Apple-style minimalist design with white/grey backgrounds (#f5f5f7) and blue/indigo accents.'},
  {type:'instruction',category:'EvolvixOS',content:'Use NVIDIA build.nvidia.com for advanced agentic reasoning, falling back to local Ollama.'},
  
  {type:'preference',category:'EvolvixOS',content:'Exclusively positioned as an engineering platform. All commercial/payment marketing strictly forbidden.'},
  {type:'fact',category:'EvolvixOS Architecture',content:'EvolvixOS utilizes NVIDIA Nemotron-3-550B as the primary model for complex agentic tasks.'}
];
function renderMemory(){var l=document.getElementById('memory-list');if(!l)return;l.innerHTML=memoryItems.map(function(m){return '<div class="card p-3"><div class="flex items-center justify-between mb-1"><span class="badge badge-'+({instruction:'blue',preference:'purple',decision:'orange',fact:'green'})[m.type]+'">'+m.type+'</span><span class="text-[10px] text-gray-400">'+m.category+'</span></div><p class="text-sm text-gray-700">'+m.content+'</p></div>';}).join('');}
function filterMemory(q){var f=memoryItems.filter(function(m){return m.content.toLowerCase().indexOf(q.toLowerCase())>=0||m.category.toLowerCase().indexOf(q.toLowerCase())>=0;});document.getElementById('memory-list').innerHTML=f.map(function(m){return '<div class="card p-3"><div class="flex items-center justify-between mb-1"><span class="badge badge-'+({instruction:'blue',preference:'purple',decision:'orange',fact:'green'})[m.type]+'">'+m.type+'</span><span class="text-[10px] text-gray-400">'+m.category+'</span></div><p class="text-sm text-gray-700">'+m.content+'</p></div>';}).join('');}
function filterMemoryType(t){if(t==='all')renderMemory();else{var f=memoryItems.filter(function(m){return m.type===t;});document.getElementById('memory-list').innerHTML=f.map(function(m){return '<div class="card p-3"><div class="flex items-center justify-between mb-1"><span class="badge badge-'+({instruction:'blue',preference:'purple',decision:'orange',fact:'green'})[m.type]+'">'+m.type+'</span><span class="text-[10px] text-gray-400">'+m.category+'</span></div><p class="text-sm text-gray-700">'+m.content+'</p></div>';}).join('');}}
function loadMemoryData(){
  var list=document.getElementById('memory-list');if(!list)return;
  list.innerHTML='<div class="text-center text-gray-400 py-4"><div class="spinner mx-auto mb-2"></div>Loading memory...</div>';
  api('/entities/PlatformMemory/records?limit=50').catch(function(e){document.getElementById('memory-list').innerHTML='<div class="text-center text-gray-400 py-8">No memory entries yet.</div>';return {records:[]};}).then(function(data){
    var records=data.records||data||[];
    if(records&&records.length){
      memoryItems=records.map(function(r){
        return {type:r.type||r.kind||'fact',content:r.content||r.text||'',category:r.category||'General'};
      });
    }
    renderMemory();
  }).catch(function(){renderMemory();});
}
function refreshMemory(){loadMemoryData();}

// ═══ AGENTS ═══
function loadAgents(){
  var list=document.getElementById('agent-list');if(!list)return;
  list.innerHTML='<div class="text-center text-gray-400 py-8"><div class="spinner mx-auto mb-2"></div>Loading agents...</div>';
  api('/agents').then(function(data){
    var agents=data.agents||data||[];
    if(!agents.length){list.innerHTML='<div class="card p-4 text-center text-gray-400">No agents yet. Click "+ New Agent" to create one.</div>';return;}
    list.innerHTML=agents.map(function(a){
      var name=a.name||a.agent_name||'unknown';
      var model=a.model||'auto';
      var tools=a.tools?a.tools.length:0;
      var status=a.status||'active';
      return '<div class="card p-4 hover:border-brand-500"><div class="flex items-center justify-between mb-2"><div class="flex items-center gap-2"><div style="width:36px;height:36px;background:linear-gradient(135deg,#007AFF,#5856D6);border-radius:8px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700">'+name.charAt(0).toUpperCase()+'</div><div><div class="text-sm font-medium">'+escapeHtml(name)+'</div><div class="text-xs text-gray-500">Model: '+escapeHtml(model)+' &bull; '+tools+' tools</div></div></div><span class="badge '+(status==='active'?'badge-green':'badge-gray')+'">'+status+'</span></div><p class="text-xs text-gray-600 mt-2">'+escapeHtml((a.description||a.system_prompt||'').substring(0,120))+'</p></div>';
    }).join('');
  }).catch(function(){list.innerHTML='<div class="card p-4 text-center text-gray-400">Failed to load agents. Sign in required.</div>';});
}


// ═══ CHANNELS ═══
function loadNotes(){
  var list=document.getElementById('notes-list');if(!list)return;
  api('/entities/Note/records?limit=20').then(function(data){
    var notes=data.records||data||[];
    list.innerHTML=notes.length?notes.map(function(n){
      var title=n.title||n.name||'Untitled';
      var body=n.content||n.body||'';
      var date=(n.created_date||n.updated_date||'').substring(0,10);
      return '<div class="card p-3"><div class="flex items-center justify-between mb-1"><span class="text-sm font-medium">'+escapeHtml(title)+'</span><span class="text-[10px] text-gray-400">'+date+'</span></div><p class="text-xs text-gray-600">'+escapeHtml(body.substring(0,200))+'</p></div>';
    }).join(''):'<div class="text-center text-gray-400 py-4">No notes yet. Click "+ New Note" to create one.</div>';
  }).catch(function(){list.innerHTML='<div class="text-center text-gray-400 py-4">Sign in to view notes.</div>';});
}




// ═══ AGENT SETTINGS ═══
function switchAgentSettingsTab(e,tab){e.target.closest('.flex').querySelectorAll('button').forEach(function(b){b.classList.remove('border-brand-500','text-brand-500');b.classList.add('border-transparent','text-gray-500');});e.target.classList.add('border-brand-500','text-brand-500');e.target.classList.remove('border-transparent','text-gray-500');['general','personalization','security','channels','sharing'].forEach(function(t){var el=document.getElementById('aset-'+t);if(el)el.classList.toggle('hidden',t!==tab);});}

// ═══ RAG ═══
function loadRAGCollections(){
  api('/rag/collections').then(function(data){
    var cols=data.collections||data||[];
    var c=document.getElementById('rag-collections');
    if(!c)return;
    if(!cols.length){c.innerHTML='<div class="text-center text-gray-400 py-4">No collections yet. Ingest documents via API to create one.</div>';return;}
    c.innerHTML=cols.map(function(col){
      return '<div class="card p-3 flex items-center justify-between"><div><span class="text-sm font-medium">'+escapeHtml(col.name||'unknown')+'</span><span class="text-xs text-gray-500 ml-2">'+(col.documents||col.points||0)+' docs</span></div><span class="badge badge-green">'+(col.status||'Active')+'</span></div>';
    }).join('');
  }).catch(function(){var c=document.getElementById('rag-collections');if(c)c.innerHTML='<div class="text-center text-gray-400 py-4">Failed to load collections.</div>';});
}
function queryRAG(){
  var q=document.getElementById('rag-query').value.trim();if(!q)return;
  var r=document.getElementById('rag-results');
  r.innerHTML='<div class="spinner mr-2"></div> Querying RAG...';
  api('/rag/query',{method:'POST',body:JSON.stringify({query:q,collection:'evolvixos-docs'})}).then(function(data){
    var results=data.results||[];
    if(!results.length){r.innerHTML='<p class="text-sm text-gray-400">No results found for "'+escapeHtml(q)+'"</p>';return;}
    r.innerHTML=results.map(function(res,i){
      var score=res.score?Math.round(res.score*100)+'%':'';
      var text=res.text||res.content||'';
      var src=res.source||res.metadata&&res.metadata.source||'';
      return '<div class="card p-3 mb-2"><div class="flex items-center justify-between mb-1"><span class="text-xs font-medium text-gray-500">#'+(i+1)+(src?' '+escapeHtml(src):'')+'</span>'+(score?'<span class="badge badge-blue text-[10px]">'+score+'</span>':'')+'</div><p class="text-sm text-gray-700">'+escapeHtml(text)+'</p></div>';
    }).join('');
  }).catch(function(){r.innerHTML='<p class="text-sm text-red-500">Query failed. Make sure Qdrant is running.</p>';});
}

