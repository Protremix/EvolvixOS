function renderTestSuites(){var l=document.getElementById('test-suites');if(!l)return;l.innerHTML=testSuites.map(function(t){return '<div class="card p-3 flex items-center justify-between"><div><span class="text-sm font-medium">'+t.name+'</span><span class="badge badge-blue ml-2">'+t.category+'</span></div><div class="flex items-center gap-3"><span class="text-xs" style="color:#16a34a">'+t.passing+' pass</span><span class="text-xs text-gray-400">'+t.tests+' total</span></div></div>';}).join('');}
