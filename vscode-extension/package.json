{
  "name": "evolvixos",
  "displayName": "EvolvixOS",
  "description": "AI engineering platform — chat with 435+ models, manage agents and entities from VS Code",
  "version": "1.0.0",
  "publisher": "evolvixos",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["AI", "Other", "Snippets"],
  "keywords": ["ai", "llm", "chat", "code", "agent"],
  "icon": "icon.png",
  "main": "./extension.js",
  "activationEvents": ["onCommand:evolvixos.chat", "onCommand:evolvixos.setApiKey"],
  "contributes": {
    "commands": [
      {
        "command": "evolvixos.chat",
        "title": "EvolvixOS: Chat with AI",
        "category": "EvolvixOS"
      },
      {
        "command": "evolvixos.setApiKey",
        "title": "EvolvixOS: Set API Key",
        "category": "EvolvixOS"
      },
      {
        "command": "evolvixos.stream",
        "title": "EvolvixOS: Stream Response",
        "category": "EvolvixOS"
      }
    ],
    "configuration": {
      "title": "EvolvixOS",
      "properties": {
        "evolvixos.baseUrl": {
          "type": "string",
          "default": "https://evolvixos.com",
          "description": "EvolvixOS platform URL"
        },
        "evolvixos.defaultModel": {
          "type": "string",
          "default": "auto",
          "description": "Default model for chat"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Protremix/EvolvixOS"
  }
}
