# EvolvixOS Auth Server — Paddle Billing Environment
# Copy to .env and fill in your own values.

# Paddle environment: 'production' for live, 'sandbox' for testing.
# Fail-loud: the server refuses to start if this is unset.

# Paddle API key (server-side only — NEVER expose in client code).
# Live: pdl_live_apikey_... | Sandbox: pdl_sdbx_apikey_...

# Paddle client-side token (safe for frontend — Paddle.js).
# Live: live_... | Sandbox: test_...

# Paddle API base URL.
# Live: https://api.paddle.com | Sandbox: https://sandbox-api.paddle.com

# Paddle webhook signing secret (from notification destination in Paddle Dashboard).
# Format: pdl_ntfset_...

# Webhook timestamp tolerance in seconds (Paddle recommends 5).

# Payment provider flag.
PAYMENT_PROVIDER=paddle
