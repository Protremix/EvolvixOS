# ── Paddle Billing (LIVE) ──────────────────────────────────────────────
# Server-side: API key from Paddle Dashboard > Developer Tools > API Keys
PADDLE_API_KEY=pdl_live_apikey_xxx
# Webhook signing secret from notification destination endpoint_secret_key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
# Live API base (do not change to sandbox in production)
PADDLE_API_BASE=https://api.paddle.com
# Webhook timestamp tolerance in seconds (Paddle docs say 5)
PADDLE_WEBHOOK_TOLERANCE=5
# Client-side token for Paddle.js (prefixed live_ in live, test_ in sandbox)
PADDLE_CLIENT_TOKEN=live_xxx
# Payment provider switch
PAYMENT_PROVIDER=paddle

# ── Email (Brevo) ──────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-xxx
SMTP_HOST=smtp.ionos.es
SMTP_PORT=587
SMTP_USER=support@evolvixos.com

# ── NVIDIA API (for LLM routing) ───────────────────────────────────────
NVIDIA_API_KEY=nvapi-xxx
