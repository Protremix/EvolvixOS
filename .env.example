# ═════════════════════════════════════════════════════════════════
# EvolvixOS Environment Configuration
# ═════════════════════════════════════════════════════════════════
# Copy this file to .env and edit the values.
# All AI providers have free tiers — see links below.

# ── Required ──
JWT_SECRET=change-this-to-a-random-string

# ── Privacy Mode ──
# LOCAL   = Only use Ollama (fully offline, zero cost)
# HYBRID  = Use local + cloud providers (default)
# CLOUD   = Use all providers including paid models
EVOLVIX_PRIVACY_MODE=HYBRID

# ── AI Providers (all have free tiers) ──
# Get free keys at:
#   Groq:       https://console.groq.com      (467 tok/s, free)
#   NVIDIA:     https://build.nvidia.com       (Nemotron-30B, free)
#   OpenRouter: https://openrouter.ai          (21 free models)
#   Gemini:     https://ai.google.dev          (Flash, free)
#   Kimi:       https://platform.moonshot.cn    (limited free)

GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=

# ── Optional: Tencent Cloud ──
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# ── Optional: Payments ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Database (auto-configured in Docker) ──
# DATABASE_URL=postgresql://evolvixos:evolvixos@localhost:5432/evolvixos
