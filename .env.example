# ─── Paddle Billing ───────────────────────────────────
# Sandbox: create account at https://sandbox-vendors.paddle.com
# Live:    create account at https://vendors.paddle.com
# Swap values below when switching from sandbox to live.

# REQUIRED — fail loudly if not set. Never hard-code in frontend.
PADDLE_ENVIRONMENT=sandbox                    # sandbox or production
PADDLE_CLIENT_TOKEN=test_xxx                   # Client-side token (test_ prefix = sandbox, live_ prefix = live)
PADDLE_API_KEY=pdl_sdbx_apikey_xxx            # Server-side API key (NEVER expose in frontend code)
PADDLE_API_BASE=https://sandbox-api.paddle.com # https://api.paddle.com for live

# Webhook
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx          # Signing secret from Paddle > Developer Tools > Notifications
PADDLE_WEBHOOK_TOLERANCE=30                    # Seconds of clock skew tolerance

# Production keys (swap above when going live)
PADDLE_PROD_API_KEY=
PADDLE_PROD_CLIENT_TOKEN=
PADDLE_PROD_WEBHOOK_SECRET=

# ─── Dashboard ───
# Before checkouts work, set your default payment link at:
#   Sandbox: https://sandbox-vendors.paddle.com/checkout-settings
#   Live:    https://vendors.paddle.com/checkout-settings
# On sandbox, any URL works (including localhost).
# On live, must be a real approved domain.
